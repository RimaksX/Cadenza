import { DarkPalette } from "dark.slint";
import { LightPalette } from "light.slint";

// The only thing components are allowed to read.
//
// No component names a colour, a size or a font family of its own. That is what
// keeps any change of look an edit to these files rather than a sweep through
// every view (PROJECT_MASTER 14).
//
// This file is the normative form of the design. What it cannot carry — why a
// number is that number — is written down in docs/DESIGN_SYSTEM.md, which is
// the design this interface is built to rather than a brief for one to come.

// One rule holds this file together beyond the values themselves: **every
// length here is even**. Half of what the interface does is centring one thing
// inside another, and a centred child of an odd-sized parent lands on half a
// pixel — where its border blurs and, if it is text, its letters are rasterised
// to different heights. Even sizes make the arithmetic come out whole without
// anybody having to remember to round it.
//
// The type scale is the exception and is deliberate: those sizes were measured
// against these faces rather than chosen for their parity, and a glyph's line
// box is fractional whatever number is asked for.
export global Theme {
    // Set from Rust out of the active profile's `theme` column.
    in property <bool> dark: true;

    // How large the interface is drawn, as a multiplier of the design size.
    // Set from Rust out of the profile's chosen size.
    //
    // The scaling happens *here*, in the lengths, rather than in the renderer.
    // A renderer told to draw at 1.25 puts every one-pixel line on a pixel and
    // a quarter and every 14-pixel stem between two columns, and the result is
    // soft — which is what a magnifying glass looks like and is exactly what
    // this interface must not (MASTER_ISSUES 65). Scaled here, every length
    // lands on a whole pixel again before anything is drawn.
    in property <float> scale: 1.0;

    /// A design length at the size in force, snapped back to an even pixel.
    ///
    /// Even because that is this interface's first rule: half of what it does
    /// is centre one thing inside another, and an odd parent puts its child on
    /// a half pixel.
    public pure function px(value: float) -> length {
        max(2px, round(value * root.scale / 2) * 2px)
    }

    /// A length that may stay fractional: letter spacing, which accumulates
    /// across a word and is not a thing anything is centred inside.
    public pure function fine(value: float) -> length {
        value * root.scale * 1px
    }

    /// A type size at the size in force, snapped to a whole pixel.
    ///
    /// Whole rather than even: a glyph has no border to blur and no child to
    /// centre, and rounding type to even steps would throw away half the scale.
    public pure function type-size(value: float) -> length {
        max(1px, round(value * root.scale) * 1px)
    }

    out property <color> bg-0: dark ? DarkPalette.bg-0 : LightPalette.bg-0;
    out property <color> bg-1: dark ? DarkPalette.bg-1 : LightPalette.bg-1;
    out property <color> bg-2: dark ? DarkPalette.bg-2 : LightPalette.bg-2;
    out property <color> bg-3: dark ? DarkPalette.bg-3 : LightPalette.bg-3;

    out property <color> line: dark ? DarkPalette.line : LightPalette.line;
    out property <color> line-soft: dark ? DarkPalette.line-soft : LightPalette.line-soft;

    out property <color> ink-mute: dark ? DarkPalette.ink-mute : LightPalette.ink-mute;
    out property <color> ink-disabled: dark ? DarkPalette.ink-disabled : LightPalette.ink-disabled;
    out property <color> ink-2: dark ? DarkPalette.ink-2 : LightPalette.ink-2;
    out property <color> ink-1: dark ? DarkPalette.ink-1 : LightPalette.ink-1;
    out property <color> ink-0: dark ? DarkPalette.ink-0 : LightPalette.ink-0;
    out property <color> accent: dark ? DarkPalette.accent : LightPalette.accent;
    out property <color> danger: dark ? DarkPalette.danger : LightPalette.danger;

    // Three faces, three jobs: serif names things, sans explains them, mono
    // carries anything a listener reads as a number rather than as a word.
    //
    // The families are bundled — see the imports at the top of `app_window.slint`
    // — so they are the same on every machine and need no network. The names are
    // ours rather than the foundries': a family name that exists on the
    // listener's computer is a family name their copy of it can answer to, and
    // "the same everywhere" then depends on what they happen to have installed.
    // Each is one weight in one file, so nothing has to be asked for by number.
    out property <string> serif: "Cadenza Serif";
    out property <string> sans: "Cadenza Sans";
    out property <string> mono: "Cadenza Mono";

    // Type scale — four sizes, and nothing between them.
    //
    // Display names a page or an object: the heading of a screen, a playlist on
    // its tile, the wordmark. Title names a thing inside one: a track in a row,
    // a list in a picker, the question a dialog asks. Body is for prose and for
    // anything read as a sentence. Label is the mono voice — every caption,
    // every column head, every quantity.
    //
    // Four rather than seven because a size that exists gets used, and a
    // seventh size is a seventh thing for the eye to sort. Emphasis comes from
    // the face and the ink instead: serif for names, mono for numbers, and four
    // steps of grey.
    out property <length> text-display: root.type-size(40);
    out property <length> text-title: root.type-size(24);
    // The fifth size, and the scale said four for a reason — so it is worth
    // saying why this one exists. A track's name is the loudest thing in a list
    // row and the quietest kind of heading: at 24 it dominated three columns of
    // 14 and truncated anything past two words, at 14 it read small, because
    // this serif has a famously short lower case. The gap between the two had
    // nothing in it, and a list row is where that gap is felt.
    out property <length> text-lead: root.type-size(18);
    out property <length> text-body: root.type-size(14);
    out property <length> text-label: root.type-size(12);

    // Spacing, in one series, so nothing lands between two steps.
    out property <length> space-1: root.px(4);
    out property <length> space-2: root.px(8);
    out property <length> space-3: root.px(12);
    out property <length> space-4: root.px(16);
    out property <length> space-5: root.px(24);
    out property <length> space-6: root.px(32);

    // One height for everything that can be pressed or typed in.
    //
    // A field and the buttons beside it are two halves of one question, and
    // the difference between a 40-pixel box and a 34-pixel button was visible
    // on the library page long before anybody worked out which of the two was
    // wrong. Named here so the question cannot be answered twice.
    out property <length> control-height: root.px(34);

    // The page head, stated once because ten screens draw it.
    //
    // Every screen opens the same way — an eyebrow, a heading, and whatever
    // that page offers at its own level — and every one of these numbers used
    // to be written out again in each view. Ten places to keep in agreement is
    // ten places for one of them to drift.
    out property <length> page-top: root.px(24);
    out property <length> page-bottom: root.px(16);
    // The heading's own line box. This serif asks about 1.21 of its size, so a
    // 40-pixel display needs 49 and is given 50: the first even number above
    // it and no more, because every pixel here pushes the content further down
    // the page.
    out property <length> heading-box: root.px(50);

    out property <length> radius: root.px(4);
    out property <length> sidebar-width: root.px(240);
    out property <length> player-height: root.px(92);

    // A listing is inset from the window edge rather than run to it. The
    // separators are then the width of the content, not of the screen, which is
    // what stops a long list reading as a spreadsheet.
    out property <length> page-inset: root.px(56);

    // The two boxes stated by name rather than by number, because they are the
    // ones a list of rows repeats and a repeated number is one somebody will
    // eventually mistype. The rest are written where they stand: a heading has
    // one box on one page, and naming it would be a token with one caller.
    out property <length> line-body: root.px(22);
    out property <length> line-label: root.px(18);

    // Track list geometry, all of it from one grid: a number, the names, a time.
    out property <length> column-gap: root.px(20);
    out property <length> number-column: root.px(40);
    out property <length> album-column: root.px(180);
    // Wide enough for the control that replaces the length under the pointer,
    // not just for the length: `12:34` needs 44px and "QUEUE" with its icon
    // needs ninety. The duration stays right-aligned, so the extra width falls
    // where nothing is drawn.
    out property <length> time-column: root.px(96);
    out property <length> row-padding: root.px(14);
    // Tall enough for the title's own line box, not merely for its font size:
    // the serif asks for about 1.21 times the size and the sans for 1.37, and a
    // row that leaves less does not clip the line — it drops it entirely.
    out property <length> row-height: root.px(62);

    // The number column is right-aligned inside its own width, which leaves the
    // digits standing away from the left edge of the list. The time column has
    // nothing after it to do the same job, so it is given the gap directly —
    // otherwise it ends flush against the edge and the row looks cut off.
    out property <length> row-end-inset: root.px(16);

    // The room a scrolling list keeps for its own bar.
    //
    // The bar is drawn over the content rather than beside it, so without
    // this it lands two pixels inside the row it is scrolling: the row's
    // background and the hairline that ends it run underneath, and the bar
    // reads as a mark on the list instead of a control at the edge of it.
    out property <length> scroll-gutter: root.px(8);

    // Mono capitals are set wide: at label size and in upper case they crowd
    // each other, and a caption is read as a shape before it is read as words.
    out property <length> label-spacing: root.fine(2);
    // Digits get a hair of the same treatment, so a column of times reads as a
    // column rather than as a word.
    out property <length> number-spacing: root.fine(0.5);
}
