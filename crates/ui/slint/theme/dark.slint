// The dark palette.
//
// A single warm hue climbed in lightness: four background steps instead of
// shadows, four ink steps instead of opacity. Depth comes from the step, so a
// panel never needs a border and a border never needs to be dark.
//
// Values converted from the oklch ladder in the visual reference: hue 60,
// chroma 0.005 — just enough warmth that the greys are not clinical.

export global DarkPalette {
    // Surfaces, base to raised.
    out property <color> bg-0: #0a0806;
    out property <color> bg-1: #100e0c;
    out property <color> bg-2: #171413;
    out property <color> bg-3: #201e1c;

    // Separators. `line` is visible, `line-soft` is felt rather than seen.
    // Measured against bg-0: 1.9:1 and 1.4:1. Below about 1.3 a hairline stops
    // being quiet and starts being absent.
    out property <color> line: #413f3d;
    out property <color> line-soft: #2d2a28;

    // Text, quietest to loudest.
    //
    // The three caption levels are an even ladder in perceived lightness -
    // 60.5, 55.3, 50.6 - rather than three numbers that happened to look right.
    // Five L* apart is above the just-noticeable difference at caption size and
    // close enough that the three read as one family (`MASTER_ISSUES` 141).
    //
    // `ink-mute` carries every mono caption in the interface — column labels,
    // times, the profile's line — which is the smallest type there is, so it
    // clears 4.5:1 against the surfaces it sits on rather than merely looking
    // quiet. It was two steps darker and measured 3.06, which is what "the text
    // disappears into the background" means in numbers.
    //
    // 5.38:1 against `bg-0`, 5.18 against `bg-1` where the player bar puts it.
    out property <color> ink-mute: #878481;

    // Furniture: what a column is called, what a group is called, what a page
    // is. Read once and then never again — the eye needs it to find its way in
    // and needs it out of the way afterwards, which `ink-mute` at 52 could not
    // do while sitting eight steps under the text it labels.
    //
    // **4.56:1, and it used to be 3.83 by decision.** The decision was that
    // wide capitals read once are not text somebody has to read, so the floor
    // did not apply. Measured on a real screen it did not hold: five different
    // things wear this ink — the eyebrow, `COLLECTION`, `SETUP`, every column
    // head, the profile's line — and all five were the first thing anybody
    // looking at the interface called too faint. It stays 12.7 L* clear of
    // `ink-disabled`, because "furniture" and "unavailable" are still two
    // different sentences (`MASTER_ISSUES` 121, 141).
    out property <color> ink-furniture: #7b7875;

    // Not a quieter ink but a different statement: this one means "not
    // available". It measures 2.8:1 on purpose — a disabled control is exempt
    // from the contrast minimum, and has to look unavailable, which it cannot
    // do while it is as legible as the controls that work.
    out property <color> ink-disabled: #5a5856;
    out property <color> ink-2: #95918f;
    out property <color> ink-1: #d3d0ce;
    out property <color> ink-0: #f8f8f8;

    // What is happening now, and nothing else.
    //
    // Butter rather than gold: the same warm hue the greys are built on, taken
    // up in chroma rather than sideways in hue, so it belongs to this palette
    // instead of arriving from another one. Measured 13.3:1 against `bg-0` —
    // level with `ink-1`, which is the point. An accent that outshines the
    // loudest text is a light in the room; this one is as loud as a title and
    // says "this one" rather than "look here".
    out property <color> accent: #f2d06b;

    // The one colour in the palette. It marks the single control that takes
    // something away, and it is a warm red rather than a signal red so that it
    // belongs to this hue rather than arriving from a system dialog. Measured
    // 5.3:1 against `bg-2`, the surface it appears on.
    out property <color> danger: #eb5757;
}
