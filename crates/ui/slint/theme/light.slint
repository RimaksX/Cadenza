// The light palette.
//
// The same ladder walked the other way, at the same hue, so every component
// keeps its meaning: `bg-0` is still the page, `bg-3` is still the most raised
// surface, `ink-0` is still the loudest text.
//
// Both themes are required. The visual reference is dark only,
// so this side is derived rather than given: lightness mirrored, chroma kept
// low enough that white surfaces do not read as tinted.

export global LightPalette {
    out property <color> bg-0: #fcfaf8;
    out property <color> bg-1: #f5f3f1;
    out property <color> bg-2: #edeae8;
    out property <color> bg-3: #e0dddb;

    // The light side needs its separators darker than a mirror of the dark side
    // would give: on a near-white surface a hairline at 1.5:1 is invisible, and
    // the table loses its structure. These measure 1.9:1 and 1.4:1 like their
    // dark counterparts.
    out property <color> line: #bab7b5;
    out property <color> line-soft: #d8d5d3;

    // 5.71:1 against `bg-0`, where it was 4.92 — the same re-spacing the dark
    // side had, walked the other way. See the note in `dark.slint`.
    out property <color> ink-mute: #676361;
    // 4.51:1 against `bg-0`, where it was 3.56, and lighter than `ink-mute`
    // rather than darker: on this side stepping back means stepping towards the
    // paper. The ladder here is 36.0 / 42.3 / 48.7 in lightness, six apart -
    // wider than the dark side's five, because a light page needs more
    // separation to say the same thing.
    out property <color> ink-furniture: #777371;
    out property <color> ink-disabled: #9a9694;
    out property <color> ink-2: #585452;
    out property <color> ink-1: #2b2826;
    out property <color> ink-0: #0f0d0b;

    // The same accent walked down the other side of the ladder. Butter on a
    // near-white page measures 1.4:1 and is not a colour, it is a smudge; this
    // measures 5.7:1 against `bg-0` and 5.0:1 against `bg-2`, which are the two
    // surfaces it appears on.
    out property <color> accent: #7d5f10;

    // Deeper than the dark side's, for the same reason the separators are: a
    // light red on a near-white surface reads as pink, not as a warning.
    // Measured 5.5:1 against `bg-2`.
    out property <color> danger: #b3261e;
}
