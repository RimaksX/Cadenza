import { Theme } from "../theme/tokens.slint";
import { TextButton } from "../components/Dialog.slint";

// One preset, as the view model hands it over.
export struct EqPresetData {
    id: string,
    name: string,
    selected: bool,
    editable: bool,
}

// One band of the parametric equaliser, already placed on its fader: `y` is how
// far down the track the handle sits, from zero to one. Hertz and decibels are
// the listener's units and stay in Rust, as words.
export struct EqBandData {
    index: int,
    y: float,
    frequency: string,
    q: string,
    gain: string,
    selected: bool,
}

// One arm of the dial: a track from the middle outwards, and a handle on it.
//
// Three of these make the figure. The reference draws it as a radar and calls
// the shape the control; ours is the same idea in this interface's own hand —
// hairlines, one filled handle, mono capitals.
component DialArm inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> lowest;
    in property <float> highest;
    /// Where the middle of the dial is, and how far the arm reaches.
    in property <length> centre-x;
    in property <length> centre-y;
    in property <length> reach;
    /// The direction the arm points, as a unit vector. Worked out by the parent
    /// so that all three agree about where the middle is.
    in property <float> unit-x;
    in property <float> unit-y;

    callback moved(float);
    /// The hand let go, so what was set is worth writing down.
    callback settled();

    // How far along the arm the handle sits, from the middle out.
    property <float> travel: (root.value - root.lowest) / (root.highest - root.lowest);
    property <length> handle-x: root.centre-x + root.reach * root.travel * root.unit-x;
    property <length> handle-y: root.centre-y + root.reach * root.travel * root.unit-y;

    // The track. Drawn as a path because a line at an angle is not a rectangle,
    // and Slint will not rotate one.
    Path {
        // One viewbox unit is one pixel. Left at its default a path is scaled
        // to fill whatever it is given, which stretched every arm out to the
        // corners of the page and left the ring somewhere in the middle of it.
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: "M " + root.centre-x / 1px + " " + root.centre-y / 1px
            + " L " + (root.centre-x + root.reach * root.unit-x) / 1px
            + " " + (root.centre-y + root.reach * root.unit-y) / 1px;
        stroke: Theme.line-soft;
        stroke-width: 2px;
    }

    // The handle.
    Rectangle {
        x: root.handle-x - self.width / 2;
        y: root.handle-y - self.height / 2;
        width: touch.pressed ? 22px : 18px;
        height: self.width;
        border-radius: self.width / 2;
        background: touch.has-hover || touch.pressed ? Theme.ink-0 : Theme.ink-1;
        animate width, height, background { duration: 120ms; }
    }

    touch := TouchArea {
        x: root.handle-x - 22px;
        y: root.handle-y - 22px;
        width: 44px;
        height: 44px;
        mouse-cursor: pointer;

        // Where the pointer is on the dial, whatever this target has done in
        // the meantime. Two things make a delta wrong here: the handle follows
        // the value, so the target moves out from under the hand and the delta
        // stops growing; and `moved` arrives on hover as well as on a drag, so
        // a delta measured from a press that never happened is nonsense. An
        // absolute position has neither problem.
        property <length> pointer-x: self.absolute-position.x + self.mouse-x - root.absolute-position.x;
        property <length> pointer-y: self.absolute-position.y + self.mouse-y - root.absolute-position.y;
        /// How far along the arm the pointer is, projected onto it. Movement
        /// across the arm is ignored rather than losing the grip.
        property <float> along: ((self.pointer-x - root.centre-x) / 1px * root.unit-x
            + (self.pointer-y - root.centre-y) / 1px * root.unit-y) / (root.reach / 1px);

        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.settled();
            }
        }
        moved => {
            if (self.pressed) {
                root.moved(max(root.lowest, min(root.highest,
                    root.lowest + self.along * (root.highest - root.lowest))));
            }
        }
    }

    // The name and the number, at the far end of the arm where the handle is
    // heading rather than where it happens to be.
    VerticalLayout {
        x: root.centre-x + (root.reach + 26px) * root.unit-x - self.width / 2;
        y: root.centre-y + (root.reach + 26px) * root.unit-y - self.height / 2;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
            letter-spacing: Theme.label-spacing;
            color: Theme.ink-mute;
        }
        Text {
            text: root.value == 0 ? "0" : (root.value > 0
                ? "+" + round(root.value * 10) / 10
                : "" + round(root.value * 10) / 10);
            font-family: Theme.mono;
            font-size: Theme.text-body;
            height: 22px;
            vertical-alignment: center;
            horizontal-alignment: center;
            letter-spacing: Theme.number-spacing;
            color: Theme.ink-0;
        }
    }
}

// The three tone controls, as one figure.
component ToneDial inherits Rectangle {
    in property <float> bass;
    in property <float> mid;
    in property <float> treble;

    /// Which control moved, and where to. Zero is bass, one is mid, two treble.
    callback moved(int, float);
    /// The hand let go.
    callback settled();

    property <length> side: min(root.width, root.height);
    property <length> centre-x: root.width / 2;
    property <length> centre-y: root.height / 2;
    // Room at the edge for the labels, which sit outside the reach.
    property <length> reach: root.side / 2 - 56px;

    // The ring the arms end on: the outer edge of every control, drawn once.
    Rectangle {
        x: root.centre-x - root.reach - 1px;
        y: root.centre-y - root.reach - 1px;
        width: 2 * root.reach + 2px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Theme.line-soft;
    }

    // And the ring at rest: where every handle sits when nothing is added.
    Rectangle {
        x: root.centre-x - root.reach / 2;
        y: root.centre-y - root.reach / 2;
        width: root.reach;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Theme.line-soft.with-alpha(0.5);
    }

    // Up, lower-left, lower-right — the arrangement the reference uses, and the
    // one that reads as a figure rather than as three sliders in a fan.
    DialArm {
        label: "MID";
        value: root.mid;
        lowest: -12;
        highest: 12;
        centre-x: root.centre-x;
        centre-y: root.centre-y;
        reach: root.reach;
        unit-x: 0;
        unit-y: -1;
        moved(value) => {
            root.moved(1, value);
        }
        settled => {
            root.settled();
        }
    }
    DialArm {
        label: "BASS";
        value: root.bass;
        lowest: -12;
        highest: 12;
        centre-x: root.centre-x;
        centre-y: root.centre-y;
        reach: root.reach;
        unit-x: -0.866;
        unit-y: 0.5;
        moved(value) => {
            root.moved(0, value);
        }
        settled => {
            root.settled();
        }
    }
    DialArm {
        label: "TREBLE";
        value: root.treble;
        lowest: -12;
        highest: 12;
        centre-x: root.centre-x;
        centre-y: root.centre-y;
        reach: root.reach;
        unit-x: 0.866;
        unit-y: 0.5;
        moved(value) => {
            root.moved(2, value);
        }
        settled => {
            root.settled();
        }
    }
}

// One band, as a fader of its own.
//
// Its own column, its own line, its own target. The first arrangement put all
// eight inside one box and let a row of layouts decide where each line fell,
// which meant the visible line and the place that answered a click were not the
// same place — aim at one band, move its neighbour.
//
// The volume slider had already got this right and is the model: read the
// pointer's position on the track, ignore where it started, and let the handle
// follow rather than lead.
component Fader inherits Rectangle {
    in property <float> value;
    in property <string> gain;
    in property <string> frequency;
    in property <bool> selected;

    callback moved(float);
    callback chosen();
    callback settled();

    // Always the same width, whatever its numbers read. A column sized by its
    // label is a column that changes width when the value does, and a bank of
    // them shuffles under the hand as it is being used.
    width: 64px;

    VerticalLayout {
        spacing: Theme.space-2;

        Text {
            text: root.gain;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
            letter-spacing: Theme.number-spacing;
            color: root.selected ? Theme.ink-0 : Theme.ink-2;
            animate color { duration: 120ms; }
        }

        track := Rectangle {
            vertical-stretch: 1;

            // The line this band runs on.
            Rectangle {
                x: round((parent.width - self.width) / 1px / 2) * 1px;
                width: 2px;
                background: Theme.line-soft;
            }

            // Where this band does nothing. A tick of its own rather than a
            // rule across the bank: eight faders standing on one line read as
            // one control with eight handles, which is what this was.
            Rectangle {
                x: round((parent.width - self.width) / 1px / 2) * 1px;
                y: round((parent.height - self.height) / 1px / 2) * 1px;
                width: 16px;
                height: 1px;
                background: Theme.line;
            }

            // From that tick to the handle: how far this band is from doing
            // nothing, and which way.
            Rectangle {
                x: round((parent.width - self.width) / 1px / 2) * 1px;
                y: min(parent.height * root.value, parent.height / 2);
                width: 2px;
                height: abs(parent.height * root.value - parent.height / 2);
                background: root.selected ? Theme.ink-0 : Theme.ink-2;
                animate background { duration: 120ms; }
            }

            Rectangle {
                x: round((parent.width - self.width) / 1px / 2) * 1px;
                y: round((parent.height * root.value - self.height / 2) / 1px) * 1px;
                width: touch.pressed ? 20px : (root.selected ? 18px : 15px);
                height: self.width;
                border-radius: self.width / 2;
                background: root.selected || touch.has-hover ? Theme.ink-0 : Theme.ink-1;
                animate width, height, background { duration: 120ms; }
            }

            // The target: narrower than the column, so there is dead ground
            // between one fader and the next and a near miss moves nothing.
            // It never moves itself — a target that followed its handle would
            // slide out from under the hand.
            touch := TouchArea {
                x: round((parent.width - self.width) / 1px / 2) * 1px;
                width: 44px;
                mouse-cursor: pointer;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.chosen();
                        root.moved(max(0, min(1, self.mouse-y / (parent.height / 1px) / 1px)));
                    } else if (event.kind == PointerEventKind.up) {
                        root.settled();
                    }
                }
                // `moved` arrives on hover as well as on a drag.
                moved => {
                    if (self.pressed) {
                        root.moved(max(0, min(1, self.mouse-y / (parent.height / 1px) / 1px)));
                    }
                }
            }
        }

        // Where this band sits. The row no longer says so by position — a fader
        // is a fader wherever it stands — so it says so in words, under its own
        // line rather than under the gap beside it.
        Text {
            text: root.frequency;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
            letter-spacing: Theme.number-spacing;
            color: root.selected ? Theme.ink-1 : Theme.ink-mute;
            animate color { duration: 120ms; }
        }
    }
}

// The eight bands, side by side.
component FaderBank inherits Rectangle {
    in property <[EqBandData]> bands;

    callback moved(int, float);
    callback chosen(int);
    callback settled();

    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-1;

        for band[index] in root.bands: Fader {
            value: band.y;
            gain: band.gain;
            frequency: band.frequency;
            selected: band.selected;

            moved(value) => {
                root.moved(index, value);
            }
            chosen => {
                root.chosen(index);
            }
            settled => {
                root.settled();
            }
        }
    }
}

// The equaliser: what the sound is set to, and what it can be set from.
export component EqualiserView inherits Rectangle {
    in property <bool> advanced;
    in property <float> bass;
    in property <float> mid;
    in property <float> treble;
    in property <[EqBandData]> bands;
    in property <[EqPresetData]> presets;
    in property <string> summary;
    /// The band whose numbers are shown under the curve.
    in property <int> selected;
    in property <string> selected-frequency;
    in property <string> selected-q;
    in property <string> selected-gain;

    callback set-mode(bool);
    callback set-simple(int, float);
    callback move-band(int, float);
    /// Which way to move the chosen band's own frequency.
    callback tune-band(int, int);
    callback select-band(int);
    /// A control was let go of: what is set is worth writing down.
    callback settle-eq();
    callback widen-band(int, float);
    callback pick-preset(string);
    callback save-preset();
    callback reset-eq();

    background: Theme.bg-0;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "YOUR SOUND";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }

            HorizontalLayout {
                alignment: space-between;
                spacing: Theme.space-5;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "Equaliser";
                        font-family: Theme.serif;
                        font-size: Theme.text-display;
                        height: 54px;
                        vertical-alignment: bottom;
                        color: Theme.ink-0;
                    }
                }

                // The two modes, side by side rather than one button that
                // flips: both states are visible, and each is directly
                // reachable. A control that has to say what it will do next is
                // a control that needs explaining.
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 4px;

                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "SIMPLE";
                            fixed-width: 128px;
                            selected: !root.advanced;
                            pressed => {
                                root.set-mode(false);
                            }
                        }
                        TextButton {
                            label: "ADVANCED";
                            fixed-width: 128px;
                            selected: root.advanced;
                            pressed => {
                                root.set-mode(true);
                            }
                        }
                    }
                }
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        // The control itself, whichever one it is.
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-6;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-4;

                if !root.advanced: ToneDial {
                    bass: root.bass;
                    mid: root.mid;
                    treble: root.treble;
                    moved(which, value) => {
                        root.set-simple(which, value);
                    }
                    settled => {
                        root.settle-eq();
                    }
                }

                if root.advanced: FaderBank {
                    bands: root.bands;
                    moved(index, y) => {
                        root.move-band(index, y);
                    }
                    chosen(index) => {
                        root.select-band(index);
                    }
                    settled => {
                        root.settle-eq();
                    }
                }

                // What the chosen band is, in the listener's own units, and
                // the two things a fader cannot say: where the band sits and
                // how wide it is.
                //
                // Two lines rather than one. Four controls abreast and a
                // sentence of numbers do not both fit beside a bank of faders,
                // and the first arrangement that tried pushed the presets off
                // the side of the window.
                if root.advanced: VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-2;

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: "BAND";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                        }
                        Text {
                            text: root.selected-frequency + " Hz · Q " + root.selected-q
                                + " · " + root.selected-gain + " dB";
                            font-family: Theme.mono;
                            font-size: Theme.text-body;
                            height: 22px;
                            vertical-alignment: center;
                            letter-spacing: Theme.number-spacing;
                            color: Theme.ink-0;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "LOWER";
                            fixed-width: 98px;
                            pressed => {
                                root.tune-band(root.selected, -1);
                            }
                        }
                        TextButton {
                            label: "HIGHER";
                            fixed-width: 98px;
                            pressed => {
                                root.tune-band(root.selected, 1);
                            }
                        }
                        TextButton {
                            label: "WIDER";
                            fixed-width: 98px;
                            pressed => {
                                root.widen-band(root.selected, -0.3);
                            }
                        }
                        TextButton {
                            label: "NARROWER";
                            fixed-width: 98px;
                            pressed => {
                                root.widen-band(root.selected, 0.3);
                            }
                        }

                    }
                }
            }

            // The presets, in the column the reference puts them in — two
            // abreast, under the control, in reach without scrolling.
            VerticalLayout {
                width: 208px;
                spacing: Theme.space-2;

                Text {
                    text: "PRESETS";
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    height: 18px;
                    vertical-alignment: center;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                }

                for preset[index] in root.presets: HorizontalLayout {
                    vertical-stretch: 0;

                    TextButton {
                        label: preset.name;
                        fixed-width: 208px;
                        selected: preset.selected;
                        pressed => {
                            root.pick-preset(preset.id);
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-2;

                    TextButton {
                        label: "SAVE AS…";
                        fixed-width: 100px;
                        primary: true;
                        pressed => {
                            root.save-preset();
                        }
                    }
                    TextButton {
                        label: "RESET";
                        fixed-width: 100px;
                        pressed => {
                            root.reset-eq();
                        }
                    }

                }
            }
        }
    }
}
