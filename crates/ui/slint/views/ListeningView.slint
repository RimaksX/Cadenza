import { Theme } from "../theme/tokens.slint";
import { ScrollFade } from "../components/ScrollFade.slint";

// One track and how often it was played through.
export struct TopTrackData {
    rank: string,
    title: string,
    subtitle: string,
    plays: string,
}

// A number worth looking at, and what it counts.
component Figure inherits Rectangle {
    in property <string> value;
    in property <string> label;

    // Wide enough for the longest thing it holds — "SKIPPED" under "2h 05m" —
    // and stated here rather than left to the layout, which is how every other
    // control in this interface is sized. A row of four is what gives the page
    // a width worth opening at.
    width: Theme.px(176);
    height: Theme.px(86);
    border-width: 1px;
    border-color: Theme.line-soft;
    background: Theme.bg-1;

    VerticalLayout {
        x: Theme.space-4;
        y: round((parent.height - Theme.px(70)) / 1px / 2) * 1px;
        width: parent.width - Theme.space-4 * 2;
        height: Theme.px(70);
        spacing: Theme.px(2);

        Text {
            text: root.value;
            font-family: Theme.serif;
            font-size: Theme.text-display;
            height: Theme.heading-box;
            vertical-alignment: center;
            color: Theme.ink-0;
            overflow: elide;
        }

        Text {
            text: root.label;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: Theme.px(18);
            vertical-alignment: center;
            letter-spacing: Theme.label-spacing;
            color: Theme.ink-mute;
            overflow: elide;
        }
    }
}

// One line of the standings.
component TopRow inherits Rectangle {
    in property <TopTrackData> data;

    height: Theme.px(46);

    HorizontalLayout {
        y: round((parent.height - Theme.px(22)) / 1px / 2) * 1px;
        height: Theme.px(22);
        spacing: Theme.space-4;

        VerticalLayout {
            width: Theme.px(34);
            alignment: center;

            Text {
                text: root.data.rank;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(22);
                horizontal-alignment: right;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-mute;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.data.title;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                vertical-alignment: center;
                color: Theme.ink-0;
                overflow: elide;
            }
        }

        VerticalLayout {
            width: Theme.px(240);
            alignment: center;

            Text {
                text: root.data.subtitle;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                vertical-alignment: center;
                color: Theme.ink-2;
                overflow: elide;
            }
        }

        VerticalLayout {
            width: Theme.px(92);
            alignment: center;

            Text {
                text: root.data.plays;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(22);
                horizontal-alignment: right;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// A month of listening, and nothing older than that.
export component ListeningView inherits Rectangle {
    in property <[TopTrackData]> top;
    in property <string> summary;
    in property <string> heard;
    in property <string> listens;
    in property <string> tracks;
    in property <string> skip-rate;
    /// False when this listener keeps no history at all.
    in property <bool> keeping;

    background: Theme.bg-0;

    VerticalLayout {

        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.page-top;
            padding-bottom: Theme.page-bottom;
            spacing: Theme.space-2;

            Text {
                text: "THE LAST THIRTY DAYS";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-furniture;
            }

            Text {
                text: "Listening";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: Theme.heading-box;
                vertical-alignment: bottom;
                color: Theme.ink-0;
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        // One child of the page, not two. A pair of conditionals side by side in
        // a layout are two children whichever one is showing, and the layout
        // sizes both — which left the visible one with half a page and squeezed
        // four figures into a corner.
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-bottom: Theme.space-5;

        // Nothing is kept, so there is nothing to draw and a reason to say why.
        if !root.keeping: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            spacing: Theme.space-2;

            Text {
                text: "Nothing is being kept";
                font-family: Theme.serif;
                font-size: Theme.text-title;
                height: Theme.px(34);
                vertical-alignment: center;
                color: Theme.ink-2;
            }

            Text {
                text: "History is off for this profile, so nothing you play is written down. Turn it on in Settings and this page fills up as you listen.";
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(44);
                wrap: word-wrap;
                color: Theme.ink-mute;
            }
        }

        if root.keeping: VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-5;

            HorizontalLayout {
                vertical-stretch: 0;
                alignment: start;
                spacing: Theme.space-2;

                Figure {
                    value: root.heard;
                    label: "HEARD";
                }
                Figure {
                    value: root.listens;
                    label: "LISTENS";
                }
                Figure {
                    value: root.tracks;
                    label: "TRACKS";
                }
                Figure {
                    value: root.skip-rate;
                    label: "SKIPPED";
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: Theme.space-2;

                HorizontalLayout {
                    height: Theme.px(26);
                    spacing: Theme.space-2;

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "PLAYED THROUGH MOST";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: Theme.px(18);
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-furniture;
                        }
                    }

                }

                // The standings are a list beside the figures rather than the
                // page itself, so they fade where they continue — the same
                // sentence the moods and the presets say.
                Rectangle {
                    vertical-stretch: 1;

                    standings := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: rows.preferred-height;

                        rows := VerticalLayout {
                            width: parent.width;
                            alignment: start;

                            for track in root.top: TopRow {
                                data: track;
                            }
                        }
                    }

                    ScrollFade {
                        y: parent.height - self.height;
                        width: parent.width;
                        more: standings.viewport-height + standings.viewport-y > standings.height;
                    }
                }
            }
        }
        }
    }
}
