import { Theme } from "../theme/tokens.slint";

// One track and how often it was played through.
export struct TopTrackData {
    rank: string,
    title: string,
    subtitle: string,
    plays: string,
}

// A number worth looking at, and what it counts.
component Figure inherits Rectangle {
    in property <string> value;
    in property <string> label;

    height: 86px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: Theme.line-soft;
    background: Theme.bg-1;

    VerticalLayout {
        x: Theme.space-4;
        y: round((parent.height - 70px) / 1px / 2) * 1px;
        width: parent.width - Theme.space-4 * 2;
        height: 70px;
        spacing: 2px;

        Text {
            text: root.value;
            font-family: Theme.serif;
            font-size: Theme.text-display;
            height: 50px;
            vertical-alignment: center;
            color: Theme.ink-0;
            overflow: elide;
        }

        Text {
            text: root.label;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: 18px;
            vertical-alignment: center;
            letter-spacing: Theme.label-spacing;
            color: Theme.ink-mute;
            overflow: elide;
        }
    }
}

// One line of the standings.
component TopRow inherits Rectangle {
    in property <TopTrackData> data;

    height: 46px;

    HorizontalLayout {
        y: round((parent.height - 22px) / 1px / 2) * 1px;
        height: 22px;
        spacing: Theme.space-4;

        VerticalLayout {
            width: 34px;
            alignment: center;

            Text {
                text: root.data.rank;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 22px;
                horizontal-alignment: right;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-mute;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.data.title;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: 22px;
                vertical-alignment: center;
                color: Theme.ink-0;
                overflow: elide;
            }
        }

        VerticalLayout {
            width: 240px;
            alignment: center;

            Text {
                text: root.data.subtitle;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: 22px;
                vertical-alignment: center;
                color: Theme.ink-2;
                overflow: elide;
            }
        }

        VerticalLayout {
            width: 92px;
            alignment: center;

            Text {
                text: root.data.plays;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 22px;
                horizontal-alignment: right;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// A month of listening, and nothing older than that.
export component ListeningView inherits Rectangle {
    in property <[TopTrackData]> top;
    in property <string> summary;
    in property <string> heard;
    in property <string> listens;
    in property <string> tracks;
    in property <string> skip-rate;
    /// False when this listener keeps no history at all.
    in property <bool> keeping;

    background: Theme.bg-0;

    // Every page here is laid out at its preferred size, and every other one
    // fills the window by accident: a track list is as wide as its columns, the
    // settings screen has a 320px column in it. This page is four short numbers
    // and a heading, so it asked for a third of the window and got it. A floor
    // under the page is what says otherwise.
    min-width: 760px;
    min-height: 440px;

    VerticalLayout {
        width: root.width;
        height: root.height;

        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "THE LAST THIRTY DAYS";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }

            Text {
                text: "Listening";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: 54px;
                vertical-alignment: bottom;
                color: Theme.ink-0;
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        // One child of the page, not two. A pair of conditionals side by side in
        // a layout are two children whichever one is showing, and the layout
        // sizes both — which left the visible one with half a page and squeezed
        // four figures into a corner.
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-bottom: Theme.space-5;

        // Nothing is kept, so there is nothing to draw and a reason to say why.
        if !root.keeping: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            spacing: Theme.space-2;

            Text {
                text: "Nothing is being kept";
                font-family: Theme.serif;
                font-size: Theme.text-title;
                height: 30px;
                vertical-alignment: center;
                color: Theme.ink-2;
            }

            Text {
                text: "History is off for this profile, so nothing you play is written down. Turn it on in Settings and this page fills up as you listen.";
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: 44px;
                wrap: word-wrap;
                color: Theme.ink-mute;
            }
        }

        if root.keeping: VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space-5;

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-2;

                Figure {
                    value: root.heard;
                    label: "HEARD";
                }
                Figure {
                    value: root.listens;
                    label: "LISTENS";
                }
                Figure {
                    value: root.tracks;
                    label: "TRACKS";
                }
                Figure {
                    value: root.skip-rate;
                    label: "SKIPPED";
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: Theme.space-2;

                HorizontalLayout {
                    height: 26px;
                    spacing: Theme.space-2;

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "PLAYED THROUGH MOST";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                        }
                    }

                    Rectangle {
                        y: 8px;
                        height: 1px;
                        background: Theme.line-soft;
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: rows.preferred-height;

                    rows := VerticalLayout {
                        alignment: start;

                        for track in root.top: TopRow {
                            data: track;
                        }
                    }
                }
            }
        }
        }
    }
}
