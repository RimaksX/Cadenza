import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { TextButton } from "../components/Dialog.slint";
import { ScrollFade } from "../components/ScrollFade.slint";

// One listener this copy of Cadenza knows about.
export struct ProfileRowData {
    id: string,
    name: string,
    /// What this profile has of its own, in a few words.
    note: string,
    active: bool,
}

// One folder the library watches, as the view model hands it over.
export struct FolderRowData {
    id: string,
    path: string,
    note: string,
}

// A heading over a group of controls. Mono capitals and a rule to the edge —
// the same device the sidebar uses to separate one group of destinations from
// the next, because it is the same kind of statement.
component SectionLabel inherits Rectangle {
    in property <string> text;

    height: Theme.px(26);

    HorizontalLayout {
        y: round((parent.height - Theme.px(18)) / Theme.px(2)) * Theme.px(2);
        height: Theme.px(18);
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;

            Text {
                text: root.text;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }

        Rectangle {
            y: Theme.px(8);
            height: 1px;
            background: Theme.line-soft;
        }
    }
}

// A line of explanation under a group of controls.
component SectionNote inherits Text {
    font-family: Theme.sans;
    font-size: Theme.text-body;
    height: Theme.px(22);
    vertical-alignment: center;
    color: Theme.ink-mute;
    overflow: elide;
}

// One watched folder: where it is, and the one thing that can be done to it.
component FolderRow inherits Rectangle {
    in property <FolderRowData> data;

    callback removed();

    height: Theme.px(46);

    VerticalLayout {
        y: round((parent.height - Theme.px(40)) / Theme.px(2)) * Theme.px(2);
        height: Theme.px(40);

        HorizontalLayout {
            spacing: Theme.space-4;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: Theme.px(2);

                Text {
                    text: root.data.path;
                    font-family: Theme.sans;
                    font-size: Theme.text-body;
                    height: Theme.px(22);
                    vertical-alignment: center;
                    color: Theme.ink-0;
                    overflow: elide;
                }
                Text {
                    text: root.data.note;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    height: Theme.px(18);
                    vertical-alignment: center;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    label: "REMOVE";
                    fixed-width: Theme.px(98);
                    destructive: true;
                    pressed => {
                        root.removed();
                    }
                }
            }
        }
    }

    // The same hairline every list in this interface puts under a row.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One listener: their name, and the one thing to do about them.
component ProfileRow inherits Rectangle {
    in property <ProfileRowData> data;

    callback chosen();

    height: Theme.px(46);

    HorizontalLayout {
        y: round((parent.height - Theme.px(40)) / 1px / 2) * 1px;
        height: Theme.px(40);
        spacing: Theme.space-4;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Theme.px(2);

            Text {
                text: root.data.name;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                vertical-alignment: center;
                color: root.data.active ? Theme.ink-0 : Theme.ink-2;
                overflow: elide;
            }
            Text {
                text: root.data.note;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            TextButton {
                label: root.data.active ? "LISTENING" : "SWITCH";
                fixed-width: Theme.px(116);
                selected: root.data.active;
                enabled: !root.data.active;
                pressed => {
                    root.chosen();
                }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// Everything about this copy of Cadenza that is the listener's to decide.
export component SettingsView inherits Rectangle {
    in property <bool> dark;
    in property <bool> crossfade-on;
    in property <int> crossfade-seconds;
    /// How large the interface is drawn, as a percentage.
    in property <int> ui-scale;
    in property <bool> history-on;
    in property <[FolderRowData]> folders;
    in property <[ProfileRowData]> profiles;
    /// Where this machine keeps music, for somebody with nowhere to point at.
    in property <string> suggested;
    in property <string> summary;

    callback switch-profile(string);
    callback new-profile();
    callback set-theme(bool);
    callback set-crossfade(bool, int);
    callback set-ui-scale(int);
    callback set-history(bool);
    callback add-folder();
    callback use-suggested();
    callback remove-folder(string);
    callback scan-now();

    background: Theme.bg-0;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "THIS COPY OF CADENZA";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }

            Text {
                text: "Settings";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: Theme.px(56);
                vertical-alignment: bottom;
                color: Theme.ink-0;
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-6;

            // Scrolls, because this column grows with the number of listeners
            // and a decision below the bottom of the window is a decision
            // nobody can make.
            // A plain rectangle rather than a layout, so the fade can stand over
            // the bottom of the column instead of taking a row beneath it.
            Rectangle {
                width: Theme.px(320);

                scroller := Flickable {
                    width: parent.width;
                    height: parent.height;
                    // Stated, not inferred. Left to itself a flickable takes the
                    // *preferred* width of what is in it, which for a column of
                    // rows is as wide as the widest of them wants to be — so the
                    // column laid itself out past its own edge and clipped what
                    // fell off (MASTER_ISSUES 64).
                    viewport-width: self.width;
                    viewport-height: choices.preferred-height;

                    choices := VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: Theme.space-5;

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "WHO IS LISTENING";
                    }
                    SectionNote {
                        text: "Each has their own library and queue.";
                    }

                    for profile in root.profiles: ProfileRow {
                        data: profile;
                        chosen => {
                            root.switch-profile(profile.id);
                        }
                    }

                    HorizontalLayout {
                        alignment: start;

                        TextButton {
                            label: "NEW LISTENER…";
                            fixed-width: Theme.px(208);
                            pressed => {
                                root.new-profile();
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "APPEARANCE";
                    }
                    SectionNote {
                        text: "Which way round the ink and the paper go.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "DARK";
                            fixed-width: Theme.px(100);
                            selected: root.dark;
                            pressed => {
                                root.set-theme(true);
                            }
                        }
                        TextButton {
                            label: "LIGHT";
                            fixed-width: Theme.px(100);
                            selected: !root.dark;
                            pressed => {
                                root.set-theme(false);
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "CROSSFADE";
                    }
                    SectionNote {
                        text: "Ordinary tracks fade into each other.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "ON";
                            fixed-width: Theme.px(100);
                            selected: root.crossfade-on;
                            pressed => {
                                root.set-crossfade(true, root.crossfade-seconds);
                            }
                        }
                        TextButton {
                            label: "OFF";
                            fixed-width: Theme.px(100);
                            selected: !root.crossfade-on;
                            pressed => {
                                root.set-crossfade(false, root.crossfade-seconds);
                            }
                        }
                    }

                    // Three lengths, which is the whole range 2.4 allows.
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        for seconds in [3, 4, 5]: TextButton {
                            label: seconds + "";
                            fixed-width: Theme.px(100);
                            selected: root.crossfade-seconds == seconds;
                            pressed => {
                                root.set-crossfade(root.crossfade-on, seconds);
                            }
                        }
                    }

                    SectionNote {
                        text: "Seconds. Playlists and radio never fade.";
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "SIZE";
                    }
                    SectionNote {
                        text: "How large everything is drawn.";
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        // Four across a column of 320, with the spacing between
                        // them: 4 x 74 + 3 x 8 comes out exactly, where four of
                        // the usual 100 would have pushed the last step off the
                        // edge — which is what it did.
                        for percent in [90, 100, 110, 125]: TextButton {
                            label: percent + "%";
                            fixed-width: Theme.px(74);
                            selected: root.ui-scale == percent;
                            pressed => {
                                root.set-ui-scale(percent);
                            }
                        }
                    }

                    SectionNote {
                        text: "Drawn at the new size when Cadenza next starts.";
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "HISTORY";
                    }
                    SectionNote {
                        text: "What you played, kept for thirty days.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "KEEP";
                            fixed-width: Theme.px(100);
                            selected: root.history-on;
                            pressed => {
                                root.set-history(true);
                            }
                        }
                        TextButton {
                            label: "DO NOT";
                            fixed-width: Theme.px(100);
                            selected: !root.history-on;
                            pressed => {
                                root.set-history(false);
                            }
                        }
                    }
                }

                    }
                }

                ScrollFade {
                    y: parent.height - self.height;
                    width: parent.width;
                    more: scroller.viewport-height + scroller.viewport-y > scroller.height;
                }
            }

            // The folders, which is the one thing here that grows.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-2;

                SectionLabel {
                    text: "WHERE YOUR MUSIC IS";
                }

                if root.folders.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    spacing: Theme.space-2;

                    Text {
                        text: "No folders yet";
                        font-family: Theme.serif;
                        font-size: Theme.text-title;
                        height: Theme.px(34);
                        vertical-alignment: center;
                        color: Theme.ink-2;
                    }
                    SectionNote {
                        text: "Point Cadenza at music you already have — or let it make a folder for you to put some in.";
                        wrap: word-wrap;
                        height: Theme.px(44);
                    }
                    Text {
                        text: root.suggested;
                        font-family: Theme.mono;
                        font-size: Theme.text-label;
                        height: Theme.px(18);
                        vertical-alignment: center;
                        letter-spacing: Theme.number-spacing;
                        color: Theme.ink-mute;
                        overflow: elide;
                    }
                }

                if root.folders.length > 0: ListView {
                    vertical-stretch: 1;

                    for folder[index] in root.folders: FolderRow {
                        data: folder;
                        removed => {
                            root.remove-folder(folder.id);
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-2;

                    TextButton {
                        label: "ADD FOLDER…";
                        fixed-width: Theme.px(148);
                        primary: true;
                        pressed => {
                            root.add-folder();
                        }
                    }
                    TextButton {
                        label: "MAKE ME ONE";
                        fixed-width: Theme.px(148);
                        pressed => {
                            root.use-suggested();
                        }
                    }
                    TextButton {
                        label: "SCAN NOW";
                        fixed-width: Theme.px(148);
                        pressed => {
                            root.scan-now();
                        }
                    }
                }
            }
        }
    }
}
