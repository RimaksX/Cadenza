import { Theme } from "../theme/tokens.slint";
import { TextButton } from "../components/Dialog.slint";
import { ScrollFade } from "../components/ScrollFade.slint";

// One listener this copy of Cadenza knows about.
export struct ProfileRowData {
    id: string,
    name: string,
    /// What this profile has of its own, in a few words.
    note: string,
    active: bool,
}

// One folder the library watches, as the view model hands it over.
export struct FolderRowData {
    id: string,
    path: string,
    note: string,
}

// One track this listener took out of their library.
export struct TakenOutRowData {
    id: string,
    title: string,
    subtitle: string,
    /// True where the file itself has gone, so there is nothing to bring back.
    gone: bool,
}

// A heading over a group of controls. Mono capitals in the furniture ink, and
// nothing else.
//
// It used to carry a rule to the right edge of the page, borrowed from the
// sidebar. In a 240-pixel column that rule is a tick beside a word; across the
// full width of a page, seven of them at even intervals turn the screen into a
// stack of stripes and stop meaning anything — and a line in this interface is
// supposed to mean "something ends here" (`MASTER_ISSUES` 121). What separates
// one group from the next is the space above it and the ink of the label.
component SectionLabel inherits Rectangle {
    in property <string> text;

    height: Theme.px(26);

    HorizontalLayout {
        // Centred, which is what this expression was meant to say and did not:
        // dividing by a *length* of two pixels rather than by the number two
        // put the line at the whole remainder instead of half of it, so the
        // rule sat low in its box and whatever came next stood too close under
        // it. Same arithmetic as `ProfileRow`, which had it right.
        y: round((parent.height - Theme.px(18)) / 1px / 2) * 1px;
        height: Theme.px(18);
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;

            Text {
                text: root.text;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-furniture;
            }
        }
    }
}

// A line of explanation under a group of controls.
//
// Body, at the body ink. It was `ink-mute` — the same ink as the label above
// it, so the page had a label and a sentence saying the same thing in the same
// voice, and nothing to tell the eye which was which.
component SectionNote inherits Text {
    font-family: Theme.sans;
    font-size: Theme.text-body;
    height: Theme.px(22);
    vertical-alignment: center;
    color: Theme.ink-2;
    overflow: elide;
}

// One watched folder: where it is, and the two things that can be done to it.
component FolderRow inherits Rectangle {
    in property <FolderRowData> data;
    /// Set on the last row of the list, which draws no separator under it.
    in property <bool> last;

    callback removed();
    callback synchronised();

    height: Theme.row-height;

    VerticalLayout {
        y: round((parent.height - Theme.px(48)) / 1px / 2) * 1px;
        height: Theme.px(48);

        HorizontalLayout {
            spacing: Theme.space-4;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: Theme.px(2);

                // The name of the row, at the level a track's name has in the
                // library: this page is a list of things with captions under
                // them, exactly as that one is (`MASTER_ISSUES` 121).
                Text {
                    text: root.data.path;
                    font-family: Theme.serif;
                    font-size: Theme.text-lead;
                    height: Theme.px(26);
                    vertical-alignment: center;
                    color: Theme.ink-1;
                    overflow: elide;
                }
                Text {
                    text: root.data.note;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    height: Theme.px(18);
                    vertical-alignment: center;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    label: "SYNC";
                    fixed-width: Theme.px(84);
                    pressed => {
                        root.synchronised();
                    }
                }
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    label: "REMOVE";
                    fixed-width: Theme.px(98);
                    destructive: true;
                    pressed => {
                        root.removed();
                    }
                }
            }
        }
    }

    // The same hairline every list in this interface puts *between* rows —
    // and not under the last of them. A line here means "the next one starts
    // below this"; under the only row of a list of one it ends nothing, and
    // this page had two of those before it had any content
    // (`MASTER_ISSUES` 121).
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One listener: their name, and the one thing to do about them.
component ProfileRow inherits Rectangle {
    in property <ProfileRowData> data;
    in property <bool> last;

    callback chosen();

    height: Theme.row-height;

    HorizontalLayout {
        y: round((parent.height - Theme.px(48)) / 1px / 2) * 1px;
        height: Theme.px(48);
        spacing: Theme.space-4;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Theme.px(2);

            Text {
                text: root.data.name;
                font-family: Theme.serif;
                font-size: Theme.text-lead;
                height: Theme.px(26);
                vertical-alignment: center;
                color: root.data.active ? Theme.ink-0 : Theme.ink-1;
                overflow: elide;
            }
            Text {
                text: root.data.note;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            TextButton {
                label: root.data.active ? "LISTENING" : "SWITCH";
                fixed-width: Theme.px(116);
                selected: root.data.active;
                enabled: !root.data.active;
                pressed => {
                    root.chosen();
                }
            }
        }
    }

    // Between rows, never under the last: see `FolderRow`.
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One track that was taken out of the library but not off the disk.
component TakenOutRow inherits Rectangle {
    in property <TakenOutRowData> data;
    in property <bool> last;

    callback restored();

    height: Theme.row-height;

    HorizontalLayout {
        y: round((parent.height - Theme.px(48)) / 1px / 2) * 1px;
        height: Theme.px(48);
        spacing: Theme.space-4;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Theme.px(2);

            Text {
                text: root.data.title;
                font-family: Theme.serif;
                font-size: Theme.text-lead;
                height: Theme.px(26);
                vertical-alignment: center;
                color: Theme.ink-1;
                overflow: elide;
            }
            Text {
                text: root.data.gone ? "the file is gone" : root.data.subtitle;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.line-label;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;

            TextButton {
                label: "BRING BACK";
                fixed-width: Theme.px(132);
                // Nothing to bring back to: the file left the disk, and saying
                // so is better than a button that fails.
                enabled: !root.data.gone;
                pressed => {
                    root.restored();
                }
            }
        }
    }

    // Between rows, never under the last: see `FolderRow`.
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// Everything about this copy of Cadenza that is the listener's to decide.
export component SettingsView inherits Rectangle {
    in property <bool> dark;
    in property <bool> crossfade-on;
    in property <int> crossfade-seconds;
    /// How large the interface is drawn, as a percentage.
    in property <int> ui-scale;
    in property <bool> history-on;
    in property <[FolderRowData]> folders;
    in property <[TakenOutRowData]> taken-out;
    /// How many of those have no file behind them any more.
    in property <int> gone-for-good;
    /// How many tracks came from outside every folder.
    in property <int> outside-folders;
    in property <[ProfileRowData]> profiles;
    /// Where this machine keeps music, for somebody with nowhere to point at.
    in property <string> suggested;
    in property <string> summary;

    callback switch-profile(string);
    callback new-profile();
    callback set-theme(bool);
    callback set-crossfade(bool, int);
    callback set-ui-scale(int);
    callback set-history(bool);
    callback add-folder();
    callback use-suggested();
    callback remove-folder(string);
    callback synchronise-folder(string);
    callback restore-track(string);
    callback forget-gone();
    callback scan-now();

    background: Theme.bg-0;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.page-top;
            padding-bottom: Theme.page-bottom;
            spacing: Theme.space-2;

            // What the page holds, in the voice every other page uses for it:
            // "THE LAST THIRTY DAYS", "BUILT FROM YOUR OWN LIBRARY". It used to
            // read "THIS COPY OF CADENZA", meaning this installation — but read
            // aloud that is a program calling itself a copy of something else,
            // which is not what it is.
            Text {
                text: "YOURS TO DECIDE";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-furniture;
            }

            Text {
                text: "Settings";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: Theme.heading-box;
                vertical-alignment: bottom;
                color: Theme.ink-0;
            }

            // Sans, where every other page has mono here. Mono carries what a
            // listener reads as a number; this line is the one in that slot
            // that carries words addressed to a person, and setting a greeting
            // on a number's spacing makes it look like a reading off a meter.
            Text {
                text: root.summary;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                vertical-alignment: center;
                color: Theme.ink-2;
            }
        }

        // One column, the width of the page, read top to bottom in the order
        // the decisions matter: who is listening, where their music is, and
        // then how it looks and sounds. Two columns put the folders — the one
        // thing here that grows — beside a stack of switches, and left half the
        // window empty whichever way it was sized.
        //
        // A plain rectangle rather than a layout, so the fade can stand over
        // the bottom of the column instead of taking a row beneath it.
        Rectangle {
            vertical-stretch: 1;

            scroller := Flickable {
                width: parent.width;
                height: parent.height;
                // Stated, not inferred. Left to itself a flickable takes the
                // *preferred* width of what is in it, which for a column of
                // rows is as wide as the widest of them wants to be — so the
                // column laid itself out past its own edge and clipped what
                // fell off (MASTER_ISSUES 64).
                viewport-width: self.width;
                viewport-height: choices.preferred-height;

                choices := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding-left: Theme.page-inset;
                    padding-right: Theme.page-inset;
                    padding-bottom: Theme.space-6;
                    // Wider apart than the rows inside them, so that the eye
                    // reads seven groups rather than one long list.
                    spacing: Theme.space-6;

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "WHO IS LISTENING";
                        }
                        SectionNote {
                            text: "Each has their own library and queue.";
                        }

                        for profile[index] in root.profiles: ProfileRow {
                            data: profile;
                            last: index == root.profiles.length - 1;
                            chosen => {
                                root.switch-profile(profile.id);
                            }
                        }

                        HorizontalLayout {
                            alignment: start;

                            TextButton {
                                label: "NEW LISTENER…";
                                fixed-width: Theme.px(208);
                                pressed => {
                                    root.new-profile();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "WHERE YOUR MUSIC IS";
                        }
                        // Every other group here says what it is for in a line
                        // under its rule. This one did not, and the first
                        // folder stood against the hairline as a result.
                        SectionNote {
                            text: "Cadenza watches these and picks up what you put in them.";
                        }

                        if root.folders.length == 0: VerticalLayout {
                            spacing: Theme.space-2;

                            Text {
                                text: "No folders yet";
                                font-family: Theme.serif;
                                font-size: Theme.text-title;
                                height: Theme.px(34);
                                vertical-alignment: center;
                                color: Theme.ink-2;
                            }
                            SectionNote {
                                text: "Point Cadenza at music you already have — or let it make a folder for you to put some in.";
                                wrap: word-wrap;
                                height: Theme.px(44);
                            }
                            Text {
                                text: root.suggested;
                                font-family: Theme.mono;
                                font-size: Theme.text-label;
                                height: Theme.px(18);
                                vertical-alignment: center;
                                letter-spacing: Theme.number-spacing;
                                color: Theme.ink-mute;
                                overflow: elide;
                            }
                        }

                        // A plain repetition rather than a list of its own: the
                        // page already scrolls, and a scrolling list inside a
                        // scrolling page is two places to be lost in.
                        for folder[index] in root.folders: FolderRow {
                            data: folder;
                            last: index == root.folders.length - 1;
                            removed => {
                                root.remove-folder(folder.id);
                            }
                            synchronised => {
                                root.synchronise-folder(folder.id);
                            }
                        }

                        // Tracks that came in from somewhere no folder covers —
                        // a file dropped on the window. Not a fault; simply not
                        // something a scan, a watcher or a synchronise can look
                        // after, and better said than discovered.
                        if root.outside-folders > 0: Text {
                            text: root.outside-folders + " tracks came from outside these folders";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: Theme.px(18);
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            TextButton {
                                label: "ADD FOLDER…";
                                fixed-width: Theme.px(148);
                                primary: true;
                                pressed => {
                                    root.add-folder();
                                }
                            }
                            TextButton {
                                label: "MAKE ME ONE";
                                fixed-width: Theme.px(148);
                                pressed => {
                                    root.use-suggested();
                                }
                            }
                            TextButton {
                                label: "SCAN NOW";
                                fixed-width: Theme.px(148);
                                pressed => {
                                    root.scan-now();
                                }
                            }
                        }
                    }

                    // Only while there is something in it. A list that is empty
                    // nine days out of ten is a place nobody looks; one that
                    // appears when it has something to say is read the first
                    // time. Directly under the folders, because it is the same
                    // subject: what the library holds and what it does not.
                    if root.taken-out.length > 0: VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "TAKEN OUT";
                        }
                        SectionNote {
                            text: "Removed here, not deleted from disk.";
                        }

                        for track[index] in root.taken-out: TakenOutRow {
                            data: track;
                            last: index == root.taken-out.length - 1;
                            restored => {
                                root.restore-track(track.id);
                            }
                        }

                        // Only where at least one of them has nothing left to
                        // come back to. A row whose file is still on the disk
                        // is not clutter — it is the removal itself, and it is
                        // what keeps that track out the next time the folder is
                        // scanned. This offers the other kind and says which.
                        if root.gone-for-good > 0: VerticalLayout {
                            spacing: Theme.space-2;

                            SectionNote {
                                text: root.gone-for-good == 1
                                    ? "One of these has no file left. Forgetting it takes it off this list for good."
                                    : root.gone-for-good + " of these have no file left. Forgetting them takes them off this list for good.";
                            }

                            HorizontalLayout {
                                alignment: start;

                                TextButton {
                                    label: "FORGET THE GONE";
                                    fixed-width: Theme.px(180);
                                    pressed => {
                                        root.forget-gone();
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "APPEARANCE";
                        }
                        SectionNote {
                            text: "Which way round the ink and the paper go.";
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            TextButton {
                                label: "DARK";
                                fixed-width: Theme.px(100);
                                selected: root.dark;
                                pressed => {
                                    root.set-theme(true);
                                }
                            }
                            TextButton {
                                label: "LIGHT";
                                fixed-width: Theme.px(100);
                                selected: !root.dark;
                                pressed => {
                                    root.set-theme(false);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "SIZE";
                        }
                        SectionNote {
                            text: "How large everything is drawn.";
                        }

                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            // The same width as every other choice on this
                            // page. They were narrowed to 74 to fit four across
                            // a 320-wide column; the column is the width of the
                            // page now, and there is no reason for these four
                            // to be the odd ones out.
                            for percent in [90, 100, 110, 125]: TextButton {
                                label: percent + "%";
                                fixed-width: Theme.px(100);
                                selected: root.ui-scale == percent;
                                pressed => {
                                    root.set-ui-scale(percent);
                                }
                            }
                        }

                        SectionNote {
                            text: "The window grows and shrinks with it.";
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "CROSSFADE";
                        }
                        SectionNote {
                            text: "Ordinary tracks fade into each other.";
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            TextButton {
                                label: "ON";
                                fixed-width: Theme.px(100);
                                selected: root.crossfade-on;
                                pressed => {
                                    root.set-crossfade(true, root.crossfade-seconds);
                                }
                            }
                            TextButton {
                                label: "OFF";
                                fixed-width: Theme.px(100);
                                selected: !root.crossfade-on;
                                pressed => {
                                    root.set-crossfade(false, root.crossfade-seconds);
                                }
                            }
                        }

                        // Three lengths, which is the whole range 2.4 allows.
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            for seconds in [3, 4, 5]: TextButton {
                                label: seconds + "";
                                fixed-width: Theme.px(100);
                                selected: root.crossfade-seconds == seconds;
                                pressed => {
                                    root.set-crossfade(root.crossfade-on, seconds);
                                }
                            }
                        }

                        SectionNote {
                            text: "Seconds. Playlists and radio never fade.";
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;

                        SectionLabel {
                            text: "HISTORY";
                        }
                        SectionNote {
                            text: "What you played, kept for thirty days.";
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: Theme.space-2;

                            TextButton {
                                label: "KEEP";
                                fixed-width: Theme.px(100);
                                selected: root.history-on;
                                pressed => {
                                    root.set-history(true);
                                }
                            }
                            TextButton {
                                label: "DO NOT";
                                fixed-width: Theme.px(100);
                                selected: !root.history-on;
                                pressed => {
                                    root.set-history(false);
                                }
                            }
                        }
                    }
                }
            }

            ScrollFade {
                y: parent.height - self.height;
                width: parent.width;
                more: scroller.viewport-height + scroller.viewport-y > scroller.height;
            }
        }
    }
}
