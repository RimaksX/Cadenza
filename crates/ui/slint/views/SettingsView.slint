import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { TextButton } from "../components/Dialog.slint";

// One folder the library watches, as the view model hands it over.
export struct FolderRowData {
    id: string,
    path: string,
    note: string,
}

// A heading over a group of controls. Mono capitals and a rule to the edge —
// the same device the sidebar uses to separate one group of destinations from
// the next, because it is the same kind of statement.
component SectionLabel inherits Rectangle {
    in property <string> text;

    height: 26px;

    HorizontalLayout {
        y: round((parent.height - 18px) / 2px) * 2px;
        height: 18px;
        spacing: Theme.space-2;

        VerticalLayout {
            alignment: center;

            Text {
                text: root.text;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }

        Rectangle {
            y: 8px;
            height: 1px;
            background: Theme.line-soft;
        }
    }
}

// A line of explanation under a group of controls.
component SectionNote inherits Text {
    font-family: Theme.sans;
    font-size: Theme.text-body;
    height: 22px;
    vertical-alignment: center;
    color: Theme.ink-mute;
    overflow: elide;
}

// One watched folder: where it is, and the one thing that can be done to it.
component FolderRow inherits Rectangle {
    in property <FolderRowData> data;

    callback removed();

    height: 46px;

    VerticalLayout {
        y: round((parent.height - 40px) / 2px) * 2px;
        height: 40px;

        HorizontalLayout {
            spacing: Theme.space-4;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;

                Text {
                    text: root.data.path;
                    font-family: Theme.sans;
                    font-size: Theme.text-body;
                    height: 22px;
                    vertical-alignment: center;
                    color: Theme.ink-0;
                    overflow: elide;
                }
                Text {
                    text: root.data.note;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    height: 18px;
                    vertical-alignment: center;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;

                TextButton {
                    label: "REMOVE";
                    fixed-width: 98px;
                    destructive: true;
                    pressed => {
                        root.removed();
                    }
                }
            }
        }
    }

    // The same hairline every list in this interface puts under a row.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// Everything about this copy of Cadenza that is the listener's to decide.
export component SettingsView inherits Rectangle {
    in property <bool> dark;
    in property <bool> crossfade-on;
    in property <int> crossfade-seconds;
    in property <bool> history-on;
    in property <[FolderRowData]> folders;
    /// Where this machine keeps music, for somebody with nowhere to point at.
    in property <string> suggested;
    in property <string> summary;

    callback set-theme(bool);
    callback set-crossfade(bool, int);
    callback set-history(bool);
    callback add-folder();
    callback use-suggested();
    callback remove-folder(string);
    callback scan-now();

    background: Theme.bg-0;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "THIS COPY OF CADENZA";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }

            Text {
                text: "Settings";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: 54px;
                vertical-alignment: bottom;
                color: Theme.ink-0;
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-6;

            // The three decisions that fit in a line each.
            VerticalLayout {
                width: 320px;
                spacing: Theme.space-4;

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "APPEARANCE";
                    }
                    SectionNote {
                        text: "Which way round the ink and the paper go.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "DARK";
                            fixed-width: 100px;
                            selected: root.dark;
                            pressed => {
                                root.set-theme(true);
                            }
                        }
                        TextButton {
                            label: "LIGHT";
                            fixed-width: 100px;
                            selected: !root.dark;
                            pressed => {
                                root.set-theme(false);
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "CROSSFADE";
                    }
                    SectionNote {
                        text: "Ordinary tracks fade into each other.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "ON";
                            fixed-width: 100px;
                            selected: root.crossfade-on;
                            pressed => {
                                root.set-crossfade(true, root.crossfade-seconds);
                            }
                        }
                        TextButton {
                            label: "OFF";
                            fixed-width: 100px;
                            selected: !root.crossfade-on;
                            pressed => {
                                root.set-crossfade(false, root.crossfade-seconds);
                            }
                        }
                    }

                    // Three lengths, which is the whole range 2.4 allows.
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        for seconds in [3, 4, 5]: TextButton {
                            label: seconds + " SECONDS";
                            fixed-width: 132px;
                            selected: root.crossfade-seconds == seconds;
                            pressed => {
                                root.set-crossfade(root.crossfade-on, seconds);
                            }
                        }
                    }

                    SectionNote {
                        text: "Playlists and radio stay gapless either way.";
                    }
                }

                VerticalLayout {
                    spacing: Theme.space-2;

                    SectionLabel {
                        text: "HISTORY";
                    }
                    SectionNote {
                        text: "What you played, kept for thirty days.";
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.space-2;

                        TextButton {
                            label: "KEEP";
                            fixed-width: 100px;
                            selected: root.history-on;
                            pressed => {
                                root.set-history(true);
                            }
                        }
                        TextButton {
                            label: "DO NOT";
                            fixed-width: 100px;
                            selected: !root.history-on;
                            pressed => {
                                root.set-history(false);
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }

            // The folders, which is the one thing here that grows.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-2;

                SectionLabel {
                    text: "WHERE YOUR MUSIC IS";
                }

                if root.folders.length == 0: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: Theme.space-3;

                    Text {
                        text: "No folders yet";
                        font-family: Theme.serif;
                        font-size: Theme.text-title;
                        height: 30px;
                        vertical-alignment: center;
                        color: Theme.ink-2;
                    }
                    SectionNote {
                        text: "Point Cadenza at music you already have — or let it make a folder for you to put some in.";
                        wrap: word-wrap;
                        height: 44px;
                    }
                    Text {
                        text: root.suggested;
                        font-family: Theme.mono;
                        font-size: Theme.text-label;
                        height: 18px;
                        vertical-alignment: center;
                        letter-spacing: Theme.number-spacing;
                        color: Theme.ink-mute;
                        overflow: elide;
                    }
                }

                if root.folders.length > 0: ListView {
                    vertical-stretch: 1;

                    for folder[index] in root.folders: FolderRow {
                        data: folder;
                        removed => {
                            root.remove-folder(folder.id);
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-2;

                    TextButton {
                        label: "ADD FOLDER…";
                        fixed-width: 148px;
                        primary: true;
                        pressed => {
                            root.add-folder();
                        }
                    }
                    TextButton {
                        label: "MAKE ME ONE";
                        fixed-width: 148px;
                        pressed => {
                            root.use-suggested();
                        }
                    }
                    TextButton {
                        label: "SCAN NOW";
                        fixed-width: 148px;
                        pressed => {
                            root.scan-now();
                        }
                    }
                }
            }
        }
    }
}
