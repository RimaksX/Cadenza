import { TrackList } from "../components/TrackList.slint";

// What the listener queued by hand, in the order they queued it.
//
// Only that. What follows the current track when this is empty - the rest of
// the library, the rest of a playlist, a station's next pick - is the source
// playing, not a list anybody wrote, and putting it here made the queue look
// like something that fills itself. The view does not sort, it lists.
export component QueueView inherits TrackList {
    heading: "What follows";
    empty-title: "Nothing waiting";
    // These rows are the queue. Offering to queue them again would be the one
    // control on the page that could not do anything useful.
    queued: true;
}
