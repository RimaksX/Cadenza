import { TrackList } from "../components/TrackList.slint";

// Everything the profile has, in one list.
//
// The words are the whole of this view: the page it draws is `TrackList`, which
// the queue draws too. What makes this the library is what it is called and what
// it says when it is empty — `tracks`, `summary`, `playing-id` and `play` come
// through from `TrackList` unchanged.
export component LibraryView inherits TrackList {
    eyebrow: "YOUR LIBRARY";
    heading: "Everything you have";
    empty-title: "Nothing here yet";
}
