import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { TextButton } from "../components/Dialog.slint";
import { RowMenu, MenuItemData } from "../components/RowMenu.slint";

// One playlist, as the view model hands it over. Every field is already the
// string to draw: numbering, pluralising and formatting a duration are
// decisions, and decisions belong in Rust.
export struct PlaylistCardData {
    id: string,
    name: string,
    position: string,
    maker: string,
    meta: string,
}

// One playlist as a tile: a square, and its name and size beneath.
//
// The square is where a picture goes when a listener can choose one. Until then
// it holds the name, set large — which is what the reference does for a record
// with no sleeve, and is why the page will not change shape the day the first
// cover arrives.
export component PlaylistCard inherits Rectangle {
    in property <PlaylistCardData> data;

    callback activated();
    callback played();
    callback acted(string);

    // One state for the whole tile. A nested touch area takes the pointer from
    // the one beneath it, so asking only the tile's own area meant the tile
    // dropped back down the moment the hand reached a button on it.
    property <bool> hovered: touch.has-hover || dots.has-hover || start.has-hover;

    touch := TouchArea {
        // One click. Opening a list is not a destructive act, and there is
        // nothing else a click on a tile could mean.
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
        // The right button opens the same menu the dots do. Nobody has to know
        // that it works, which is exactly why it is not the only way in.
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                menu.show();
            }
        }
    }

    VerticalLayout {
        spacing: Theme.space-3;

        // The square keeps its place in the layout; what rises under the
        // pointer is what is drawn inside it. A layout sets its children's `y`
        // itself, so the lift has to happen a level down.
        Rectangle {
            height: root.width;

            Rectangle {
                width: 100%;
                height: 100%;
                y: root.hovered ? -4px : 0;
                background: @linear-gradient(150deg, Theme.bg-2 0%, Theme.bg-1 55%, Theme.bg-0 100%);
                border-width: 1px;
                border-color: root.hovered ? Theme.line : Theme.line-soft;
                animate y, border-color { duration: 300ms; easing: ease-out; }

                VerticalLayout {
                padding: 20px;

                HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: "PLAYLIST";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                        }
                    }
                    // The number steps aside for the menu rather than sharing
                    // the corner with it: the same trade the track rows make,
                    // where a mark becomes the control that acts on it.
                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: root.data.position;
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                            opacity: root.hovered ? 0.0 : 1.0;
                            animate opacity { duration: 120ms; }
                        }
                    }
                }

                // The name, filling the middle. Italic serif: a playlist's name
                // is a thing somebody called something, not a title of a work.
                Text {
                    text: root.data.name;
                    font-family: Theme.serif;
                    font-italic: true;
                    font-size: Theme.text-display;
                    color: Theme.ink-0;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-stretch: 1;
                }

                Text {
                    text: root.data.maker;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    height: 18px;
                    vertical-alignment: center;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-2;
                }
                }

                // The list's own actions, in the corner its number occupies at
                // rest. Three dots because there is no shape for "rename", and
                // a shape nobody can read is worse than a mark that says
                // "there is more here".
                //
                // Always built, faded rather than absent: its own touch area is
                // named in the condition that would have created it, and an
                // element cannot decide whether to exist by asking itself.
                Rectangle {
                    x: parent.width - self.width - 12px;
                    y: 12px;
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius;
                    background: dots.has-hover ? Theme.bg-3 : transparent;
                    opacity: root.hovered ? 1.0 : 0.0;
                    animate background, opacity { duration: 120ms; }

                    // Horizontal on a tile, where there is width to spare and
                    // the mark sits in a corner of its own.
                    Image {
                        source: @image-url("../../../../resources/ui/icons/dots.svg");
                        width: 18px;
                        height: self.width;
                        x: round((parent.width - self.width) / 1px / 2) * 1px;
                        y: round((parent.height - self.height) / 1px / 2) * 1px;
                        colorize: dots.has-hover ? Theme.ink-0 : Theme.ink-1;
                        animate colorize { duration: 120ms; }
                    }

                    dots := TouchArea {
                        // Invisible until the tile is under the pointer, and
                        // unclickable until then: a button nobody can see is
                        // not a button, whatever it does when pressed.
                        enabled: root.hovered;
                        mouse-cursor: pointer;
                        clicked => {
                            menu.show();
                        }
                    }

                    // Opens to the left of the dots, because they sit at the
                    // right edge of a tile that may itself be at the right edge
                    // of the window.
                    menu := RowMenu {
                        x: 32px - self.width;
                        y: 32px;
                        items: [
                            { action: "rename", label: "Rename…" },
                            { action: "delete", label: "Delete playlist", destructive: true },
                        ];
                        chosen(action) => {
                            root.acted(action);
                        }
                    }
                }

                // Play the list without opening it. The filled circle is the
                // same one the player bar uses for the button you reach for
                // without looking, and it means the same thing here.
                Rectangle {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    width: 44px;
                    height: 44px;
                    border-radius: self.width / 2;
                    background: start.has-hover ? Theme.ink-1 : Theme.ink-0;
                    opacity: root.hovered ? 1.0 : 0.0;
                    animate background, opacity { duration: 120ms; }

                    Image {
                        source: @image-url("../../../../resources/ui/icons/play.svg");
                        width: 16px;
                        height: self.width;
                        x: (parent.width - self.width) / 2 + 1px;
                        y: round((parent.height - self.height) / 1px / 2) * 1px;
                        colorize: Theme.bg-0;
                    }

                    start := TouchArea {
                        enabled: root.hovered;
                        mouse-cursor: pointer;
                        clicked => {
                            root.played();
                        }
                    }
                }
            }
        }

        // The caption. It does not move with the square: the tile lifts, the
        // words stay where they were read.
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            Text {
                text: root.data.name;
                font-family: Theme.serif;
                font-size: Theme.text-title;
                height: 30px;
                vertical-alignment: center;
                color: root.hovered ? Theme.ink-0 : Theme.ink-1;
                overflow: elide;
                animate color { duration: 120ms; }
            }

            Text {
                text: root.data.meta;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
                overflow: elide;
            }
        }
    }
}

// The lists the listener keeps.
export component PlaylistsView inherits Rectangle {
    in property <[PlaylistCardData]> playlists;
    in property <string> summary;
    in property <string> empty-hint;

    callback open(string);
    callback play(string);
    callback create();
    /// A playlist, its name and what to do to it. The name travels with the
    /// identifier because the dialog that follows has to show it, and finding
    /// a row by identifier in a model is work the model already did.
    callback act(string, string, string);

    // A tile stops being a tile below this: the name inside it is set large,
    // and a square too small to hold two words of it is a grey box.
    property <length> min-tile: 220px;
    property <length> gap-x: Theme.space-6;
    property <length> gap-y: 40px;
    // The square, plus the caption under it and the space between: twelve for
    // the gap, thirty for the name, four between the two lines, eighteen for
    // the size. Counted rather than estimated — at forty-eight the caption
    // overflowed its own card by sixteen pixels into the gap below, and the
    // rows stood that much closer together than the grid said they did.
    property <length> caption-height: 64px;
    // Room above the first row for the lift on hover. A scroll view clips at
    // its own edge, so without this the top row rises straight through it and
    // loses its border to the crop.
    property <length> headroom: 6px;

    property <length> available: self.width - 2 * Theme.page-inset;
    property <int> columns: max(1, min(5, floor((root.available + root.gap-x) / (root.min-tile + root.gap-x))));
    // Rounded to a whole pixel. A tile on a fractional x puts every word in it
    // on a fractional x too, and text snapped to the pixel grid from half a
    // pixel out is text whose letters sit at slightly different heights.
    property <length> tile-width: round((root.available - (root.columns - 1) * root.gap-x) / root.columns / 1px) * 1px;
    property <length> card-height: root.tile-width + root.caption-height;
    property <length> row-height: root.card-height + root.gap-y;

    background: Theme.bg-0;

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: Theme.page-inset;
            padding-right: Theme.page-inset;
            padding-top: Theme.space-6;
            padding-bottom: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "YOUR LISTS";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }

            // The title, and the one action the page itself offers. Beside the
            // heading rather than in a toolbar: there is no toolbar, and a page
            // with one verb does not need a strip to keep it in.
            HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "Playlists";
                        font-family: Theme.serif;
                        font-size: Theme.text-display;
                        height: 54px;
                        vertical-alignment: center;
                        color: Theme.ink-0;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    TextButton {
                        label: "+ NEW PLAYLIST";
                        primary: true;
                        pressed => {
                            root.create();
                        }
                    }
                }
            }

            Text {
                text: root.summary;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-2;
            }
        }

        // See the note in `TrackList`: without a child that takes the surplus,
        // a column layout spreads it across every child and the page head comes
        // apart.
        if root.playlists.length == 0: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: Theme.space-3;

                Text {
                    text: "No lists yet";
                    font-family: Theme.serif;
                    font-size: Theme.text-display;
                    height: 54px;
                    vertical-alignment: center;
                    color: Theme.ink-2;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.empty-hint;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    color: Theme.ink-mute;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // Placed rather than laid out: Slint's layouts are one row or one
        // column, and a grid over a model's length is arithmetic on the index —
        // which is what its own date picker does with a month of days.
        if root.playlists.length > 0: ScrollView {
            vertical-stretch: 1;
            viewport-height: root.headroom + ceil(root.playlists.length / root.columns) * root.row-height;

            for entry[index] in root.playlists: PlaylistCard {
                data: entry;
                width: root.tile-width;
                height: root.card-height;
                x: Theme.page-inset + mod(index, root.columns) * (root.tile-width + root.gap-x);
                y: root.headroom + floor(index / root.columns) * root.row-height;
                activated => {
                    root.open(entry.id);
                }
                played => {
                    root.play(entry.id);
                }
                acted(action) => {
                    root.act(entry.id, entry.name, action);
                }
            }
        }
    }
}
