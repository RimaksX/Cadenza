import { Theme } from "../theme/tokens.slint";

// A transport control. The icons are line drawings in `currentColor`, and
// `colorize` repaints whatever they render as, so one file serves both themes
// and every state.
//
// `primary` inverts it: a filled circle in the loudest ink with the glyph cut
// out of it. One button on the bar is the one you reach for without looking,
// and it is the only thing here that is not a line on a surface.
component TransportButton inherits Rectangle {
    in property <image> glyph;
    in property <bool> primary;
    in property <bool> quiet;
    in property <bool> active;
    in property <bool> enabled: true;
    /// How big the glyph is drawn.
    ///
    /// Three steps by default - see the note where it is used - and settable
    /// for a control that belongs to none of the three. The heart is the one:
    /// it stands apart from the group, so it is not a step back from anything,
    /// and at the quiet 16 it read as a mark rather than as a button.
    in property <length> glyph-size: root.primary
        ? Theme.px(20)
        : (root.quiet ? Theme.px(16) : Theme.px(18));
    /// Moves the glyph off the geometric middle, for a glyph whose weight is
    /// not in its middle. See the note on the play button below.
    in property <length> nudge;

    callback pressed();

    // Equal heights, because a row lays children of differing height against
    // its top edge — which is what put the small buttons above the play
    // button's axis. The width still hugs what it draws, or the gaps between
    // icons grow by the difference and the group reads as scattered.
    width: root.primary ? Theme.px(40) : Theme.px(28);
    height: Theme.px(40);

    // The circle is a child, centred in that square.
    Rectangle {
        width: root.primary ? Theme.px(40) : Theme.px(28);
        height: self.width;
        x: round((parent.width - self.width) / 1px / 2) * 1px;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        border-radius: self.width / 2;
        // A disabled primary button loses its fill as well as its glyph. Left
        // filled, it shouts "press me" in the loudest ink in the palette while
        // the icon inside says it cannot be pressed.
        background: !root.primary
            ? transparent
            : (!root.enabled
                ? Theme.bg-2
                : (touch.has-hover ? Theme.ink-1 : Theme.ink-0));
        animate background { duration: 120ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.pressed();
        }
    }

    Image {
        source: root.glyph;
        // Twenty for the one that starts the music, eighteen for the ones
        // beside it, sixteen for the two modes that sit a step back. The three
        // steps are the ones this bar always had — 16, 16 and 14 — moved up
        // together, because at those sizes a glyph in a 40-pixel circle read as
        // a mark rather than as a control.
        width: root.glyph-size;
        height: self.width;
        x: round((parent.width - self.width) / 1px / 2) * 1px + root.nudge;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        image-fit: contain;
        // Three answers, not two. `active` is a mode that is *on* — shuffle,
        // repeat — and it takes the accent, the same colour as the progress
        // line and the number of the row that is sounding: this interface says
        // "in force" in one colour. Hover is only where the pointer is, and
        // says so in the loudest ink. They were the same before, so a mode
        // that was on looked like a button being pointed at.
        colorize: !root.enabled
            ? Theme.ink-disabled
            : (root.primary
                ? Theme.bg-0
                : (root.active
                    ? Theme.accent
                    : (touch.has-hover ? Theme.ink-0 : Theme.ink-2)));
        animate colorize { duration: 120ms; }
        // Shuffle and repeat sit a step back from the three that move the
        // music: they change how it continues, not whether it is playing.
        opacity: root.quiet && !root.active ? 0.7 : 1.0;
    }
}

// A line that reports a fraction, and can be dragged by it.
//
// The line itself is Theme.px(2); the target around it is Theme.px(14), because a Theme.px(2) line is
// a thing you aim at rather than a thing you use. The knob appears on hover
// and is what the hand goes for — but the whole target drags, whether the
// press landed on the knob or not.
//
// `live` decides when the fraction is reported. Volume is an atomic store and
// can follow the finger; a seek is a flush handshake with the audio callback
// that can block for 200ms, so the position is reported once, on release,
// and the line shows where the finger is in the meantime.
component Scrubber inherits Rectangle {
    in property <float> progress;
    in property <bool> enabled: true;
    in property <bool> live;
    // The accent's home. What is playing and how far through it are the one
    // thing this window is about, and the ten per cent of a screen that may
    // carry a colour is spent here rather than spread over controls that would
    // then all be asking for attention at once.
    in property <color> fill: Theme.accent;

    callback moved(float);

    // Where the finger is while it is down. Nothing outside this component
    // sees it — it exists so the fill can lead the value it will eventually
    // report.
    private property <float> held;
    private property <float> shown: touch.pressed
        ? root.held
        : max(0, min(1, root.progress));

    height: Theme.px(14);

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;

        pointer-event(event) => {
            // Move events carry no button, and `moved` already handles them.
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.grab();
            } else if (event.kind == PointerEventKind.up) {
                // A plain click never fires `moved`, so this is also what
                // makes a click work: press set `held`, release reports it.
                root.moved(root.held);
            }
        }

        // The pointer is grabbed on press, so this keeps arriving after the
        // finger has left the line — dragging past either end pins the
        // fraction to that end rather than losing the drag.
        moved => {
            root.grab();
        }
    }

    function grab() {
        root.held = max(0, min(1, touch.mouse-x / touch.width));
        if (root.live) {
            root.moved(root.held);
        }
    }

    Rectangle {
        height: Theme.px(2);
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.line;

        played := Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: parent.height;
            background: root.fill;
        }
    }

    // Hidden rather than absent, so it can fade. It is drawn last, over the
    // line, and it is not a target of its own: the touch area under it is.
    Rectangle {
        width: touch.pressed ? Theme.px(12) : Theme.px(10);
        height: self.width;
        border-radius: self.width / 2;
        x: played.width - self.width / 2;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.ink-0;
        opacity: root.enabled && (touch.has-hover || touch.pressed) ? 1.0 : 0.0;
        animate opacity, width { duration: 120ms; }
    }
}

export component PlayerBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> initial;
    /// The cover of what is playing, empty where there is none.
    in property <image> cover;
    in property <string> position;
    in property <string> duration;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume;
    in property <bool> shuffle;
    in property <bool> repeating;
    in property <bool> repeat-one;
    in property <bool> has-next;
    in property <bool> has-previous;
    /// Whether what is playing is in the listener's favourites.
    in property <bool> favourite;

    callback toggle-play();
    /// Take me to what this is describing.
    callback show-playing();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favourite();

    height: Theme.player-height;
    background: Theme.bg-1;

    HorizontalLayout {
        // No padding on the near side. The block that says what is playing
        // carries its own, so that the highlight behind it can reach the edge
        // of the window while the cover still stands where it always did
        // (`MASTER_ISSUES` 133).
        padding-right: Theme.space-5;
        spacing: Theme.space-6;

        // What is playing, and the way back to it.
        //
        // The block that says what is playing is the thing to press to be shown
        // it — the same gesture every music player has, and the one place where
        // it needs no button of its own. It lights as a whole under the pointer,
        // which is this interface's own way of saying a thing can be pressed,
        // and it does nothing at all while nothing is playing
        // (`MASTER_ISSUES` 133).
        //
        // The same 284 the volume column takes on the other side, so the
        // transport between them stays on the window's own middle. What
        // changed is where the 24 goes: it used to be the layout's padding,
        // outside the highlight, and is now the block's own — the same gap
        // before the cover and after the words, with the mark itself running
        // to the edge.
        Rectangle {
            width: Theme.px(324);
            background: root.loaded && now-touch.has-hover ? Theme.bg-2 : transparent;
            // No radius. Everything this mark touches is square — the window's
            // corner, the bar's own seam, the edge of the screen — and a
            // rounded box against three straight edges reads as a sticker
            // rather than as part of the bar.
            animate background { duration: 120ms; }

            now-touch := TouchArea {
                enabled: root.loaded;
                mouse-cursor: pointer;
                clicked => {
                    root.show-playing();
                }
            }

        HorizontalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            spacing: Theme.space-3;
            alignment: start;

            VerticalLayout {
                alignment: center;

                // The square where the cover goes, and a letter until there is
                // one. Rounded like the covers in the rows: the same picture
                // twice on one screen should not be two different shapes.
                // No border. A cover is a picture, and a hairline drawn round
                // it is a line across the edge of somebody's artwork — the same
                // square in a library row never had one, and the two are the
                // same object (`MASTER_ISSUES` 125). The surface underneath is
                // what shows while there is no picture.
                Rectangle {
                    width: Theme.px(56);
                    height: Theme.px(56);
                    background: Theme.bg-2;
                    border-radius: Theme.radius;
                    clip: true;

                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.cover;
                        image-fit: ImageFit.cover;
                    }

                    // The letter is what a square holds when it has no picture,
                    // and it steps aside for one.
                    Text {
                        text: root.initial;
                        font-family: Theme.serif;
                        font-italic: true;
                        font-size: Theme.text-title;
                        height: Theme.px(34);
                        color: Theme.ink-1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        opacity: root.cover.width > 0 ? 0.0 : 1.0;
                        animate opacity { duration: 300ms; }
                    }

                    // Nothing else is drawn here. Eight bars used to stand on
                    // the floor of this square while something played, which
                    // was worth looking at when the square was usually empty —
                    // and became a lattice over the record's own cover once
                    // every track had one (`MASTER_ISSUES` 115).
                }
            }

            // Both lines carry an explicit, even height. The block is two
            // lines or one depending on what is playing; left to their natural
            // heights the pair sums to something odd, the layout centres it on
            // half a pixel, and the title comes out visibly softer than the
            // same face everywhere else in the window.
            VerticalLayout {
                alignment: center;
                spacing: Theme.px(4);
                horizontal-stretch: 1;

                Text {
                    height: Theme.px(34);
                    text: root.loaded ? root.title : "Nothing playing";
                    font-family: Theme.serif;
                    font-size: Theme.text-title;
                    color: root.loaded ? Theme.ink-0 : Theme.ink-mute;
                    overflow: elide;
                }
                // Artist and album on one line, in the same mono capitals the
                // column labels use: it is a caption, not a name.
                if root.subtitle != "": Text {
                    height: Theme.px(18);
                    text: root.subtitle;
                    font-family: Theme.mono;
                    font-size: Theme.text-label;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                    overflow: elide;
                }
            }

            // Whether this one is a favourite, and the way to say so.
            //
            // Beside what is playing rather than among the transport controls:
            // it is a statement about this track, and the five buttons in the
            // middle are all statements about the music going forwards. Filled
            // and in the accent when the track is in the list, which is the
            // colour this interface uses for everything in force.
            //
            // **A fixed slot at the end of the text column, not something that
            // follows the words.** A heart placed after the title would move
            // with every track and would be pushed off the edge by a long one.
            // Here the two share a row: the words stretch and elide, the button
            // does not, so a long title runs to an ellipsis twelve pixels short
            // of a heart that never moves (`MASTER_ISSUES` 146).
            //
            // It stood outside this block until now, which cost the title
            // nothing and put the button seventy-seven pixels from the words it
            // belongs to, in a gap with nothing else in it. The block is forty
            // wider instead — exactly the button and its gap — so the words
            // still have the same 176 they always had.
            VerticalLayout {
                alignment: center;

                TransportButton {
                    glyph: root.favourite
                        ? @image-url("../../../../resources/ui/icons/heart-filled.svg")
                        : @image-url("../../../../resources/ui/icons/heart.svg");
                    active: root.favourite;
                    quiet: true;
                    glyph-size: Theme.px(20);
                    enabled: root.loaded;
                    pressed => {
                        root.toggle-favourite();
                    }
                }
            }
        }
        }

        // Transport, and the progress line under it. Both centred, and the line
        // stops well short of the window edges: the bar is three things beside
        // each other, not one line stretched across a screen.
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-3;
            horizontal-stretch: 1;

            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-4;

                // Shuffle and repeat are modes rather than moves: they say what
                // happens later, so they answer whether or not anything is
                // playing now.
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/shuffle.svg");
                    quiet: true;
                    active: root.shuffle;
                    pressed => {
                        root.toggle-shuffle();
                    }
                }
                // Enabled whenever a track is loaded, not only when something
                // played before it: near the start of the first track, previous
                // means "start it again".
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/previous.svg");
                    enabled: root.loaded;
                    pressed => {
                        root.previous();
                    }
                }
                TransportButton {
                    glyph: root.playing
                        ? @image-url("../../../../resources/ui/icons/pause.svg")
                        : @image-url("../../../../resources/ui/icons/play.svg");
                    primary: true;
                    // One pixel right, for the triangle only.
                    //
                    // A right-pointing triangle is centred by its box and looks
                    // left of centre, because its weight is not where its box
                    // says. Measured on the rendered window rather than guessed
                    // at: the ink of the glyph, weighted by how far each pixel
                    // stands above the disc behind it, has its centre 0.90
                    // pixels left of the disc's own. One pixel leaves it 0.10
                    // out, which is the closest a whole pixel gets — and a
                    // fractional offset would put the glyph off the pixel grid
                    // and soften it, which is the thing this interface refuses
                    // to do anywhere else (`MASTER_ISSUES` 126).
                    //
                    // It stays one pixel at every size the interface can be
                    // drawn at: the error is 4.5 per cent of the glyph, which
                    // is between 0.81 and 1.17 pixels from 90 to 125 per cent.
                    //
                    // Pause gets none. Two bars either side of the middle are
                    // their own centre.
                    nudge: root.playing ? 0px : 1px;
                    enabled: root.loaded;
                    pressed => {
                        root.toggle-play();
                    }
                }
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/next.svg");
                    enabled: root.has-next;
                    pressed => {
                        root.next();
                    }
                }
                // One button, three states: the glyph says which repeat mode is
                // on, and the lit colour says that one of them is.
                TransportButton {
                    glyph: root.repeat-one
                        ? @image-url("../../../../resources/ui/icons/repeat-one.svg")
                        : @image-url("../../../../resources/ui/icons/repeat.svg");
                    quiet: true;
                    active: root.repeating;
                    pressed => {
                        root.cycle-repeat();
                    }
                }
            }

            // Not centred: centring gives each child the width it asks for, and
            // a line with no content of its own asks for none. The row stretches
            // instead, and stays centred on the window because the blocks either
            // side of it are the same width.
            HorizontalLayout {
                spacing: Theme.space-4;

                VerticalLayout {
                    alignment: center;
                    width: Theme.px(48);

                    Text {
                        text: root.position;
                        font-family: Theme.mono;
                        font-size: Theme.text-label;
                        height: Theme.px(18);
                        letter-spacing: Theme.number-spacing;
                        color: Theme.ink-mute;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Scrubber {
                        progress: root.progress;
                        enabled: root.loaded;
                        // Not live: see the note on `Scrubber`.
                        moved(fraction) => {
                            root.seek(fraction);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    width: Theme.px(48);

                    Text {
                        text: root.duration;
                        font-family: Theme.mono;
                        font-size: Theme.text-label;
                        height: Theme.px(18);
                        letter-spacing: Theme.number-spacing;
                        color: Theme.ink-mute;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Level. Fixed width to match the left block, so the middle is centred
        // on the window rather than on what is left over. The 52 is the heart
        // and its own padding, so the two ends of the bar weigh the same and
        // the transport between them sits on the window's middle. Measured on
        // the rendered window rather than reasoned about.
        HorizontalLayout {
            width: Theme.px(304);
            alignment: end;
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;

                TransportButton {
                    glyph: root.muted
                        ? @image-url("../../../../resources/ui/icons/volume-muted.svg")
                        : @image-url("../../../../resources/ui/icons/volume.svg");
                    active: root.muted;
                    pressed => {
                        root.toggle-mute();
                    }
                }
            }

            VerticalLayout {
                width: Theme.px(120);
                alignment: center;

                Scrubber {
                    progress: root.muted ? 0 : root.volume;
                    live: true;
                    fill: Theme.ink-2;
                    moved(fraction) => {
                        root.set-volume(fraction);
                    }
                }
            }
        }
    }

    // The seam between the bar and the page, drawn last so that it is drawn on
    // top. It used to be first, and the highlight behind what is playing —
    // which runs the full height of the bar — painted over it
    // (`MASTER_ISSUES` 133).
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line-soft;
    }
}
