import { Theme } from "../theme/tokens.slint";

// A transport control. The icons are line drawings in `currentColor`, and
// `colorize` repaints whatever they render as, so one file serves both themes
// and every state.
//
// `primary` inverts it: a filled circle in the loudest ink with the glyph cut
// out of it. One button on the bar is the one you reach for without looking,
// and it is the only thing here that is not a line on a surface.
component TransportButton inherits Rectangle {
    in property <image> glyph;
    in property <bool> primary;
    in property <bool> quiet;
    in property <bool> active;
    in property <bool> enabled: true;

    callback pressed();

    // Equal heights, because a row lays children of differing height against
    // its top edge — which is what put the small buttons above the play
    // button's axis. The width still hugs what it draws, or the gaps between
    // icons grow by the difference and the group reads as scattered.
    width: root.primary ? 40px : 28px;
    height: 40px;

    // The circle is a child, centred in that square.
    Rectangle {
        width: root.primary ? 40px : 28px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        // A disabled primary button loses its fill as well as its glyph. Left
        // filled, it shouts "press me" in the loudest ink in the palette while
        // the icon inside says it cannot be pressed.
        background: !root.primary
            ? transparent
            : (!root.enabled
                ? Theme.bg-2
                : (touch.has-hover ? Theme.ink-1 : Theme.ink-0));
        animate background { duration: 120ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.pressed();
        }
    }

    Image {
        source: root.glyph;
        width: root.primary ? 15px : (root.quiet ? 14px : 16px);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: !root.enabled
            ? Theme.ink-disabled
            : (root.primary
                ? Theme.bg-0
                : (root.active || touch.has-hover ? Theme.ink-0 : Theme.ink-2));
        animate colorize { duration: 120ms; }
        // Shuffle and repeat sit a step back from the three that move the
        // music: they change how it continues, not whether it is playing.
        opacity: root.quiet && !root.active ? 0.7 : 1.0;
    }
}

// A line that reports a fraction and accepts a click on it.
//
// Not a slider: a slider has a handle to grab, and a handle is a thing to
// design once the design document exists. The knob here is a consequence of the
// fill rather than a control of its own — it marks where playback is, and the
// whole line is the target.
component Scrubber inherits Rectangle {
    in property <float> progress;
    in property <bool> enabled: true;
    in property <bool> knob: true;
    in property <color> fill: Theme.ink-1;

    callback moved(float);

    height: 10px;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.moved(self.mouse-x / self.width);
        }
    }

    Rectangle {
        height: 2px;
        y: (parent.height - self.height) / 2;
        background: Theme.line;

        played := Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.progress));
            height: parent.height;
            background: root.fill;
        }
    }

    if root.knob && root.enabled: Rectangle {
        width: 10px;
        height: self.width;
        border-radius: self.width / 2;
        x: played.width - self.width / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.ink-0;
        opacity: touch.has-hover ? 1.0 : 0.85;
        animate opacity { duration: 120ms; }
    }
}

export component PlayerBar inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> initial;
    in property <string> position;
    in property <string> duration;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume;
    in property <string> message;

    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();

    height: Theme.player-height;
    background: Theme.bg-1;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line-soft;
    }

    HorizontalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        spacing: Theme.space-6;

        // What is playing. A fixed width, so the transport in the middle stays
        // in the middle whatever the title is.
        HorizontalLayout {
            width: 260px;
            spacing: Theme.space-3;
            alignment: start;

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 56px;
                    height: 56px;
                    background: Theme.bg-2;
                    border-width: 1px;
                    border-color: Theme.line-soft;

                    Text {
                        text: root.initial;
                        font-family: Theme.serif;
                        font-italic: true;
                        font-size: 22px;
                        color: Theme.ink-1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;

                Text {
                    text: root.loaded ? root.title : "Nothing playing";
                    font-family: Theme.serif;
                    font-size: Theme.text-title;
                    color: root.loaded ? Theme.ink-0 : Theme.ink-mute;
                    overflow: elide;
                }
                // Artist and album on one line, in the same mono capitals the
                // column labels use: it is a caption, not a name.
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-family: Theme.mono;
                    font-size: 10px;
                    letter-spacing: Theme.label-spacing;
                    color: Theme.ink-mute;
                    overflow: elide;
                }
            }
        }

        // Transport, and the progress line under it. Both centred, and the line
        // stops well short of the window edges: the bar is three things beside
        // each other, not one line stretched across a screen.
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-3;
            horizontal-stretch: 1;

            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-4;

                // Shuffle and repeat need a queue to shuffle and a track change
                // to repeat into, and both are M7.
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/shuffle.svg");
                    quiet: true;
                    enabled: false;
                }
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/previous.svg");
                    enabled: false;
                }
                TransportButton {
                    glyph: root.playing
                        ? @image-url("../../../../resources/ui/icons/pause.svg")
                        : @image-url("../../../../resources/ui/icons/play.svg");
                    primary: true;
                    enabled: root.loaded;
                    pressed => {
                        root.toggle-play();
                    }
                }
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/next.svg");
                    enabled: false;
                }
                TransportButton {
                    glyph: @image-url("../../../../resources/ui/icons/repeat.svg");
                    quiet: true;
                    enabled: false;
                }
            }

            // Not centred: centring gives each child the width it asks for, and
            // a line with no content of its own asks for none. The row stretches
            // instead, and stays centred on the window because the blocks either
            // side of it are the same width.
            HorizontalLayout {
                spacing: Theme.space-4;

                Text {
                    width: 44px;
                    text: root.position;
                    font-family: Theme.mono;
                    font-size: 10px;
                    letter-spacing: Theme.number-spacing;
                    color: Theme.ink-mute;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;

                    Scrubber {
                        progress: root.progress;
                        enabled: root.loaded;
                        moved(fraction) => {
                            root.seek(fraction);
                        }
                    }
                }

                Text {
                    width: 44px;
                    text: root.duration;
                    font-family: Theme.mono;
                    font-size: 10px;
                    letter-spacing: Theme.number-spacing;
                    color: Theme.ink-mute;
                    vertical-alignment: center;
                }
            }
        }

        // Level. Fixed width to match the left block, so the middle is centred
        // on the window rather than on what is left over.
        HorizontalLayout {
            width: 260px;
            alignment: end;
            spacing: Theme.space-3;

            VerticalLayout {
                alignment: center;

                TransportButton {
                    glyph: root.muted
                        ? @image-url("../../../../resources/ui/icons/volume-muted.svg")
                        : @image-url("../../../../resources/ui/icons/volume.svg");
                    active: root.muted;
                    pressed => {
                        root.toggle-mute();
                    }
                }
            }

            VerticalLayout {
                width: 120px;
                alignment: center;

                Scrubber {
                    progress: root.muted ? 0 : root.volume;
                    knob: false;
                    fill: Theme.ink-2;
                    moved(fraction) => {
                        root.set-volume(fraction);
                    }
                }
            }
        }
    }

    // Whatever went wrong, along the bottom edge where it interrupts nothing.
    if root.message != "": Text {
        y: parent.height - self.height - 6px;
        text: root.message;
        font-family: Theme.mono;
        font-size: 10px;
        color: Theme.ink-2;
        horizontal-alignment: center;
        overflow: elide;
    }
}
