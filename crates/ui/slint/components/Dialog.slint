import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Field } from "Field.slint";
import { MenuItemData } from "RowMenu.slint";

// A word set in mono capitals, inside the same outline the rows use.
//
// One button shape for everything that is not the transport: a hairline
// rectangle with a label in it, brightening under the pointer. The row's QUEUE
// control was already this shape; making the dialogs and the page actions the
// same means the interface has two kinds of button — a circle for the thing
// that makes sound, and this for everything else — instead of four.
export component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> destructive;
    in property <image> glyph;

    callback pressed();

    property <color> tone: root.destructive
        ? Theme.danger
        : (root.primary ? Theme.ink-0 : Theme.ink-2);

    // Whole pixels: a button whose width is fractional is placed by its layout
    // at a fractional x, and every letter of its label is then rasterised from
    // half a pixel out.
    width: round((content.preferred-width + 2 * Theme.space-4) / 1px) * 1px;
    height: 34px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover
        ? (root.destructive ? Theme.danger.with-alpha(0.5) : Theme.line)
        : Theme.line-soft;
    // Three states, not two. A control that looks the same held down as it
    // does under the pointer gives nothing back at the moment of the press,
    // which is the moment somebody is asking whether it worked.
    background: touch.pressed
        ? (root.destructive ? Theme.danger.with-alpha(0.22) : Theme.bg-3)
        : (touch.has-hover
            ? (root.destructive ? Theme.danger.with-alpha(0.12) : Theme.bg-2)
            : transparent);
    animate background, border-color { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pressed();
        }
    }

    // Packed from the left rather than centred. Centring divides whatever is
    // left over after the label, and a label's natural width is fractional —
    // so the words landed on half a pixel however even the button itself was.
    // Started at a fixed padding, they land on 16.
    content := HorizontalLayout {
        alignment: start;
        spacing: 8px;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;

        if root.glyph.width > 0: VerticalLayout {
            alignment: center;

            Image {
                source: root.glyph;
                width: 14px;
                height: self.width;
                colorize: touch.has-hover ? root.tone : root.tone.with-alpha(0.8);
                animate colorize { duration: 120ms; }
            }
        }

        VerticalLayout {
            alignment: center;

            Text {
                // An even height, so centring it in an even button is whole
                // arithmetic. Left to ask for its own, a line of type wants
                // something fractional and the letters come out at different
                // heights.
                height: 18px;
                text: root.label;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.label-spacing;
                color: touch.has-hover ? root.tone : root.tone.with-alpha(0.8);
                animate color { duration: 120ms; }
                vertical-alignment: center;
            }
        }
    }
}

// One question, asked over the whole window.
//
// Modal on purpose: every one of these is a decision the next thing depends on
// — what the list is called, whether the track really goes. A panel that can be
// left open while something else is clicked is a panel that has to be told what
// to do when the something else invalidates it.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> placeholder;
    /// Empty means the dialog asks nothing and only confirms.
    in property <bool> asks-for-text;
    in property <string> confirm-label: "SAVE";
    in property <bool> destructive;
    /// What the field starts with. A binding rather than a value pushed in: the
    /// dialog is built fresh every time it opens, and typing replaces it.
    in property <string> initial;

    callback confirmed(string);
    callback cancelled();

    // Fills the window and eats every click that is not on the card, which is
    // what makes it modal without a second window.
    background: Theme.bg-0.with-alpha(0.72);

    backdrop := TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    // Escape closes it. A modal that can only be dismissed by aiming at a
    // particular word is a modal that traps people who reached for the key
    // every other application answers.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    card := Rectangle {
        width: 440px;
        height: layout.preferred-height;
        // Whole pixels. A card centred on a window of odd height lands on
        // half a pixel, every glyph inside it is then snapped to the pixel
        // grid on its own, and the line comes out with its letters at
        // different heights. That is the whole of "the type is jumping".
        x: round((parent.width - self.width) / 1px / 2) * 1px;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius;

        // Clicks on the card are not clicks on the backdrop.
        TouchArea { }

        layout := VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            Text {
                text: root.title;
                font-family: Theme.serif;
                font-size: Theme.text-title;
                color: Theme.ink-0;
                wrap: word-wrap;
            }

            if root.message != "": Text {
                text: root.message;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                color: Theme.ink-2;
                wrap: word-wrap;
            }

            // Always built, and collapsed when the dialog only confirms: an
            // element inside an `if` is out of scope everywhere else, and both
            // the alias above and the confirm button below need to reach it.
            Rectangle {
                height: root.asks-for-text ? 40px : 0px;
                clip: true;

                field := Field {
                    width: 100%;
                    placeholder: root.placeholder;
                    text: root.initial;
                    accepted => {
                        root.confirmed(self.text);
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-2;

                TextButton {
                    label: "CANCEL";
                    pressed => {
                        root.cancelled();
                    }
                }

                TextButton {
                    label: root.confirm-label;
                    primary: true;
                    destructive: root.destructive;
                    pressed => {
                        root.confirmed(field.text);
                    }
                }
            }
        }
    }
}

// A question whose answers are a list rather than a word.
//
// Used for "which playlist?", where a text field would be asking somebody to
// type the name of something the application already knows. The last row makes
// a new one, so an empty library of lists is not a dead end.
export component PickDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <[MenuItemData]> options;
    in property <string> create-label;

    callback picked(string);
    callback create();
    callback cancelled();

    background: Theme.bg-0.with-alpha(0.72);

    TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    // A row of the list, and how many of them the card will show before the
    // rest have to be scrolled to. Six because the card must still hold its
    // title, its buttons and its own padding inside a small window.
    property <length> option-height: 52px;
    property <int> shown-options: 6;

    Rectangle {
        width: 440px;
        // The card is as tall as what it holds. It used to be capped instead,
        // and a seventh playlist pushed the buttons out through the bottom
        // edge — the list scrolls now, so the height cannot run away.
        height: layout.preferred-height;
        // Whole pixels. A card centred on a window of odd height lands on
        // half a pixel, every glyph inside it is then snapped to the pixel
        // grid on its own, and the line comes out with its letters at
        // different heights. That is the whole of "the type is jumping".
        x: round((parent.width - self.width) / 1px / 2) * 1px;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius;

        TouchArea { }

        layout := VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            Text {
                text: root.title;
                font-family: Theme.serif;
                font-size: Theme.text-title;
                color: Theme.ink-0;
                wrap: word-wrap;
            }

            if root.message != "": Text {
                text: root.message;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                color: Theme.ink-2;
                wrap: word-wrap;
            }

            // The options are their own list, with nothing between them: the
            // dialog's own layout puts sixteen pixels between everything it
            // holds, and applied to a list that turns rows into cards floating
            // apart from each other.
            //
            // A list rather than a column, because there is no number of
            // playlists at which this question stops being askable.
            ListView {
                height: min(root.options.length * root.option-height,
                    root.shown-options * root.option-height);

            for option in root.options: Rectangle {
                height: root.option-height;

                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(option.action);
                    }
                }

                // The whole row lights, the way a track row does. An inset
                // highlight has to be spaced against the rule between rows,
                // and there is no spacing that looks even from both sides.
                Rectangle {
                    background: option-touch.has-hover ? Theme.bg-2 : transparent;
                    animate background { duration: 90ms; }
                }

                HorizontalLayout {
                    // Wider than the menu rows are: the list can scroll, and a
                    // scrollbar drawn inside the right edge would otherwise
                    // stand on top of the last digits of a length.
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-4;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: option.label;
                            font-family: Theme.serif;
                            font-size: Theme.text-title;
                            height: 30px;
                            vertical-alignment: center;
                            color: option-touch.has-hover ? Theme.ink-0 : Theme.ink-1;
                            overflow: elide;
                            animate color { duration: 90ms; }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: option.meta;
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                            horizontal-alignment: right;
                        }
                    }
                }

                // A hairline under every row, exactly as a track list draws
                // one: the highlight fills the row, so the rule sits on its
                // edge and has no gap to be uneven in.
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line-soft;
                }
            }
            }

            HorizontalLayout {
                alignment: space-between;
                padding-top: Theme.space-2;

                TextButton {
                    label: root.create-label;
                    primary: true;
                    pressed => {
                        root.create();
                    }
                }

                TextButton {
                    label: "CANCEL";
                    pressed => {
                        root.cancelled();
                    }
                }
            }
        }
    }
}
