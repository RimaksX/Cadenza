import { Theme } from "../theme/tokens.slint";
import { Field } from "Field.slint";
import { MenuItemData } from "RowMenu.slint";

// A word set in mono capitals, inside the same outline the rows use.
//
// One button shape for everything that is not the transport: a hairline
// rectangle with a label in it, brightening under the pointer. The row's QUEUE
// control was already this shape; making the dialogs and the page actions the
// same means the interface has two kinds of button — a circle for the thing
// that makes sound, and this for everything else — instead of four.
export component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> destructive;
    in property <image> glyph;

    callback pressed();

    property <color> tone: root.destructive
        ? Theme.danger
        : (root.primary ? Theme.ink-0 : Theme.ink-2);

    width: content.preferred-width + 2 * Theme.space-4;
    height: 34px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: touch.has-hover
        ? (root.destructive ? Theme.danger.with-alpha(0.5) : Theme.line)
        : Theme.line-soft;
    background: !touch.has-hover
        ? transparent
        : (root.destructive ? Theme.danger.with-alpha(0.12) : Theme.bg-2);
    animate background, border-color { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pressed();
        }
    }

    content := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;

        if root.glyph.width > 0: VerticalLayout {
            alignment: center;

            Image {
                source: root.glyph;
                width: 13px;
                height: self.width;
                colorize: touch.has-hover ? root.tone : root.tone.with-alpha(0.8);
                animate colorize { duration: 120ms; }
            }
        }

        VerticalLayout {
            alignment: center;

            Text {
                text: root.label;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.label-spacing;
                color: touch.has-hover ? root.tone : root.tone.with-alpha(0.8);
                animate color { duration: 120ms; }
            }
        }
    }
}

// One question, asked over the whole window.
//
// Modal on purpose: every one of these is a decision the next thing depends on
// — what the list is called, whether the track really goes. A panel that can be
// left open while something else is clicked is a panel that has to be told what
// to do when the something else invalidates it.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> placeholder;
    /// Empty means the dialog asks nothing and only confirms.
    in property <bool> asks-for-text;
    in property <string> confirm-label: "SAVE";
    in property <bool> destructive;
    /// What the field starts with. A binding rather than a value pushed in: the
    /// dialog is built fresh every time it opens, and typing replaces it.
    in property <string> initial;

    callback confirmed(string);
    callback cancelled();

    // Fills the window and eats every click that is not on the card, which is
    // what makes it modal without a second window.
    background: Theme.bg-0.with-alpha(0.72);

    backdrop := TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    // Escape closes it. A modal that can only be dismissed by aiming at a
    // particular word is a modal that traps people who reached for the key
    // every other application answers.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    card := Rectangle {
        width: 440px;
        height: layout.preferred-height;
        // Whole pixels. A card centred on a window of odd height lands on
        // half a pixel, every glyph inside it is then snapped to the pixel
        // grid on its own, and the line comes out with its letters at
        // different heights. That is the whole of "the type is jumping".
        x: round((parent.width - self.width) / 1px / 2) * 1px;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius;

        // Clicks on the card are not clicks on the backdrop.
        TouchArea { }

        layout := VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            Text {
                text: root.title;
                font-family: Theme.serif;
                font-size: 24px;
                color: Theme.ink-0;
                wrap: word-wrap;
            }

            if root.message != "": Text {
                text: root.message;
                font-family: Theme.sans;
                font-size: Theme.text-meta;
                color: Theme.ink-2;
                wrap: word-wrap;
            }

            // Always built, and collapsed when the dialog only confirms: an
            // element inside an `if` is out of scope everywhere else, and both
            // the alias above and the confirm button below need to reach it.
            Rectangle {
                height: root.asks-for-text ? 40px : 0px;
                clip: true;

                field := Field {
                    width: 100%;
                    placeholder: root.placeholder;
                    text: root.initial;
                    accepted => {
                        root.confirmed(self.text);
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-2;

                TextButton {
                    label: "CANCEL";
                    pressed => {
                        root.cancelled();
                    }
                }

                TextButton {
                    label: root.confirm-label;
                    primary: true;
                    destructive: root.destructive;
                    pressed => {
                        root.confirmed(field.text);
                    }
                }
            }
        }
    }
}

// A question whose answers are a list rather than a word.
//
// Used for "which playlist?", where a text field would be asking somebody to
// type the name of something the application already knows. The last row makes
// a new one, so an empty library of lists is not a dead end.
export component PickDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <[MenuItemData]> options;
    in property <string> create-label;

    callback picked(string);
    callback create();
    callback cancelled();

    background: Theme.bg-0.with-alpha(0.72);

    TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        width: 440px;
        height: min(520px, layout.preferred-height);
        // Whole pixels. A card centred on a window of odd height lands on
        // half a pixel, every glyph inside it is then snapped to the pixel
        // grid on its own, and the line comes out with its letters at
        // different heights. That is the whole of "the type is jumping".
        x: round((parent.width - self.width) / 1px / 2) * 1px;
        y: round((parent.height - self.height) / 1px / 2) * 1px;
        background: Theme.bg-1;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius;

        TouchArea { }

        layout := VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            Text {
                text: root.title;
                font-family: Theme.serif;
                font-size: 24px;
                color: Theme.ink-0;
                wrap: word-wrap;
            }

            if root.message != "": Text {
                text: root.message;
                font-family: Theme.sans;
                font-size: Theme.text-meta;
                color: Theme.ink-2;
                wrap: word-wrap;
            }

            // The options, each a row that answers the question by being
            // pressed. No confirm button: choosing is the answer.
            //
            // Divided by hairlines like every other list in Cadenza, and the
            // last one carries none — a rule under the final row would be the
            // bottom of a table that is not there.
            for option[index] in root.options: Rectangle {
                height: 52px;

                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(option.action);
                    }
                }

                Rectangle {
                    y: 4px;
                    height: parent.height - 8px;
                    border-radius: Theme.radius;
                    background: option-touch.has-hover ? Theme.bg-3 : transparent;
                    animate background { duration: 90ms; }
                }

                HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-4;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: option.label;
                            font-family: Theme.serif;
                            font-size: 19px;
                            color: option-touch.has-hover ? Theme.ink-0 : Theme.ink-1;
                            overflow: elide;
                            animate color { duration: 90ms; }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: option.meta;
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                            horizontal-alignment: right;
                        }
                    }
                }

                // On the row's top edge rather than its bottom, and on every
                // row but the first. The highlight is inset by four, so a rule
                // at the bottom of a row sits one pixel under one highlight and
                // seven above the next — which is what "it is squashed against
                // the top one and floating above the bottom one" was. On the
                // boundary it is four from each.
                if index > 0: Rectangle {
                    y: 0;
                    x: Theme.space-3;
                    width: parent.width - 2 * Theme.space-3;
                    height: 1px;
                    background: Theme.line-soft;
                }
            }

            HorizontalLayout {
                alignment: space-between;
                padding-top: Theme.space-2;

                TextButton {
                    label: root.create-label;
                    primary: true;
                    pressed => {
                        root.create();
                    }
                }

                TextButton {
                    label: "CANCEL";
                    pressed => {
                        root.cancelled();
                    }
                }
            }
        }
    }
}
