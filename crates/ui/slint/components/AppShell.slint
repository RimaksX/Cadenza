import { Theme } from "../theme/tokens.slint";
import { Sidebar } from "Sidebar.slint";
import { PlayerBar } from "PlayerBar.slint";
import { TitleBar } from "TitleBar.slint";
import { TrackRowData } from "TrackRow.slint";
import { LibraryView } from "../views/LibraryView.slint";
import { QueueView } from "../views/QueueView.slint";
import { PlaylistsView, PlaylistCardData } from "../views/PlaylistsView.slint";
import { PlaylistDetailView } from "../views/PlaylistDetailView.slint";
import { EqualiserView, EqPresetData, EqBandData, ToneBand } from "../views/EqualiserView.slint";
import { SettingsView, FolderRowData, ProfileRowData, TakenOutRowData } from "../views/SettingsView.slint";
import { RadioView, MoodRowData } from "../views/RadioView.slint";
import { ListeningView, TopTrackData } from "../views/ListeningView.slint";
import { ReviewsView, ReviewRowData, ReviewChoice } from "../views/ReviewsView.slint";
import { WelcomeView } from "../views/WelcomeView.slint";
import { Dialog, PickDialog, EditTrackDialog } from "Dialog.slint";
import { MenuItemData } from "RowMenu.slint";

// The frame every screen lives in: navigation down the left, the player across
// the bottom, one content area between them.
//
// A fixed arrangement, and it is required — the listener does
// not rearrange it. The content area is a switch over four screens: the
// library, the queue, the index of playlists and one playlist's own page.
export component AppShell inherits Rectangle {
    in property <[TrackRowData]> tracks;
    in property <string> library-summary;
    in-out property <string> link;
    in property <bool> offers-a-track;
    in property <bool> offers-a-list;
    in property <bool> fetching;
    in property <int> fetch-percent;
    in property <string> fetch-note;
    in property <bool> fetch-needs-folder;
    in property <string> fetch-offer;
    in property <string> empty-hint;
    in property <[TrackRowData]> queue-tracks;
    in property <string> queue-summary;
    in property <string> queue-hint;
    in property <[PlaylistCardData]> playlists;
    in property <PlaylistCardData> favourites;
    in property <bool> has-favourites;
    in property <string> playlists-summary;
    in property <string> playlists-hint;
    in property <[TrackRowData]> playlist-tracks;
    in property <string> playlist-name;
    in property <string> playlist-summary;
    in property <string> playlist-hint;
    /// Which playlist's page is open, so its head can start it.
    in property <string> open-playlist-id;
    /// The playlists as a menu of destinations, for "add to playlist".
    in property <[MenuItemData]> playlist-options;

    in property <bool> dark;
    in property <bool> crossfade-on;
    in property <int> crossfade-seconds;
    in property <int> ui-scale;
    in property <bool> history-on;
    in property <[FolderRowData]> folders;
    /// True while nobody has been created yet, which is the one state where
    /// none of the rest of this shell means anything.
    in property <bool> first-run;
    /// What the library is ordered by, and what it may be ordered by.
    in-out property <string> query;
    in-out property <int> reach-for-search;
    in property <int> playing-row;
    in-out property <int> reach-for-playing;
    in property <string> order-label;
    in property <[MenuItemData]> orders;
    in property <[TakenOutRowData]> taken-out;
    in property <int> gone-for-good;
    in property <int> outside-folders;
    in property <[ProfileRowData]> profiles;

    // The track being corrected, as it is called now.
    in property <string> editing-id;
    in property <string> editing-title;
    in property <string> editing-artist;
    in property <string> editing-album;
    in property <string> suggested-folder;
    in property <string> settings-summary;

    // Radio.
    in property <[MoodRowData]> moods;

    // Listening.
    in property <[TopTrackData]> top-tracks;
    in property <[ReviewRowData]> reviews;
    in property <string> reviews-summary;
    in property <string> listening-summary;
    in property <string> listening-heard;
    in property <string> listening-listens;
    in property <string> listening-tracks;
    in property <string> listening-skip-rate;
    in property <bool> listening-kept;
    in property <string> radio-mood;
    in property <string> radio-summary;
    in property <bool> eq-advanced;
    in property <float> eq-bass;
    in property <float> eq-mid;
    in property <float> eq-treble;
    in property <[EqBandData]> eq-bands;
    in property <[EqPresetData]> eq-presets;
    in property <string> eq-summary;
    in property <int> eq-selected;
    in property <string> eq-selected-frequency;
    in property <string> eq-selected-q;
    in property <string> eq-selected-gain;

    /// The screen showing. Held here rather than passed in, because navigation
    /// changes nothing outside the window.
    // In-out, so the window can move somebody to a page: pressing what is
    // playing takes you to the library whichever page you were on.
    in-out property <string> section: "library";

    /// Which question is open, if any: "" while none is. The shell owns this
    /// because a modal covers the whole window, and because what it asks about
    /// is a decision the interface makes before the application hears anything.
    property <string> dialog;
    /// What the answer will be applied to.
    property <string> dialog-target;
    /// What the field starts with, and what the question names.
    property <string> dialog-value;
    in property <string> profile-name;
    in property <image> profile-avatar;
    in property <string> profile-initial;

    in property <string> now-title;
    in property <string> now-subtitle;
    in property <string> now-initial;
    in property <image> now-cover;
    in property <string> now-position;
    in property <string> now-duration;
    in property <string> playing-id;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume;
    in property <string> message;
    in property <bool> maximized;
    in property <bool> shuffle;
    in property <bool> repeating;
    in property <bool> repeat-one;
    in property <bool> now-favourite;
    in property <bool> has-next;
    in property <bool> has-previous;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-window(length, length);
    callback play(string);
    callback enqueue(string);
    callback play-queued(int);
    callback remove-from-queue(int);
    callback open-playlist(string);
    callback play-playlist(string);
    callback create-playlist(string);
    callback rename-playlist(string, string);
    callback delete-playlist(string);
    callback toggle-favourite();
    callback add-to-playlist(string, string);
    callback create-playlist-with(string, string);
    callback remove-from-playlist(int);
    callback remove-from-library(string);
    /// Ask for a picture and put it on this track, or take one off again.
    callback choose-cover(string);
    callback clear-cover(string);
    /// The same two, for a list.
    callback choose-playlist-cover(string);
    callback clear-playlist-cover(string);
    callback clear-queue();
    callback search(string);
    callback fetch(string);
    callback fetch-playlist(string);
    callback stop-fetch();
    callback fix-fetch();
    callback make-local-folder();
    callback play-from-playlist(string);
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-eq-mode(bool);
    callback set-eq-simple(ToneBand, float);
    callback move-eq-band(int, float);
    callback tune-eq-band(int, int);
    callback select-eq-band(int);
    callback settle-eq();
    /// The listener moved to a screen, which is that screen's cue to re-read
    /// what it shows.
    callback showing(string);
    /// Asks the interface to open the editor for a track. What it is called now
    /// comes back through the properties below, because only the application
    /// knows.
    callback decide-review(string, ReviewChoice);
    callback edit-track(string);
    callback save-track(string, string, string, string);
    callback switch-profile(string);
    callback choose-avatar(string);
    callback clear-avatar(string);
    callback delete-profile(string);
    callback create-profile(string);
    callback start-radio(string);
    callback judge-radio(bool);
    callback set-theme(bool);
    callback set-crossfade(bool, int);
    callback set-ui-scale(int);
    callback set-history(bool);
    callback add-folder();
    callback use-suggested-folder();
    callback remove-folder(string);
    callback synchronise-folder(string);
    callback restore-track(string);
    callback set-order(string);
    /// A name, and whether to make the folder that was offered with it.
    callback start-here(string, bool);
    callback forget-gone();
    callback scan-now();
    callback widen-eq-band(int, float);
    callback pick-eq-preset(string);
    callback save-eq-preset(string);
    callback rename-eq-preset(string, string);
    callback delete-eq-preset(string);
    callback reset-eq();

    background: Theme.bg-0;
    // The window has no frame of its own now, so it needs an edge of its own —
    // otherwise it dissolves into a dark desktop.
    border-width: 1px;
    border-color: Theme.line-soft;

    VerticalLayout {
        // The window's own frame is the first row of the shell rather than a
        // wrapper around it: the title bar, the navigation and the player are
        // three parts of one arrangement, which is what a fixed layout
        // means.
        TitleBar {
            maximized: root.maximized;
            minimize => {
                root.minimize();
            }
            toggle-maximize => {
                root.toggle-maximize();
            }
            close-window => {
                root.close-window();
            }
            drag(dx, dy) => {
                root.drag-window(dx, dy);
            }
        }

        // Everything below the title bar, and only once there is somebody for
        // it to belong to. Before that there is one screen and it asks for
        // exactly what is missing.
        if root.first-run: WelcomeView {
            suggested: root.suggested-folder;
            begin(name, folder) => {
                root.start-here(name, folder);
            }
        }

        if !root.first-run: HorizontalLayout {
            Sidebar {
                pending-reviews: root.reviews.length;
                profile-name: root.profile-name;
                profile-avatar: root.profile-avatar;
                profile-initial: root.profile-initial;
                section: root.section;
                select(name) => {
                    root.section = name;
                    root.showing(name);
                }
            }

            // Which screen is showing is the interface's own state, and moving
            // between them changes nothing outside the window. What it does
            // change is whether what a screen last drew is still true: a page
            // built from a service reads that service when it was last asked
            // to, not when it is looked at. So the move is announced, and the
            // screen being opened re-reads what it draws.
            if root.section == "library": LibraryView {
                searchable: true;
                query <=> root.query;
                reach-for-search: root.reach-for-search;
                playing-row: root.playing-row;
                reach-for-playing: root.reach-for-playing;
                sortable: true;
                order-label: root.order-label;
                orders: root.orders;
                set-order(order) => {
                    root.set-order(order);
                }
                fetchable: true;
                link <=> root.link;
                offers-a-track: root.offers-a-track;
                offers-a-list: root.offers-a-list;
                fetching: root.fetching;
                fetch-percent: root.fetch-percent;
                fetch-note: root.fetch-note;
                fetch-needs-folder: root.fetch-needs-folder;
                fetch-offer: root.fetch-offer;
                fetch-playlist(address) => {
                    root.fetch-playlist(address);
                }
                fix-fetch() => {
                    root.fix-fetch();
                }
                stop-fetch() => {
                    root.stop-fetch();
                }
                fetch(address) => {
                    root.fetch(address);
                }
                make-local-folder => {
                    root.make-local-folder();
                }
                tracks: root.tracks;
                summary: root.library-summary;
                playing-id: root.playing-id;
                empty-hint: root.empty-hint;
                play(id) => {
                    root.play(id);
                }
                enqueue(id) => {
                    root.enqueue(id);
                }
                act(index, id, action) => {
                    root.row-acted(index, id, action);
                }
                searched(text) => {
                    root.search(text);
                }
            }

            if root.section == "queue": QueueView {
                action-label: root.queue-tracks.length > 0 ? "CLEAR QUEUE" : "";
                action-destructive: true;
                tracks: root.queue-tracks;
                summary: root.queue-summary;
                playing-id: root.playing-id;
                empty-hint: root.queue-hint;
                play-at(index) => {
                    root.play-queued(index);
                }
                remove(index) => {
                    root.remove-from-queue(index);
                }
                act(index, id, action) => {
                    root.row-acted(index, id, action);
                }
                act-on-page => {
                    root.clear-queue();
                }
            }

            if root.section == "playlists": PlaylistsView {
                playlists: root.playlists;
                favourites: root.favourites;
                has-favourites: root.has-favourites;
                summary: root.playlists-summary;
                empty-hint: root.playlists-hint;
                open(id) => {
                    // Two things happen: the shell changes page, and the
                    // application loads what the page shows. Neither can do the
                    // other's half.
                    root.section = "playlist";
                    root.open-playlist(id);
                }
                play(id) => {
                    root.play-playlist(id);
                }
                create => {
                    root.ask("new-playlist", "", "");
                }
                act(id, name, action) => {
                    if (action == "cover") {
                        root.choose-playlist-cover(id);
                    } else if (action == "uncover") {
                        root.clear-playlist-cover(id);
                    } else {
                        root.ask(action == "rename" ? "rename-playlist" : "delete-playlist", id, name);
                    }
                }
            }

            if root.section == "reviews": ReviewsView {
                reviews: root.reviews;
                summary: root.reviews-summary;
                decide(id, choice) => {
                    root.decide-review(id, choice);
                }
            }

            if root.section == "listening": ListeningView {
                top: root.top-tracks;
                summary: root.listening-summary;
                heard: root.listening-heard;
                listens: root.listening-listens;
                tracks: root.listening-tracks;
                skip-rate: root.listening-skip-rate;
                keeping: root.listening-kept;
            }

            if root.section == "radio": RadioView {
                moods: root.moods;
                playing-mood: root.radio-mood;
                summary: root.radio-summary;
                now-title: root.now-title;

                listen(id) => {
                    root.start-radio(id);
                }
                judge(like) => {
                    root.judge-radio(like);
                }
            }

            if root.section == "settings": SettingsView {
                act-on-profile(id, name, action) => {
                    if (action == "avatar") {
                        root.choose-avatar(id);
                    } else if (action == "unavatar") {
                        root.clear-avatar(id);
                    } else {
                        root.ask("delete-profile", id, name);
                    }
                }
                profiles: root.profiles;
                switch-profile(id) => {
                    root.switch-profile(id);
                }
                new-profile => {
                    root.ask("new-profile", "", "");
                }
                dark: root.dark;
                crossfade-on: root.crossfade-on;
                crossfade-seconds: root.crossfade-seconds;
                ui-scale: root.ui-scale;
                history-on: root.history-on;
                folders: root.folders;
                taken-out: root.taken-out;
                gone-for-good: root.gone-for-good;
                outside-folders: root.outside-folders;
                suggested: root.suggested-folder;
                summary: root.settings-summary;

                set-theme(dark) => {
                    root.set-theme(dark);
                }
                set-crossfade(on, seconds) => {
                    root.set-crossfade(on, seconds);
                }
                set-ui-scale(percent) => {
                    root.set-ui-scale(percent);
                }
                set-history(on) => {
                    root.set-history(on);
                }
                add-folder => {
                    root.add-folder();
                }
                use-suggested => {
                    root.use-suggested-folder();
                }
                remove-folder(id) => {
                    root.remove-folder(id);
                }
                synchronise-folder(id) => {
                    root.synchronise-folder(id);
                }
                restore-track(id) => {
                    root.restore-track(id);
                }
                forget-gone => {
                    root.forget-gone();
                }
                scan-now => {
                    root.scan-now();
                }
            }

            if root.section == "equaliser": EqualiserView {
                advanced: root.eq-advanced;
                bass: root.eq-bass;
                mid: root.eq-mid;
                treble: root.eq-treble;
                bands: root.eq-bands;
                presets: root.eq-presets;
                summary: root.eq-summary;
                selected: root.eq-selected;
                selected-frequency: root.eq-selected-frequency;
                selected-q: root.eq-selected-q;
                selected-gain: root.eq-selected-gain;

                set-mode(advanced) => {
                    root.set-eq-mode(advanced);
                }
                set-simple(which, value) => {
                    root.set-eq-simple(which, value);
                }
                move-band(index, y) => {
                    root.move-eq-band(index, y);
                }
                tune-band(index, direction) => {
                    root.tune-eq-band(index, direction);
                }
                select-band(index) => {
                    root.select-eq-band(index);
                }
                settle-eq => {
                    root.settle-eq();
                }
                widen-band(index, step) => {
                    root.widen-eq-band(index, step);
                }
                pick-preset(id) => {
                    root.pick-eq-preset(id);
                }
                save-preset => {
                    root.ask("new-eq-preset", "", "");
                }
                explain => {
                    root.ask("eq-help", "", "");
                }
                act-on-preset(id, name, action) => {
                    root.ask(action == "rename" ? "rename-eq-preset" : "delete-eq-preset", id, name);
                }
                reset-eq => {
                    root.reset-eq();
                }
            }

            if root.section == "playlist": PlaylistDetailView {
                in-playlist: true;
                action-label: root.playlist-tracks.length > 0 ? "PLAY" : "";
                tracks: root.playlist-tracks;
                heading: root.playlist-name;
                summary: root.playlist-summary;
                playing-id: root.playing-id;
                empty-hint: root.playlist-hint;
                play(id) => {
                    root.play-from-playlist(id);
                }
                enqueue(id) => {
                    root.enqueue(id);
                }
                act(index, id, action) => {
                    root.row-acted(index, id, action);
                }
                act-on-page => {
                    root.play-playlist(root.open-playlist-id);
                }
                back => {
                    root.section = "playlists";
                }
            }
        }

        // Whatever went wrong, in a line of its own. It used to be drawn along
        // the bottom edge of the bar itself, on the grounds that the edge
        // interrupted nothing — but the bar is three blocks with no spare band,
        // and the line lay across the progress bar. A message stays until the
        // next command succeeds, so it cannot be allowed to sit on a control.
        if root.message != "": Rectangle {
            height: Theme.px(30);
            background: Theme.bg-1;

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line-soft;
            }

            Text {
                x: Theme.space-5;
                width: parent.width - 2 * Theme.space-5;
                y: round((parent.height - self.height) / 1px / 2) * 1px;
                height: Theme.px(18);
                text: root.message;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-2;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if !root.first-run: PlayerBar {
            show-playing => {
                root.section = "library";
                root.showing("library");
                root.reach-for-playing += 1;
            }
            title: root.now-title;
            subtitle: root.now-subtitle;
            initial: root.now-initial;
            cover: root.now-cover;
            position: root.now-position;
            duration: root.now-duration;
            progress: root.progress;
            playing: root.playing;
            loaded: root.loaded;
            muted: root.muted;
            volume: root.volume;
            shuffle: root.shuffle;
            repeating: root.repeating;
            repeat-one: root.repeat-one;
            has-next: root.has-next;
            has-previous: root.has-previous;
            favourite: root.now-favourite;

            toggle-favourite => {
                root.toggle-favourite();
            }
            toggle-play => {
                root.toggle-play();
            }
            seek(fraction) => {
                root.seek(fraction);
            }
            set-volume(level) => {
                root.set-volume(level);
            }
            toggle-mute => {
                root.toggle-mute();
            }
            next => {
                root.next();
            }
            previous => {
                root.previous();
            }
            toggle-shuffle => {
                root.toggle-shuffle();
            }
            cycle-repeat => {
                root.cycle-repeat();
            }
        }
    }

    // Over everything, and outside the column layout so that it covers the
    // player bar too: a question that can be answered while the music is
    // being scrubbed is a question about a state that may no longer hold.
    if root.dialog != "" && root.dialog != "pick-playlist": Dialog {
        width: 100%;
        height: 100%;

        // Wide enough for a paragraph, because one of these is a paragraph.
        informs: root.dialog == "eq-help";

        title: root.dialog == "eq-help"
            ? "Using the equaliser"
            : (root.dialog == "rename-eq-preset"
            ? "Rename this sound"
            : (root.dialog == "delete-eq-preset"
            ? "Delete this sound"
            : (root.dialog == "new-eq-preset"
            ? "Save this sound"
            : (root.dialog == "new-profile"
                ? "New listener"
            : (root.dialog == "new-playlist" || root.dialog == "new-playlist-with"
                ? "New playlist"
                : (root.dialog == "rename-playlist"
                    ? "Rename playlist"
                    : (root.dialog == "remove-track"
                        ? "Remove from library"
                        : (root.dialog == "delete-profile"
                            ? "Delete this listener"
                            : "Delete playlist"))))))));
        message: root.dialog == "eq-help"
            ? "A sound belongs to the track you set it on. Choose a preset while something is playing and that track keeps it; the next track starts at Standard. RESET takes the sound away and the memory of it with it." + "\n\n" + "The three controls change the whole sound at once: bass, middle and treble. Nothing to choose, nothing to aim at." + "\n\n" + "The eight bands each change one part of it, and every band is three numbers." + "\n\n" + "GAIN is the fader itself - how far that band lifts or cuts. It is the only one of the three you hear on its own." + "\n\n" + "FREQUENCY is where the band sits. LOWER and HIGHER move it a sixth of an octave at a time." + "\n\n" + "WIDTH is how much of the sound around it comes along. WIDER and NARROWER." + "\n\n" + "Choose a band with the dot under its fader, then change it. A band at 0 dB does nothing wherever you put it, so move its fader first - otherwise LOWER and HIGHER are moving a filter that is not doing anything, and you will hear no difference at all." + "\n\n" + "A preset stays lit while the sound is exactly that preset. Move anything and it goes out, which is the screen telling the truth rather than losing your work: everything you set is still there and still playing."
            : (root.dialog == "delete-eq-preset"
            ? "That sound goes. What is playing keeps whatever it is set to now."
            : (root.dialog == "delete-playlist"
            ? "\"" + root.dialog-value + "\" goes; the tracks in it stay in your library."
            : (root.dialog == "remove-track"
                ? "The track leaves this profile's library. The file stays on disk, and other profiles keep theirs."
                : (root.dialog == "new-profile"
                    ? "A listener of their own: their own library, playlists, queue and history. Nothing of yours moves."
                    : (root.dialog == "delete-profile"
                        // Says what goes and what stays, in that order and by
                        // name. A listener deleting themselves is entitled to
                        // know that their music is not being deleted with them.
                        ? "\"" + root.dialog-value + "\" goes, with their library listing, playlists, queue, history, presets and picture." + "\n\n" + "The music files stay exactly where they are on disk, and every other listener keeps theirs."
                        : "")))));
        placeholder: root.dialog == "new-eq-preset" ? "Late night listening" : "Late night";
        asks-for-text: root.dialog == "new-profile"
            || root.dialog == "new-playlist"
            || root.dialog == "new-playlist-with"
            || root.dialog == "rename-playlist"
            || root.dialog == "new-eq-preset"
            || root.dialog == "rename-eq-preset";
        initial: root.dialog == "rename-playlist" || root.dialog == "rename-eq-preset"
            ? root.dialog-value
            : "";
        confirm-label: root.dialog == "eq-help"
            ? "GOT IT"
            : (root.dialog == "rename-eq-preset"
            ? "RENAME"
            : (root.dialog == "delete-eq-preset"
            ? "DELETE"
            : (root.dialog == "new-eq-preset"
            ? "SAVE"
            : (root.dialog == "new-profile"
                ? "CREATE"
            : (root.dialog == "new-playlist" || root.dialog == "new-playlist-with"
                ? "CREATE"
                : (root.dialog == "rename-playlist"
                    ? "RENAME"
                    : (root.dialog == "remove-track"
                        ? "REMOVE"
                        : (root.dialog == "delete-profile" ? "DELETE" : "DELETE"))))))));
        destructive: root.dialog == "delete-playlist"
            || root.dialog == "remove-track"
            || root.dialog == "delete-eq-preset"
            || root.dialog == "delete-profile";

        confirmed(value) => {
            if (root.dialog == "eq-help") {
                // Nothing to do: it was read.
            } else if (root.dialog == "new-eq-preset") {
                root.save-eq-preset(value);
            } else if (root.dialog == "rename-eq-preset") {
                root.rename-eq-preset(root.dialog-target, value);
            } else if (root.dialog == "delete-eq-preset") {
                root.delete-eq-preset(root.dialog-target);
            } else if (root.dialog == "new-profile") {
                root.create-profile(value);
            } else if (root.dialog == "delete-profile") {
                root.delete-profile(root.dialog-target);
            } else if (root.dialog == "new-playlist") {
                root.create-playlist(value);
            } else if (root.dialog == "new-playlist-with") {
                root.create-playlist-with(root.dialog-target, value);
            } else if (root.dialog == "rename-playlist") {
                root.rename-playlist(root.dialog-target, value);
            } else if (root.dialog == "remove-track") {
                root.remove-from-library(root.dialog-target);
            } else {
                root.delete-playlist(root.dialog-target);
            }
            root.dialog = "";
        }
        cancelled => {
            root.dialog = "";
        }
    }

    // Correcting a track is three questions at once, so it has a card of its
    // own rather than a flag on the general one. Opened by an identifier rather
    // than by the `dialog` string every other card uses: what is being edited
    // is the answer to "which track", and a second property to hold that would
    // be the same thing said twice.
    if root.editing-id != "": EditTrackDialog {
        title-value: root.editing-title;
        artist-value: root.editing-artist;
        album-value: root.editing-album;

        confirmed(title, artist, album) => {
            root.save-track(root.editing-id, title, artist, album);
        }
        cancelled => {
            root.edit-track("");
        }
    }

    // "Which playlist?" is a question with a list of answers rather than a word
    // to type: the application already knows the names, and asking somebody to
    // spell one is asking them to do its work.
    if root.dialog == "pick-playlist": PickDialog {
        width: 100%;
        height: 100%;
        title: "Add to playlist";
        message: root.playlist-options.length == 0
            ? "There are no lists yet. Making one puts this track in it."
            : "";
        options: root.playlist-options;
        create-label: "NEW PLAYLIST";

        picked(playlist) => {
            root.add-to-playlist(root.dialog-target, playlist);
            root.dialog = "";
        }
        // The track waits in `dialog-target` while the name is asked for, so
        // that making a list and putting something in it is one act.
        create => {
            root.dialog = "new-playlist-with";
        }
        cancelled => {
            root.dialog = "";
        }
    }

    /// Opens a question. One place, so that every one of them is opened the
    /// same way and closed the same way.
    function ask(kind: string, target: string, value: string) {
        root.dialog-target = target;
        root.dialog-value = value;
        root.dialog = kind;
    }

    /// What a row asked for. The shell decides whether that is a question or a
    /// command; the row only knows what was pressed.
    function row-acted(index: int, id: string, action: string) {
        if (action == "edit") {
            root.edit-track(id);
        } else if (action == "add-to-playlist") {
            root.ask("pick-playlist", id, "");
        } else if (action == "remove-from-playlist") {
            root.remove-from-playlist(index);
        } else if (action == "cover") {
            root.choose-cover(id);
        } else if (action == "uncover") {
            root.clear-cover(id);
        } else if (action == "remove-from-library") {
            root.ask("remove-track", id, "");
        }
    }
}

