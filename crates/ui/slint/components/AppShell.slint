import { Theme } from "../theme/tokens.slint";
import { Sidebar } from "Sidebar.slint";
import { PlayerBar } from "PlayerBar.slint";
import { TitleBar } from "TitleBar.slint";
import { TrackRowData } from "TrackRow.slint";
import { LibraryView } from "../views/LibraryView.slint";
import { QueueView } from "../views/QueueView.slint";
import { PlaylistsView, PlaylistCardData } from "../views/PlaylistsView.slint";
import { PlaylistDetailView } from "../views/PlaylistDetailView.slint";

// The frame every screen lives in: navigation down the left, the player across
// the bottom, one content area between them.
//
// A fixed arrangement, which PROJECT_MASTER 2.10 requires — the listener does
// not rearrange it. The content area is a single view today; it becomes a
// switch when there is a second screen to switch to in M7.
export component AppShell inherits Rectangle {
    in property <[TrackRowData]> tracks;
    in property <string> library-summary;
    in property <string> empty-hint;
    in property <[TrackRowData]> queue-tracks;
    in property <string> queue-summary;
    in property <string> queue-hint;
    in property <[PlaylistCardData]> playlists;
    in property <string> playlists-summary;
    in property <string> playlists-hint;
    in property <[TrackRowData]> playlist-tracks;
    in property <string> playlist-name;
    in property <string> playlist-summary;
    in property <string> playlist-hint;

    /// The screen showing. Held here rather than passed in, because navigation
    /// changes nothing outside the window.
    property <string> section: "library";
    in property <string> profile-name;
    in property <string> profile-initial;

    in property <string> now-title;
    in property <string> now-subtitle;
    in property <string> now-initial;
    in property <string> now-position;
    in property <string> now-duration;
    in property <string> playing-id;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume;
    in property <string> message;
    in property <bool> maximized;
    in property <bool> shuffle;
    in property <bool> repeating;
    in property <bool> repeat-one;
    in property <bool> has-next;
    in property <bool> has-previous;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-window(length, length);
    callback play(string);
    callback enqueue(string);
    callback open-playlist(string);
    callback play-from-playlist(string);
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();

    background: Theme.bg-0;
    // The window has no frame of its own now, so it needs an edge of its own —
    // otherwise it dissolves into a dark desktop.
    border-width: 1px;
    border-color: Theme.line-soft;

    VerticalLayout {
        // The window's own frame is the first row of the shell rather than a
        // wrapper around it: the title bar, the navigation and the player are
        // three parts of one arrangement, which is what the fixed layout of
        // PROJECT_MASTER 2.10 means.
        TitleBar {
            maximized: root.maximized;
            minimize => {
                root.minimize();
            }
            toggle-maximize => {
                root.toggle-maximize();
            }
            close-window => {
                root.close-window();
            }
            drag(dx, dy) => {
                root.drag-window(dx, dy);
            }
        }

        HorizontalLayout {
            Sidebar {
                profile-name: root.profile-name;
                profile-initial: root.profile-initial;
                section: root.section;
                select(name) => {
                    root.section = name;
                }
            }

            // Which screen is showing is the interface's own state: nothing
            // outside the window changes when the listener looks at the queue,
            // so nothing outside the window needs to be told.
            if root.section == "library": LibraryView {
                tracks: root.tracks;
                summary: root.library-summary;
                playing-id: root.playing-id;
                empty-hint: root.empty-hint;
                play(id) => {
                    root.play(id);
                }
                enqueue(id) => {
                    root.enqueue(id);
                }
            }

            if root.section == "queue": QueueView {
                tracks: root.queue-tracks;
                summary: root.queue-summary;
                playing-id: root.playing-id;
                empty-hint: root.queue-hint;
                play(id) => {
                    root.play(id);
                }
                enqueue(id) => {
                    root.enqueue(id);
                }
            }

            if root.section == "playlists": PlaylistsView {
                playlists: root.playlists;
                summary: root.playlists-summary;
                empty-hint: root.playlists-hint;
                open(id) => {
                    // Two things happen: the shell changes page, and the
                    // application loads what the page shows. Neither can do the
                    // other's half.
                    root.section = "playlist";
                    root.open-playlist(id);
                }
            }

            if root.section == "playlist": PlaylistDetailView {
                tracks: root.playlist-tracks;
                heading: root.playlist-name;
                summary: root.playlist-summary;
                playing-id: root.playing-id;
                empty-hint: root.playlist-hint;
                play(id) => {
                    root.play-from-playlist(id);
                }
                enqueue(id) => {
                    root.enqueue(id);
                }
                back => {
                    root.section = "playlists";
                }
            }
        }

        PlayerBar {
            title: root.now-title;
            subtitle: root.now-subtitle;
            initial: root.now-initial;
            position: root.now-position;
            duration: root.now-duration;
            progress: root.progress;
            playing: root.playing;
            loaded: root.loaded;
            muted: root.muted;
            volume: root.volume;
            message: root.message;
            shuffle: root.shuffle;
            repeating: root.repeating;
            repeat-one: root.repeat-one;
            has-next: root.has-next;
            has-previous: root.has-previous;

            toggle-play => {
                root.toggle-play();
            }
            seek(fraction) => {
                root.seek(fraction);
            }
            set-volume(level) => {
                root.set-volume(level);
            }
            toggle-mute => {
                root.toggle-mute();
            }
            next => {
                root.next();
            }
            previous => {
                root.previous();
            }
            toggle-shuffle => {
                root.toggle-shuffle();
            }
            cycle-repeat => {
                root.cycle-repeat();
            }
        }
    }
}

