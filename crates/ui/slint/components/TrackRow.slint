import { Theme } from "../theme/tokens.slint";
import { RowMenu, MenuItemData } from "RowMenu.slint";

// One row of a listing, as the view model hands it over.
//
// Every field is already a string: formatting a duration, choosing a fallback
// for a missing artist, taking the first letter of a title — all presentation,
// and presentation that happens in Rust can be tested. `id` is the media file's
// identifier in its text form; the markup never interprets it, it only hands it
// back with a click.
export struct TrackRowData {
    id: string,
    position: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    /// The cover, at the size a row draws it. Empty where the track has
    /// none, which is most tracks in most libraries.
    cover: image,
    /// What stands in for it then: the artist's first letter, the same way
    /// the player bar stands in for a cover it has not got.
    initial: string,
}

export component TrackRow inherits Rectangle {
    // Not `row`: a Rectangle already has one, for grid placement.
    in property <TrackRowData> data;
    in property <bool> playing;
    /// True where the row is already in the queue, and the useful thing to do
    /// with it is take it out again.
    in property <bool> queued;
    /// True on a playlist's own page, where "take it out of this list" is an
    /// action that exists.
    in property <bool> in-playlist;

    callback activated();
    callback enqueued();
    callback removed();
    callback acted(string);

    // True while the pointer is anywhere over the row, including over the two
    // buttons in it — a nested touch area takes the pointer from the one
    // beneath it, and without this they would vanish as the pointer reached
    // them.
    property <bool> hovered: touch.has-hover || hover-play.has-hover || hover-queue.has-hover
        || dots.has-hover;

    /// The queue has exactly one thing to do with a row, and a labelled button
    /// doing it. A menu there would offer to put a queued track in the queue.
    property <bool> has-menu: !root.queued;

    height: Theme.row-height;
    background: root.hovered ? Theme.bg-1 : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        // No cursor of its own, and deliberately. `grab` is an open hand on the
        // platforms that have one and `IDC_SIZEALL` — arrows in four
        // directions — on this one, which says "move me" in a dialect nobody
        // here speaks and contradicts what a click actually does. The row is
        // played by clicking; carrying it is a shortcut, not the way in
        // (MASTER_ISSUES 67).

        // One click plays. A double click is the file-manager habit, and this
        // is not a file manager: a row here has one obvious thing to do and no
        // way to announce that it takes two clicks to do it.
        //
        // What that spends is the single click a selection would have wanted.
        // Selection can have the modifier keys, which are visible in a menu;
        // playing cannot be taught to anybody at all.
        clicked => {
            root.activated();
        }
        // The right button opens the same menu the dots do, for the people who
        // reach for it. It is never the only way to anything.
        pointer-event(event) => {
            if (root.has-menu
                && event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                menu.show();
            }
        }
    }

    HorizontalLayout {
        padding-top: Theme.row-padding;
        padding-bottom: Theme.row-padding;
        padding-right: Theme.row-end-inset;
        spacing: Theme.column-gap;

        // The number, until the pointer arrives — then a play button in its
        // place. Nothing moves and nothing is added beside the row: the column
        // is already there, and the only thing that changes is what it says.
        //
        // It is also how a listener learns the row is playable at all. A double
        // click still works and remains the faster habit, but nothing on screen
        // announces it.
        Rectangle {
            width: Theme.number-column;

            if !root.hovered: Text {
                text: root.data.position;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                letter-spacing: Theme.number-spacing;
                color: root.playing ? Theme.ink-0 : Theme.ink-mute;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: parent.width;
            }

            // Centred by hand. A child of a plain rectangle sits at its top
            // left unless it is told otherwise, and the number it replaces is a
            // Text centring itself — so without this the two swap at different
            // heights and the row twitches under the pointer.
            if root.hovered: Image {
                source: @image-url("../../../../resources/ui/icons/play.svg");
                width: Theme.px(14);
                height: self.width;
                x: parent.width - self.width;
                y: round((parent.height - self.height) / 1px / 2) * 1px;
                colorize: hover-play.has-hover ? Theme.ink-0 : Theme.ink-2;
            }

            hover-play := TouchArea {
                clicked => {
                    root.activated();
                }
            }
        }

        // The cover, or the letter that stands in for one. Between the
        // number and the title because that is where the eye goes next, and
        // the same pairing the player bar uses — a picture when there is one,
        // an initial when there is not, never an empty square.
        //
        // The picture itself arrives late: `TrackRows` reads it when the row is
        // about to be drawn, so a library of thousands costs the dozen covers
        // on screen rather than all of them.
        Rectangle {
            width: Theme.px(36);

            Rectangle {
                y: round((parent.height - Theme.px(36)) / 1px / 2) * 1px;
                width: Theme.px(36);
                height: Theme.px(36);
                border-radius: Theme.radius;
                background: Theme.bg-2;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.data.cover;
                    image-fit: ImageFit.cover;
                }

                if root.data.cover.width == 0: Text {
                    width: 100%;
                    height: 100%;
                    text: root.data.initial;
                    font-family: Theme.serif;
                    font-size: Theme.text-body;
                    color: Theme.ink-mute;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // `preferred-width: 0` on every stretching column, here and in the
        // header. Without it a layout hands each cell its natural width first
        // and shares only the remainder by stretch factor, so a column is as
        // wide as the longest thing in it — and a header that says ARTIST no
        // longer sits above the artists.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            preferred-width: 0px;

            Text {
                text: root.data.title;
                font-family: Theme.serif;
                // Lead, which is the size the scale grew for this row. Title's
                // twenty-four dominated three columns of fourteen and cut
                // anything past two words; body's fourteen was too quiet for
                // this serif, whose lower case is short. Eighteen is between
                // them, and between them is where a list row lives.
                font-size: Theme.text-lead;
                height: Theme.px(26);
                color: Theme.ink-0;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            preferred-width: 0px;

            Text {
                text: root.data.artist;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                color: Theme.ink-2;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        // The album is set in the same face as the artist beside it. It was
        // serif, on the reasoning that it names a work as the title does — but
        // in a row the title already carries that job, and a second accented
        // face on a quieter column reads as decoration rather than as rank.
        VerticalLayout {
            alignment: center;
            width: Theme.album-column;

            Text {
                text: root.data.album;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                // Upright, and a step louder. This was the same fourteen as
                // the artist beside it and read much smaller: italic, in a
                // serif whose lower case is famously small, in the quietest
                // ink there is. Three things compounding, none of them the
                // number. `ink-2` measures 6.4:1 against the page where
                // `ink-mute` measured 4.8.
                color: Theme.ink-2;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
            }
        }

        // The length, until the pointer arrives — then the way to put this
        // track next. The same trade the number column makes at the other end
        // of the row: a column that is already there says something else while
        // it is useful, and nothing moves.
        Rectangle {
            width: Theme.time-column;

            if !root.hovered: Text {
                width: parent.width;
                text: root.data.duration;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-mute;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            // A bare icon here said nothing: the play button opposite is a
            // universal shape, and there is no universal shape for "play this
            // after what is on". So this one says what it does, in the same
            // mono capitals every label in the interface is set in, and takes
            // the outline of a control because it is one.
            //
            // In the queue it says the opposite, because there the row is
            // already waiting and adding it again is the one thing nobody
            // wants. One control, one place, and the list it is in decides
            // which way it points.
            if root.hovered: pill := Rectangle {
                // Red only under the pointer, and only where the button takes
                // something away. At rest it is the same quiet outline as its
                // opposite: a row that shouts before it is touched is a row
                // that shouts all the time.
                property <color> accent: root.queued && hover-queue.has-hover
                    ? Theme.danger
                    : (hover-queue.has-hover ? Theme.ink-0 : Theme.ink-2);

                width: parent.width;
                height: Theme.px(26);
                y: round((parent.height - self.height) / 1px / 2) * 1px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: hover-queue.has-hover
                    ? (root.queued ? Theme.danger.with-alpha(0.5) : Theme.line)
                    : Theme.line-soft;
                // A tint rather than a fill: enough to say the word is meant,
                // not enough to make a small button the loudest thing on a page
                // of hairlines.
                background: hover-queue.pressed
                    ? (root.queued ? Theme.danger.with-alpha(0.22) : Theme.bg-3)
                    : (hover-queue.has-hover
                        ? (root.queued ? Theme.danger.with-alpha(0.12) : Theme.bg-2)
                        : transparent);
                animate background, border-color { duration: 120ms; }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.px(6);

                    VerticalLayout {
                        alignment: center;

                        Image {
                            source: root.queued
                                ? @image-url("../../../../resources/ui/icons/trash.svg")
                                : @image-url("../../../../resources/ui/icons/queue.svg");
                            width: Theme.px(12);
                            height: self.width;
                            colorize: pill.accent;
                            animate colorize { duration: 120ms; }
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: root.queued ? "REMOVE" : "QUEUE";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: Theme.px(18);
                            letter-spacing: Theme.label-spacing;
                            color: pill.accent;
                            vertical-alignment: center;
                            animate color { duration: 120ms; }
                        }
                    }
                }
            }

            hover-queue := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.queued) {
                        root.removed();
                    } else {
                        root.enqueued();
                    }
                }
            }
        }

        // Everything else the row can do. Its own column at the end, because
        // the two columns beside it already say something at rest and this one
        // has nothing to say until it is needed.
        Rectangle {
            width: root.has-menu ? Theme.px(32) : 0px;
            clip: true;

            Rectangle {
                width: Theme.px(32);
                height: Theme.px(32);
                y: round((parent.height - self.height) / 1px / 2) * 1px;
                border-radius: Theme.radius;
                background: dots.has-hover ? Theme.bg-3 : transparent;
                opacity: root.hovered ? 1.0 : 0.0;
                animate background, opacity { duration: 120ms; }

                // Vertical in a row: the row is already a horizontal thing,
                // and a mark stacked upright asks for less of its width.
                Image {
                    source: @image-url("../../../../resources/ui/icons/dots-vertical.svg");
                    width: Theme.px(18);
                    height: self.width;
                    x: round((parent.width - self.width) / 1px / 2) * 1px;
                    y: round((parent.height - self.height) / 1px / 2) * 1px;
                    colorize: dots.has-hover ? Theme.ink-0 : Theme.ink-2;
                    animate colorize { duration: 120ms; }
                }
            }

            dots := TouchArea {
                enabled: root.hovered && root.has-menu;
                mouse-cursor: pointer;
                clicked => {
                    menu.show();
                }
            }

            // Opens to the left and below: this is the last column of the row,
            // and the rows below it are what the menu has to cover.
            menu := RowMenu {
                x: Theme.px(32) - self.width;
                y: Theme.px(32);
                // Each list is its own typed property: a conditional between
                // two literals leaves the compiler holding two anonymous
                // structs and nowhere to say what they are.
                //
                // A playlist's page offers no "add to playlist": the track is
                // in one, and the only sensible verbs there are the two ways
                // out of it.
                property <[MenuItemData]> in-list: [
                    { action: "cover", label: "Choose a cover…" },
                    { action: "uncover", label: "Use the cover from the file" },
                    { action: "" },
                    { action: "remove-from-playlist", label: "Remove from this list", destructive: true },
                    { action: "remove-from-library", label: "Remove from library", destructive: true },
                ];
                property <[MenuItemData]> anywhere: [
                    { action: "add-to-playlist", label: "Add to playlist…" },
                    { action: "edit", label: "Edit details…" },
                    { action: "cover", label: "Choose a cover…" },
                    { action: "uncover", label: "Use the cover from the file" },
                    { action: "" },
                    { action: "remove-from-library", label: "Remove from library", destructive: true },
                ];

                items: root.in-playlist ? self.in-list : self.anywhere;
                chosen(action) => {
                    root.acted(action);
                }
            }
        }
    }

    // A hairline under every row rather than a box around each: the list reads
    // as one object, which is what a library is. It spans the row, and the row
    // is inset from the window, so the line stops where the content stops.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}
