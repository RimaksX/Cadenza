import { Theme } from "../theme/tokens.slint";

// One of the three window controls.
//
// No icon files: these are two or three straight lines each, and a stroked
// rectangle drawn from tokens costs nothing and scales with the theme. The
// close button is the only one that colours on hover, because it is the only
// one whose mistake cannot be undone.
component WindowButton inherits Rectangle {
    in property <bool> danger;
    in property <bool> restore;
    in property <string> kind;

    callback pressed();

    // A number, not `100%`: a child sized from its parent inside a layout whose
    // height is derived from its children is a circular constraint, and Slint
    // resolves it by giving the bar the whole window.
    width: Theme.px(46);
    height: Theme.px(40);
    background: touch.has-hover
        ? (root.danger ? #c42b1c : Theme.bg-3)
        : transparent;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => {
            root.pressed();
        }
    }

    // Minimise: one line.
    if root.kind == "minimize": Rectangle {
        width: Theme.px(10);
        height: 1px;
        background: Theme.ink-2;
    }

    // Maximise: a square. Restore: a square with another behind it.
    if root.kind == "maximize" && !root.restore: Rectangle {
        width: Theme.px(10);
        height: Theme.px(10);
        border-width: 1px;
        border-color: Theme.ink-2;
        background: transparent;
    }
    if root.kind == "maximize" && root.restore: Rectangle {
        width: Theme.px(12);
        height: Theme.px(12);
        background: transparent;

        Rectangle {
            x: Theme.px(2);
            y: 0px;
            width: Theme.px(10);
            height: Theme.px(10);
            border-width: 1px;
            border-color: Theme.ink-2;
        }
        Rectangle {
            x: 0px;
            y: Theme.px(3);
            width: Theme.px(10);
            height: Theme.px(10);
            border-width: 1px;
            border-color: Theme.ink-2;
            background: Theme.bg-1;
        }
    }

    // Close: two lines crossed. A path rather than a glyph, so it is exactly
    // square and exactly centred whatever the font does, and rather than two
    // rotated rectangles, which Slint does not rotate.
    if root.kind == "close": Path {
        width: Theme.px(10);
        height: Theme.px(10);
        viewbox-width: 10;
        viewbox-height: 10;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
        stroke: touch.has-hover ? #ffffff : Theme.ink-2;
        stroke-width: 1px;
    }
}

// The window's own title bar, drawn because the system's does not belong to
// this palette (PROJECT_MASTER 2.10: not the standard look of a player).
//
// Everything the system frame did, this has to do again: drag to move, double
// click to maximise, and the three buttons. Resizing is the exception — Slint's
// backend keeps the edges live on an undecorated window, cursors included.
export component TitleBar inherits Rectangle {
    in property <bool> maximized;

    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Deltas in logical pixels since the press began.
    callback drag(length, length);

    height: Theme.px(40);
    background: Theme.bg-1;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-soft;
    }

    // The whole bar is the drag handle, under the buttons rather than over
    // them: a click on close must close rather than move the window by a pixel.
    drag-area := TouchArea {
        moved => {
            if (self.pressed) {
                root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        double-clicked => {
            root.toggle-maximize();
        }
    }

    HorizontalLayout {
        // Deliberately empty. The wordmark is already at the top of the sidebar
        // and the section is already the heading of the page under it; a third
        // copy in a Theme.px(40) strip could only be set small enough to be squinted at.
        // What is left is what the strip is for: somewhere to grab, and the
        // controls.
        Rectangle {
            horizontal-stretch: 1;
        }

        // Minimise, maximise, close — in that order and on the right, which is
        // where this platform puts them. The reference is drawn as a Mac; a
        // window that argues with its own operating system is worse than one
        // that copies a mockup imperfectly.
        HorizontalLayout {
            alignment: end;

            WindowButton {
                kind: "minimize";
                pressed => {
                    root.minimize();
                }
            }
            WindowButton {
                kind: "maximize";
                restore: root.maximized;
                pressed => {
                    root.toggle-maximize();
                }
            }
            WindowButton {
                kind: "close";
                danger: true;
                pressed => {
                    root.close-window();
                }
            }
        }
    }
}
