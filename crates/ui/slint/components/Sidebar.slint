import { Theme } from "../theme/tokens.slint";

// One line of navigation.
//
// The dot in front is the whole selection indicator: no pill, no bar, no fill
// that has to be recoloured for the light theme. It brightens, and that is the
// difference between "here" and "not here".
component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;

    callback chosen();

    height: 30px;
    background: root.selected ? Theme.bg-1 : transparent;
    border-radius: Theme.radius;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.chosen();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        Rectangle {
            width: 4px;
            height: 4px;
            y: (parent.height - 4px) / 2;
            border-radius: 2px;
            background: root.selected
                ? Theme.ink-0
                : (touch.has-hover && root.enabled ? Theme.ink-2 : Theme.line);
            animate background { duration: 120ms; }
        }

        Text {
            text: root.label;
            font-family: Theme.sans;
            font-size: Theme.text-body;
            color: root.enabled
                ? (root.selected ? Theme.ink-0 : (touch.has-hover ? Theme.ink-1 : Theme.ink-2))
                : Theme.ink-mute;
            vertical-alignment: center;
        }
    }
}

component NavLabel inherits HorizontalLayout {
    in property <string> text;

    padding-left: Theme.space-3;
    padding-right: Theme.space-3;
    padding-bottom: Theme.space-2;
    spacing: Theme.space-2;

    Text {
        text: root.text;
        font-family: Theme.mono;
        font-size: Theme.text-label;
        letter-spacing: Theme.label-spacing;
        color: Theme.ink-mute;
        vertical-alignment: center;
    }

    // The rule runs from the label to the edge, which is how the eye finds the
    // group boundary without a heavier separator.
    Rectangle {
        y: (parent.height - 1px) / 2;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One half of the theme switch.
//
// A switch rather than a toggle: two states that are both visible, each
// directly reachable. A single button that flips would have to say what it will
// do, which is why the old one read "→ LIGHT" — a label explaining a control is
// a control that needs explaining.
component ThemeOption inherits Rectangle {
    in property <image> glyph;
    in property <bool> selected;

    callback chosen();

    width: 30px;
    height: 24px;
    border-radius: 3px;
    background: root.selected ? Theme.bg-3 : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.chosen();
        }
    }

    Image {
        source: root.glyph;
        width: 13px;
        height: self.width;
        image-fit: contain;
        colorize: root.selected
            ? Theme.ink-0
            : (touch.has-hover ? Theme.ink-1 : Theme.ink-mute);
        animate colorize { duration: 120ms; }
    }
}

export component Sidebar inherits Rectangle {
    in property <string> profile-name;

    callback set-theme(bool);

    width: Theme.sidebar-width;
    background: Theme.bg-0;

    // A single hairline, not a border: the sidebar and the content are one
    // surface with a seam, not two panels.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line-soft;
    }

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-5;
        spacing: Theme.space-6;

        // Wordmark. The name is the only place the serif is set this large.
        VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            spacing: 2px;

            Text {
                text: "Cadenza";
                font-family: Theme.serif;
                font-size: 28px;
                color: Theme.ink-0;
            }
            Text {
                text: "LOCAL PLAYER";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }

        VerticalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: 2px;

            NavLabel {
                text: "COLLECTION";
            }
            NavItem {
                label: "Library";
                selected: true;
            }
            // Everything below waits for the milestone that gives it a screen.
            // Shown rather than hidden so the shape of the application is
            // legible, and disabled rather than clickable so it cannot lie.
            NavItem {
                label: "Playlists";
                enabled: false;
            }
            NavItem {
                label: "Queue";
                enabled: false;
            }
            NavItem {
                label: "Radio";
                enabled: false;
            }
        }

        Rectangle { }

        // Who is listening, and the one control that belongs to them.
        VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            spacing: Theme.space-2;

            Text {
                text: "LISTENING AS";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
            Text {
                text: root.profile-name;
                font-family: Theme.serif;
                font-size: Theme.text-title;
                color: Theme.ink-1;
                overflow: elide;
            }

            // The switch sits in its own well, so the selected half reads as
            // pressed into the surface rather than floating on it.
            Rectangle {
                width: 64px;
                height: 28px;
                border-radius: 4px;
                background: Theme.bg-1;
                border-width: 1px;
                border-color: Theme.line-soft;

                HorizontalLayout {
                    padding: 1px;
                    spacing: 0px;

                    ThemeOption {
                        glyph: @image-url("../../../../resources/ui/icons/dark.svg");
                        selected: Theme.dark;
                        chosen => {
                            root.set-theme(true);
                        }
                    }
                    ThemeOption {
                        glyph: @image-url("../../../../resources/ui/icons/light.svg");
                        selected: !Theme.dark;
                        chosen => {
                            root.set-theme(false);
                        }
                    }
                }
            }
        }
    }
}
