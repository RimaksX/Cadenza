import { Theme } from "../theme/tokens.slint";
import { Transfer } from "Transfer.slint";

// One line of navigation.
//
// The icon and the label move together: both brighten on hover, both go loud
// when selected, both dim when the destination does not exist yet. One state,
// shown twice, so the eye can pick either.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> glyph;
    in property <bool> selected;
    in property <bool> enabled: true;
    /// True where a track may be let go of, which is the queue and nowhere else.
    in property <bool> takes-tracks;

    callback chosen();
    /// A track was dropped here.
    callback taken();

    // The colour every part of the row shares, worked out once.
    property <color> tone: !root.enabled
        ? Theme.ink-disabled
        : (root.selected || target.has-drag
            ? Theme.ink-0
            : (touch.has-hover ? Theme.ink-1 : Theme.ink-2));

    height: Theme.px(32);
    // While something is in the air, everything that cannot take it steps back
    // and the one thing that can stays lit. That is the whole answer to "how
    // would anybody know this was possible": they find out by starting, before
    // they have let go of anything.
    opacity: Transfer.carrying && !root.takes-tracks ? 0.35 : 1.0;
    animate opacity { duration: 120ms; }

    // A destination under a carried track lights the way a chosen one does, and
    // outlines itself as well: colour alone would say "this is the page you are
    // on", which it is not.
    background: root.selected || target.has-drag ? Theme.bg-1 : transparent;
    border-radius: Theme.radius;
    border-width: target.has-drag ? Theme.px(2) : 0px;
    border-color: Theme.ink-2;
    animate background { duration: 120ms; }

    target := DropArea {
        enabled: root.takes-tracks;
        can-drop(event) => {
            return DragAction.copy;
        }
        dropped(event) => {
            Transfer.dropped-on-queue(event.data);
            root.taken();
            return DragAction.copy;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.chosen();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;

            Image {
                source: root.glyph;
                width: Theme.px(16);
                height: self.width;
                image-fit: contain;
                colorize: root.tone;
                animate colorize { duration: 120ms; }
            }
        }

        // Wrapped like the icon beside it. A layout child with a height of its
        // own cannot stretch, so it sits at the top of the row — which is why
        // the labels rode above their icons.
        VerticalLayout {
            alignment: center;

            Text {
                text: root.label;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: Theme.px(22);
                color: root.tone;
                animate color { duration: 120ms; }
                vertical-alignment: center;
            }
        }
    }
}

component NavLabel inherits Rectangle {
    in property <string> text;

    // A box of its own rather than a layout with padding. The rule has to sit
    // on the words' own middle, and a layout that centres it in the padded box
    // puts it below them — which is why one group's line hung low and the next
    // one's, with different padding above it, rode high.
    height: Theme.px(26);

    HorizontalLayout {
        // Centred. Dividing by a *length* of two pixels rather than by the
        // number two lands on the whole remainder instead of half of it, so
        // the label and its rule sat against the floor of their own box. The
        // same mistake was fixed in the settings page (`MASTER_ISSUES` 73) and
        // this copy was missed; the two other places that divide by
        // `Theme.px(2)` are snapping a length to an even pixel, which is what
        // that division is actually for.
        y: round((parent.height - Theme.px(18)) / 1px / 2) * 1px;
        height: Theme.px(18);
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-2;

        // Wrapped, like every boxed line in a row: a child with a height of
        // its own cannot stretch, and a layout stands it at the top rather than
        // beside what it belongs with.
        VerticalLayout {
            alignment: center;

            Text {
                text: root.text;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
                vertical-alignment: center;
            }
        }

        // The rule runs from the label to the edge, which is how the eye finds
        // the group boundary without a heavier separator. On the line's own
        // middle: half of eighteen is nine, and nine is where a capital's waist
        // is.
        Rectangle {
            y: Theme.px(8);
            height: 1px;
            background: Theme.line-soft;
        }
    }
}

// Where everything is, down the left edge.
//
// Three destinations and one that is not built yet, the wordmark above them and
// the listener below. Nothing here scrolls and nothing here changes with the
// page: the frame is fixed (PROJECT_MASTER 2.10), and this is the half of it
// that says what the application contains.
export component Sidebar inherits Rectangle {
    /// How many files are waiting for a decision. Zero hides the destination.
    in property <int> pending-reviews;
    in property <string> profile-name;
    in property <string> profile-initial;
    /// Which screen is showing. A name rather than an index: an index would
    /// renumber every time a destination is added.
    in property <string> section;

    callback select(string);

    width: Theme.sidebar-width;
    background: Theme.bg-0;

    // A single hairline, not a border: the sidebar and the content are one
    // surface with a seam, not two panels.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line-soft;
    }

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-5;
        spacing: Theme.space-6;

        // Wordmark. The name is the only place the serif is set this large.
        VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            spacing: Theme.px(2);

            // Title rather than display, though it is the application's own
            // name: display belongs to whatever the listener is looking at, and
            // two things at the same size on one screen compete instead of
            // ranking.
            Text {
                text: "Cadenza";
                font-family: Theme.serif;
                font-size: Theme.text-title;
                height: Theme.px(34);
                vertical-alignment: center;
                color: Theme.ink-0;
            }
            Text {
                text: "LOCAL PLAYER";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: Theme.px(18);
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }

        VerticalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: Theme.px(2);

            NavLabel {
                text: "COLLECTION";
            }
            NavItem {
                label: "Library";
                glyph: @image-url("../../../../resources/ui/icons/library.svg");
                selected: root.section == "library";
                chosen => {
                    root.select("library");
                }
            }
            NavItem {
                label: "Playlists";
                glyph: @image-url("../../../../resources/ui/icons/playlist.svg");
                // One playlist is reached from the index and is still the
                // playlists section, so the item stays lit while it is open.
                selected: root.section == "playlists" || root.section == "playlist";
                chosen => {
                    root.select("playlists");
                }
            }
            NavItem {
                label: "Queue";
                glyph: @image-url("../../../../resources/ui/icons/queue.svg");
                selected: root.section == "queue";
                // The one destination that is always on screen while a track
                // is, which is what makes it the one worth dragging to.
                takes-tracks: true;
                chosen => {
                    root.select("queue");
                }
            }
            // Only while there is something to decide. A destination that is
            // empty nine days in ten is a destination nobody looks at, and one
            // that appears when it has something to say is read the first time.
            if root.pending-reviews > 0: NavItem {
                label: "Decisions";
                glyph: @image-url("../../../../resources/ui/icons/review.svg");
                selected: root.section == "reviews";
                chosen => {
                    root.select("reviews");
                }
            }
            NavItem {
                label: "Listening";
                glyph: @image-url("../../../../resources/ui/icons/analytics.svg");
                selected: root.section == "listening";
                chosen => {
                    root.select("listening");
                }
            }
            NavItem {
                label: "Radio";
                glyph: @image-url("../../../../resources/ui/icons/radio.svg");
                selected: root.section == "radio";
                chosen => {
                    root.select("radio");
                }
            }

            // A group of its own. The equaliser is not somewhere the music is
            // kept, it is something done to it — and a rule with a word on it
            // is how this sidebar says so.
            NavLabel {
                text: "SETUP";
                height: Theme.px(42);
            }
            NavItem {
                label: "Equaliser";
                glyph: @image-url("../../../../resources/ui/icons/equalizer.svg");
                selected: root.section == "equaliser";
                chosen => {
                    root.select("equaliser");
                }
            }
            NavItem {
                label: "Settings";
                glyph: @image-url("../../../../resources/ui/icons/settings.svg");
                selected: root.section == "settings";
                chosen => {
                    root.select("settings");
                }
            }
        }

        Rectangle { }

        // The listener's own section, under a rule that runs the full width of
        // the sidebar. Everything above it is where to go; this is who is
        // going there, and it neither scrolls nor changes with the screen.
        //
        // Only that. The theme control used to sit here and did not belong: a
        // preference is not an identity, and it goes on the settings screen
        // when there is one.
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 0px;

            Rectangle {
                height: 1px;
                background: Theme.line-soft;
            }

            VerticalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                padding-top: Theme.space-4;

                // Two lines and no disc. The disc held a letter standing in
                // for a picture nobody can choose — this interface has no way
                // to set one — so it was a portrait of nothing, and the only
                // round object on a screen made of squares and rules
                // (`MASTER_ISSUES` 115).
                //
                // What is left says the same thing in the shape everything else
                // in this column is said: a name, and a label under it.
                VerticalLayout {
                    spacing: Theme.px(2);

                    Text {
                            text: root.profile-name;
                            font-family: Theme.sans;
                            font-size: Theme.text-body;
                            height: Theme.px(22);
                            vertical-alignment: center;
                            color: Theme.ink-1;
                            overflow: elide;
                        }
                        Text {
                            text: "ACTIVE PROFILE";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: Theme.px(18);
                            vertical-alignment: center;
                        letter-spacing: Theme.label-spacing;
                        color: Theme.ink-mute;
                    }
                }
            }
        }
    }
}
