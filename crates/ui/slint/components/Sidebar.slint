import { Theme } from "../theme/tokens.slint";

// One line of navigation.
//
// The icon and the label move together: both brighten on hover, both go loud
// when selected, both dim when the destination does not exist yet. One state,
// shown twice, so the eye can pick either.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> glyph;
    in property <bool> selected;
    in property <bool> enabled: true;

    callback chosen();

    // The colour every part of the row shares, worked out once.
    property <color> tone: !root.enabled
        ? Theme.ink-disabled
        : (root.selected ? Theme.ink-0 : (touch.has-hover ? Theme.ink-1 : Theme.ink-2));

    height: 32px;
    background: root.selected ? Theme.bg-1 : transparent;
    border-radius: Theme.radius;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.chosen();
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;

        VerticalLayout {
            alignment: center;

            Image {
                source: root.glyph;
                width: 16px;
                height: self.width;
                image-fit: contain;
                colorize: root.tone;
                animate colorize { duration: 120ms; }
            }
        }

        // Wrapped like the icon beside it. A layout child with a height of its
        // own cannot stretch, so it sits at the top of the row — which is why
        // the labels rode above their icons.
        VerticalLayout {
            alignment: center;

            Text {
                text: root.label;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                height: 22px;
                color: root.tone;
                animate color { duration: 120ms; }
                vertical-alignment: center;
            }
        }
    }
}

component NavLabel inherits HorizontalLayout {
    in property <string> text;

    padding-left: Theme.space-3;
    padding-right: Theme.space-3;
    padding-bottom: Theme.space-2;
    spacing: Theme.space-2;

    VerticalLayout {
        alignment: center;

        Text {
            text: root.text;
            font-family: Theme.mono;
            font-size: Theme.text-label;
            height: 18px;
            letter-spacing: Theme.label-spacing;
            color: Theme.ink-mute;
            vertical-alignment: center;
        }
    }

    // The rule runs from the label to the edge, which is how the eye finds the
    // group boundary without a heavier separator.
    Rectangle {
        y: round((parent.height - 1px) / 1px / 2) * 1px;
        height: 1px;
        background: Theme.line-soft;
    }
}

// One half of the theme switch.
//
// A switch rather than a toggle: two states that are both visible, each
// directly reachable. A single button that flips would have to say what it will
// do, which is why the old one read "→ LIGHT" — a label explaining a control is
// a control that needs explaining.
export component Sidebar inherits Rectangle {
    in property <string> profile-name;
    in property <string> profile-initial;
    /// Which screen is showing. A name rather than an index: an index would
    /// renumber every time a destination is added.
    in property <string> section;

    callback select(string);

    width: Theme.sidebar-width;
    background: Theme.bg-0;

    // A single hairline, not a border: the sidebar and the content are one
    // surface with a seam, not two panels.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line-soft;
    }

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-bottom: Theme.space-5;
        spacing: Theme.space-6;

        // Wordmark. The name is the only place the serif is set this large.
        VerticalLayout {
            padding-left: Theme.space-5;
            padding-right: Theme.space-5;
            spacing: 2px;

            // Title rather than display, though it is the application's own
            // name: display belongs to whatever the listener is looking at, and
            // two things at the same size on one screen compete instead of
            // ranking.
            Text {
                text: "Cadenza";
                font-family: Theme.serif;
                font-size: Theme.text-title;
                height: 30px;
                vertical-alignment: center;
                color: Theme.ink-0;
            }
            Text {
                text: "LOCAL PLAYER";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }

        VerticalLayout {
            padding-left: Theme.space-3;
            padding-right: Theme.space-3;
            spacing: 2px;

            NavLabel {
                text: "COLLECTION";
            }
            NavItem {
                label: "Library";
                glyph: @image-url("../../../../resources/ui/icons/library.svg");
                selected: root.section == "library";
                chosen => {
                    root.select("library");
                }
            }
            NavItem {
                label: "Playlists";
                glyph: @image-url("../../../../resources/ui/icons/playlist.svg");
                // One playlist is reached from the index and is still the
                // playlists section, so the item stays lit while it is open.
                selected: root.section == "playlists" || root.section == "playlist";
                chosen => {
                    root.select("playlists");
                }
            }
            NavItem {
                label: "Queue";
                glyph: @image-url("../../../../resources/ui/icons/queue.svg");
                selected: root.section == "queue";
                chosen => {
                    root.select("queue");
                }
            }
            // Radio waits for the milestone that gives it a screen. Shown
            // rather than hidden so the shape of the application is legible,
            // and disabled rather than clickable so it cannot lie.
            NavItem {
                label: "Radio";
                glyph: @image-url("../../../../resources/ui/icons/radio.svg");
                enabled: false;
            }
        }

        Rectangle { }

        // The listener's own section, under a rule that runs the full width of
        // the sidebar. Everything above it is where to go; this is who is
        // going there, and it neither scrolls nor changes with the screen.
        //
        // Only that. The theme control used to sit here and did not belong: a
        // preference is not an identity, and it goes on the settings screen
        // when there is one.
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 0px;

            Rectangle {
                height: 1px;
                background: Theme.line-soft;
            }

            VerticalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                padding-top: Theme.space-4;

                HorizontalLayout {
                    spacing: Theme.space-3;

                    // The listener's initial in a disc. A face is the one thing
                    // in this interface that is theirs, and a letter is what
                    // there is until they can choose a picture.
                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: @linear-gradient(135deg, Theme.bg-3, Theme.bg-1);
                            border-width: 1px;
                            border-color: Theme.line;

                            Text {
                                text: root.profile-initial;
                                font-family: Theme.serif;
                                font-italic: true;
                                font-size: 14px;
                                height: 22px;
                                color: Theme.ink-1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.profile-name;
                            font-family: Theme.sans;
                            font-size: Theme.text-body;
                            height: 22px;
                            vertical-alignment: center;
                            color: Theme.ink-1;
                            overflow: elide;
                        }
                        Text {
                            text: "ACTIVE PROFILE";
                            font-family: Theme.mono;
                            font-size: Theme.text-label;
                            height: 18px;
                            vertical-alignment: center;
                            letter-spacing: Theme.label-spacing;
                            color: Theme.ink-mute;
                        }
                    }
                }
            }
        }
    }
}
