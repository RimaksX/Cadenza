import { Theme } from "../theme/tokens.slint";

// A line to type on.
//
// Not a box: nothing else in this interface is boxed, and a text field drawn as
// a well would be the loudest object on any page it appeared on. A hairline
// under the text is enough to say "this is where the words go" — the same
// hairline that separates rows, brightened while the field has focus.
export component Field inherits Rectangle {
    in property <string> placeholder;
    /// Whether the field draws its own hairline. Off where something around it
    /// already has an outline — two lines around one control is one too many.
    in property <bool> underlined: true;
    out property <bool> has-focus <=> input.has-focus;
    in-out property <string> text <=> input.text;

    callback accepted();
    /// Every keystroke. What a search field needs; a name field ignores it.
    callback edited(string);

    height: Theme.px(40);
    forward-focus: input;

    // Clicking anywhere on the field, including the empty part after the text,
    // puts the cursor in it — a two-character name should not have to be aimed
    // at.
    touch := TouchArea {
        // Qualified: this component has a `text` property of its own, and a
        // bare `text` here resolves to that string rather than to the cursor.
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    VerticalLayout {
        alignment: center;
        // The gap is for the hairline underneath. Where there is no hairline —
        // a field inside a box that draws its own — the text belongs in the
        // middle of the box instead of pushed off it.
        padding-bottom: root.underlined ? Theme.px(8) : 0px;

        // The placeholder is a second Text under the input rather than a
        // property of it: the built-in input has none, and a caption drawn in
        // the field's own colour would be indistinguishable from typed words.
        // Rounded: a text box asks for a fractional height, the layout centres
        // that fraction, and the line inside lands between two pixel rows —
        // which is what makes one letter of a word sit lower than its
        // neighbours.
        Rectangle {
            // Rounded up to an even number, not merely to a whole one. The
            // field around it is even, so an odd box leaves an odd remainder
            // and the layout centres it on half a pixel — which is the
            // staircase, one letter at a time.
            height: ceil(input.preferred-height / Theme.px(2)) * Theme.px(2);

            // Sits exactly where the first typed character will, which is the
            // whole point of it: a hint centred over a left-aligned field is a
            // label, and a label that vanishes when you type is a puzzle.
            // In the mono face, like every other hint and label here. Set in
            // the interface's own sans it read as neutral system furniture —
            // the one place in the window where the type did not sound like
            // the rest of it.
            if input.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-family: Theme.mono;
                font-size: Theme.text-label;
                letter-spacing: Theme.number-spacing;
                color: Theme.ink-disabled;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            input := TextInput {
                width: 100%;
                // The same even box the placeholder gets. Left to its own
                // metrics the typed line sits at a fraction of a pixel and
                // the letters climb and fall as they are rasterised.
                height: 100%;
                vertical-alignment: center;
                font-family: Theme.sans;
                font-size: Theme.text-body;
                color: Theme.ink-0;
                selection-background-color: Theme.ink-mute;
                selection-foreground-color: Theme.bg-0;
                single-line: true;

                // Ctrl+V, and the three shortcuts beside it.
                //
                // Slint's own handling of these is unreachable on Windows. It
                // matches the shortcut on the event's `text`, but before that
                // it drops any event whose text is a control character — and
                // Ctrl+V arrives from winit as U+0016, which is exactly that.
                // The guard runs first, the event is ignored, and paste, copy,
                // cut and select-all are all dead in every text field
                // (`i-slint-core` 1.17.1 `items/text.rs`, and
                // `MASTER_ISSUES` 78).
                //
                // `key-pressed` runs before any of that, so this takes the
                // event first and asks the input to do the thing itself. Both
                // spellings are accepted — the letter, in case a platform or a
                // later version delivers it that way, and the control code —
                // because handling it here twice is free and being wrong about
                // which one arrives is not.
                key-pressed(event) => {
                    if (event.modifiers.control && !event.modifiers.shift) {
                        if (event.text == "v" || event.text == "\u{16}") {
                            self.paste();
                            return accept;
                        }
                        if (event.text == "c" || event.text == "\u{3}") {
                            self.copy();
                            return accept;
                        }
                        if (event.text == "x" || event.text == "\u{18}") {
                            self.cut();
                            return accept;
                        }
                        if (event.text == "a" || event.text == "\u{1}") {
                            self.select-all();
                            return accept;
                        }
                    }
                    return reject;
                }

                accepted => {
                    root.accepted();
                }
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }

    if root.underlined: Rectangle {
        y: parent.height - self.height;
        height: 1px;
        background: input.has-focus ? Theme.ink-1 : (touch.has-hover ? Theme.line : Theme.line-soft);
        animate background { duration: 120ms; }
    }
}
