// The three faces, compiled into the binary. Cadenza is offline (PROJECT_MASTER
// 1.2): a font fetched at runtime is a font that is missing on the machine that
// matters. All three are SIL OFL 1.1, whose licence text ships beside them.
//
// Instrument Serif is the only one with a separate italic file; Inter is the
// variable cut, because its static cuts declare themselves as "Inter 18pt 18pt"
// and a family name is not something to fight.
import "../../../resources/ui/fonts/Instrument_Serif/InstrumentSerif-Regular.ttf";
import "../../../resources/ui/fonts/Instrument_Serif/InstrumentSerif-Italic.ttf";
import "../../../resources/ui/fonts/Inter/Inter-VariableFont_opsz,wght.ttf";
import "../../../resources/ui/fonts/JetBrains_Mono/JetBrainsMono-Regular.ttf";

import { Theme } from "theme/tokens.slint";
import { AppShell } from "components/AppShell.slint";
import { TrackRowData } from "components/TrackRow.slint";
import { PlaylistRowData } from "views/PlaylistsView.slint";

// Re-exported so the controller can set the palette. A global's input is set
// from the native side; markup may read it but never assign to it, which is
// what keeps the theme a decision of the application layer rather than of a
// view that happens to know about profiles.
export { Theme }

// The window, and the whole boundary between Rust and the markup.
//
// Everything in is a property, everything out is a callback. There is no other
// channel: the markup cannot reach a database, a file or the audio engine
// (PROJECT_MASTER 4.3), and this file is where that is checked by reading.
export component AppWindow inherits Window {
    title: "Cadenza";
    background: Theme.bg-0;
    // The frame is ours. Slint's backend keeps the edges resizable and their
    // cursors correct on an undecorated window; everything else the system
    // frame used to do is in `TitleBar`.
    no-frame: true;
    default-font-family: Theme.sans;
    default-font-size: Theme.text-body;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 560px;

    // Down: what to draw.
    in property <[TrackRowData]> tracks;
    in property <string> library-summary;
    in property <string> empty-hint;
    in property <[TrackRowData]> queue-tracks;
    in property <string> queue-summary;
    in property <string> queue-hint;
    in property <[PlaylistRowData]> playlists;
    in property <string> playlists-hint;
    in property <[TrackRowData]> playlist-tracks;
    in property <string> playlist-name;
    in property <string> playlist-summary;
    in property <string> playlist-hint;
    in property <string> profile-name;
    in property <string> profile-initial;
    in property <string> now-title;
    in property <string> now-subtitle;
    in property <string> now-initial;
    in property <string> now-position: "0:00";
    in property <string> now-duration: "0:00";
    in property <string> playing-id;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume: 1.0;
    in property <string> message;
    in property <bool> maximized;
    in property <bool> shuffle;
    in property <bool> repeating;
    in property <bool> repeat-one;
    in property <bool> has-next;
    in property <bool> has-previous;

    // Up: what the listener asked for.
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-window(length, length);
    callback play(string);
    callback enqueue(string);
    callback open-playlist(string);
    callback play-from-playlist(string);
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();

    AppShell {
        maximized: root.maximized;
        minimize => {
            root.minimize();
        }
        toggle-maximize => {
            root.toggle-maximize();
        }
        close-window => {
            root.close-window();
        }
        drag-window(dx, dy) => {
            root.drag-window(dx, dy);
        }

        tracks: root.tracks;
        library-summary: root.library-summary;
        empty-hint: root.empty-hint;
        queue-tracks: root.queue-tracks;
        queue-summary: root.queue-summary;
        queue-hint: root.queue-hint;
        playlists: root.playlists;
        playlists-hint: root.playlists-hint;
        playlist-tracks: root.playlist-tracks;
        playlist-name: root.playlist-name;
        playlist-summary: root.playlist-summary;
        playlist-hint: root.playlist-hint;
        profile-name: root.profile-name;
        profile-initial: root.profile-initial;
        now-title: root.now-title;
        now-subtitle: root.now-subtitle;
        now-initial: root.now-initial;
        now-position: root.now-position;
        now-duration: root.now-duration;
        playing-id: root.playing-id;
        progress: root.progress;
        playing: root.playing;
        loaded: root.loaded;
        muted: root.muted;
        volume: root.volume;
        message: root.message;
        shuffle: root.shuffle;
        repeating: root.repeating;
        repeat-one: root.repeat-one;
        has-next: root.has-next;
        has-previous: root.has-previous;

        play(id) => {
            root.play(id);
        }
        enqueue(id) => {
            root.enqueue(id);
        }
        open-playlist(id) => {
            root.open-playlist(id);
        }
        play-from-playlist(id) => {
            root.play-from-playlist(id);
        }
        toggle-play => {
            root.toggle-play();
        }
        seek(fraction) => {
            root.seek(fraction);
        }
        set-volume(level) => {
            root.set-volume(level);
        }
        toggle-mute => {
            root.toggle-mute();
        }
        next => {
            root.next();
        }
        previous => {
            root.previous();
        }
        toggle-shuffle => {
            root.toggle-shuffle();
        }
        cycle-repeat => {
            root.cycle-repeat();
        }
    }

    // Space is the one shortcut worth having before there is a settings screen
    // to list shortcuts in.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                return accept;
            }
            return reject;
        }
    }
}
