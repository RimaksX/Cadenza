// The three faces, compiled into the binary. Cadenza is offline (PROJECT_MASTER
// 1.2): a font fetched at runtime is a font that is missing on the machine that
// matters. All three are SIL OFL 1.1, whose licence ships beside them.
//
// They answer to names no machine will already have, and that is the point.
// Slint asks fontdb for a family by name; fontdb gathers every face carrying
// that name — the system's own were loaded first — and breaks a tie of equal
// weight in favour of the one it saw first. A listener with Cormorant Garamond
// installed would have seen their copy, of whatever version, instead of the one
// this interface was drawn against. Asking for "Cadenza Serif" cannot be
// answered by anybody but us.
//
// The renaming is `scripts/rename_font.py`, and it touches nothing but the name
// table: the outlines, metrics and kerning are the originals'. What each file
// was before is written in the folder it sits in.
//
// Cormorant Garamond replaced Instrument Serif because Instrument Serif has no
// Cyrillic at all — a Russian title fell through to whatever the system offered,
// which is a different typeface in the middle of a list of track names.
import "../../../resources/ui/fonts/Cormorant_Garamond/CadenzaSerif-Regular.ttf";
import "../../../resources/ui/fonts/Cormorant_Garamond/CadenzaSerif-Italic.ttf";
import "../../../resources/ui/fonts/Manrope/CadenzaSans-Regular.ttf";
import "../../../resources/ui/fonts/JetBrains_Mono/CadenzaMono-Regular.ttf";

import { Theme } from "theme/tokens.slint";
import { AppShell } from "components/AppShell.slint";
import { TrackRowData } from "components/TrackRow.slint";
import { PlaylistCardData } from "views/PlaylistsView.slint";
import { MenuItemData } from "components/RowMenu.slint";
import { EqPresetData, EqBandData } from "views/EqualiserView.slint";
import { FolderRowData, ProfileRowData } from "views/SettingsView.slint";
import { MoodRowData } from "views/RadioView.slint";
import { TopTrackData } from "views/ListeningView.slint";
import { ReviewRowData } from "views/ReviewsView.slint";

// Re-exported so the controller can set the palette. A global's input is set
// from the native side; markup may read it but never assign to it, which is
// what keeps the theme a decision of the application layer rather than of a
// view that happens to know about profiles.
export { Theme }

// The window, and the whole boundary between Rust and the markup.
//
// Everything in is a property, everything out is a callback. There is no other
// channel: the markup cannot reach a database, a file or the audio engine
// (PROJECT_MASTER 4.3), and this file is where that is checked by reading.
export component AppWindow inherits Window {
    title: "Cadenza";
    background: Theme.bg-0;
    // The frame is ours. Slint's backend keeps the edges resizable and their
    // cursors correct on an undecorated window; everything else the system
    // frame used to do is in `TitleBar`.
    no-frame: true;
    default-font-family: Theme.sans;
    default-font-size: Theme.text-body;
    preferred-width: 1180px;
    preferred-height: 760px;
    // Measured rather than hoped for. The old floor of 880 by 560 was never
    // rendered at: the search field hung off the right edge and the player bar
    // was pushed out of the bottom of the window entirely. What the interface
    // actually needs is this, and it is stated here so that nobody can drag the
    // window somewhere it does not work (MASTER_ISSUES 64).
    min-width: 1000px;
    min-height: 720px;

    // Down: what to draw.
    /// True while files from outside are being held over the window.
    in property <bool> dropping;
    in property <[TrackRowData]> tracks;
    in property <string> library-summary;
    in property <string> empty-hint;
    in property <[TrackRowData]> queue-tracks;
    in property <string> queue-summary;
    in property <string> queue-hint;
    in property <[PlaylistCardData]> playlists;
    in property <string> playlists-summary;
    in property <string> playlists-hint;
    in property <[TrackRowData]> playlist-tracks;
    in property <string> playlist-name;
    in property <string> playlist-summary;
    in property <string> playlist-hint;
    in property <string> open-playlist-id;
    in property <[MenuItemData]> playlist-options;
    in property <bool> dark;
    in property <bool> crossfade-on;
    in property <int> crossfade-seconds;
    in property <int> ui-scale;
    in property <bool> history-on;
    in property <[FolderRowData]> folders;
    in property <[ProfileRowData]> profiles;
    in property <string> editing-id;
    in property <string> editing-title;
    in property <string> editing-artist;
    in property <string> editing-album;
    in property <string> suggested-folder;
    in property <string> settings-summary;

    // Radio.
    in property <[MoodRowData]> moods;
    in property <[TopTrackData]> top-tracks;
    in property <[ReviewRowData]> reviews;
    in property <string> reviews-summary;
    in property <string> listening-summary;
    in property <string> listening-heard;
    in property <string> listening-listens;
    in property <string> listening-tracks;
    in property <string> listening-skip-rate;
    in property <bool> listening-kept;
    in property <string> radio-mood;
    in property <string> radio-summary;
    in property <bool> eq-advanced;
    in property <float> eq-bass;
    in property <float> eq-mid;
    in property <float> eq-treble;
    in property <[EqBandData]> eq-bands;
    in property <[EqPresetData]> eq-presets;
    in property <string> eq-summary;
    in property <int> eq-selected;
    in property <string> eq-selected-frequency;
    in property <string> eq-selected-q;
    in property <string> eq-selected-gain;
    in property <string> profile-name;
    in property <string> profile-initial;
    in property <string> now-title;
    in property <string> now-subtitle;
    in property <string> now-initial;
    in property <image> now-cover;
    in property <string> now-position: "0:00";
    in property <string> now-duration: "0:00";
    in property <string> playing-id;
    in property <float> progress;
    in property <bool> playing;
    in property <bool> loaded;
    in property <bool> muted;
    in property <float> volume: 1.0;
    in property <string> message;
    in property <[float]> spectrum;
    in property <bool> maximized;
    in property <bool> shuffle;
    in property <bool> repeating;
    in property <bool> repeat-one;
    in property <bool> has-next;
    in property <bool> has-previous;

    // Up: what the listener asked for.
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback drag-window(length, length);
    callback play(string);
    callback enqueue(string);
    callback play-queued(int);
    callback remove-from-queue(int);
    callback open-playlist(string);
    callback play-playlist(string);
    callback create-playlist(string);
    callback rename-playlist(string, string);
    callback delete-playlist(string);
    callback add-to-playlist(string, string);
    callback create-playlist-with(string, string);
    callback remove-from-playlist(int);
    callback remove-from-library(string);
    callback choose-cover(string);
    callback clear-cover(string);
    callback choose-playlist-cover(string);
    callback clear-playlist-cover(string);
    callback clear-queue();
    callback search(string);
    callback play-from-playlist(string);
    callback toggle-play();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-eq-mode(bool);
    callback set-eq-simple(int, float);
    callback move-eq-band(int, float);
    callback tune-eq-band(int, int);
    callback select-eq-band(int);
    callback settle-eq();
    callback set-theme(bool);
    callback set-crossfade(bool, int);
    callback set-ui-scale(int);
    callback set-history(bool);
    callback add-folder();
    callback use-suggested-folder();
    callback remove-folder(string);
    callback scan-now();
    callback showing(string);
    callback decide-review(string, string);
    callback edit-track(string);
    callback save-track(string, string, string, string);
    callback switch-profile(string);
    callback create-profile(string);
    callback start-radio(string);
    callback judge-radio(bool);
    callback widen-eq-band(int, float);
    callback pick-eq-preset(string);
    callback save-eq-preset(string);
    callback rename-eq-preset(string, string);
    callback delete-eq-preset(string);
    callback reset-eq();

    // Given the window rather than asked what it would like. A child placed in
    // a Window with no size takes its preferred one, so the shell was as big as
    // whichever page was showing — which left a band of bare window under the
    // player bar on any page whose content was shorter than the window, and the
    // page itself sitting in a corner of it.
    AppShell {
        width: root.width;
        height: root.height;
        maximized: root.maximized;
        minimize => {
            root.minimize();
        }
        toggle-maximize => {
            root.toggle-maximize();
        }
        close-window => {
            root.close-window();
        }
        drag-window(dx, dy) => {
            root.drag-window(dx, dy);
        }

        tracks: root.tracks;
        library-summary: root.library-summary;
        empty-hint: root.empty-hint;
        queue-tracks: root.queue-tracks;
        queue-summary: root.queue-summary;
        queue-hint: root.queue-hint;
        playlists: root.playlists;
        playlists-summary: root.playlists-summary;
        playlists-hint: root.playlists-hint;
        playlist-tracks: root.playlist-tracks;
        playlist-name: root.playlist-name;
        playlist-summary: root.playlist-summary;
        playlist-hint: root.playlist-hint;
        open-playlist-id: root.open-playlist-id;
        playlist-options: root.playlist-options;
        dark: root.dark;
        crossfade-on: root.crossfade-on;
        crossfade-seconds: root.crossfade-seconds;
        ui-scale: root.ui-scale;
        history-on: root.history-on;
        folders: root.folders;
        profiles: root.profiles;
        editing-id: root.editing-id;
        editing-title: root.editing-title;
        editing-artist: root.editing-artist;
        editing-album: root.editing-album;
        suggested-folder: root.suggested-folder;
        settings-summary: root.settings-summary;
        moods: root.moods;
        top-tracks: root.top-tracks;
        reviews: root.reviews;
        reviews-summary: root.reviews-summary;
        listening-summary: root.listening-summary;
        listening-heard: root.listening-heard;
        listening-listens: root.listening-listens;
        listening-tracks: root.listening-tracks;
        listening-skip-rate: root.listening-skip-rate;
        listening-kept: root.listening-kept;
        radio-mood: root.radio-mood;
        radio-summary: root.radio-summary;
        eq-advanced: root.eq-advanced;
        eq-bass: root.eq-bass;
        eq-mid: root.eq-mid;
        eq-treble: root.eq-treble;
        eq-bands: root.eq-bands;
        eq-presets: root.eq-presets;
        eq-summary: root.eq-summary;
        eq-selected: root.eq-selected;
        eq-selected-frequency: root.eq-selected-frequency;
        eq-selected-q: root.eq-selected-q;
        eq-selected-gain: root.eq-selected-gain;
        profile-name: root.profile-name;
        profile-initial: root.profile-initial;
        now-title: root.now-title;
        now-subtitle: root.now-subtitle;
        now-initial: root.now-initial;
        now-cover: root.now-cover;
        now-position: root.now-position;
        now-duration: root.now-duration;
        playing-id: root.playing-id;
        progress: root.progress;
        playing: root.playing;
        loaded: root.loaded;
        muted: root.muted;
        volume: root.volume;
        message: root.message;
        spectrum: root.spectrum;
        shuffle: root.shuffle;
        repeating: root.repeating;
        repeat-one: root.repeat-one;
        has-next: root.has-next;
        has-previous: root.has-previous;

        play(id) => {
            root.play(id);
        }
        enqueue(id) => {
            root.enqueue(id);
        }
        play-queued(index) => {
            root.play-queued(index);
        }
        remove-from-queue(index) => {
            root.remove-from-queue(index);
        }
        open-playlist(id) => {
            root.open-playlist(id);
        }
        play-playlist(id) => {
            root.play-playlist(id);
        }
        create-playlist(name) => {
            root.create-playlist(name);
        }
        rename-playlist(id, name) => {
            root.rename-playlist(id, name);
        }
        delete-playlist(id) => {
            root.delete-playlist(id);
        }
        add-to-playlist(track, playlist) => {
            root.add-to-playlist(track, playlist);
        }
        create-playlist-with(track, name) => {
            root.create-playlist-with(track, name);
        }
        remove-from-playlist(index) => {
            root.remove-from-playlist(index);
        }
        remove-from-library(id) => {
            root.remove-from-library(id);
        }
        choose-cover(id) => {
            root.choose-cover(id);
        }
        clear-cover(id) => {
            root.clear-cover(id);
        }
        choose-playlist-cover(id) => {
            root.choose-playlist-cover(id);
        }
        clear-playlist-cover(id) => {
            root.clear-playlist-cover(id);
        }
        clear-queue => {
            root.clear-queue();
        }
        search(text) => {
            root.search(text);
        }
        play-from-playlist(id) => {
            root.play-from-playlist(id);
        }
        toggle-play => {
            root.toggle-play();
        }
        seek(fraction) => {
            root.seek(fraction);
        }
        set-volume(level) => {
            root.set-volume(level);
        }
        toggle-mute => {
            root.toggle-mute();
        }
        next => {
            root.next();
        }
        previous => {
            root.previous();
        }
        toggle-shuffle => {
            root.toggle-shuffle();
        }
        cycle-repeat => {
            root.cycle-repeat();
        }
        set-eq-mode(advanced) => {
            root.set-eq-mode(advanced);
        }
        set-eq-simple(which, value) => {
            root.set-eq-simple(which, value);
        }
        move-eq-band(index, y) => {
            root.move-eq-band(index, y);
        }
        tune-eq-band(index, direction) => {
            root.tune-eq-band(index, direction);
        }
        select-eq-band(index) => {
            root.select-eq-band(index);
        }
        settle-eq => {
            root.settle-eq();
        }
        set-theme(dark) => {
            root.set-theme(dark);
        }
        set-crossfade(on, seconds) => {
            root.set-crossfade(on, seconds);
        }
        set-ui-scale(percent) => {
            root.set-ui-scale(percent);
        }
        set-history(on) => {
            root.set-history(on);
        }
        add-folder => {
            root.add-folder();
        }
        use-suggested-folder => {
            root.use-suggested-folder();
        }
        remove-folder(id) => {
            root.remove-folder(id);
        }
        showing(name) => {
            root.showing(name);
        }
        decide-review(id, choice) => {
            root.decide-review(id, choice);
        }
        edit-track(id) => {
            root.edit-track(id);
        }
        save-track(id, title, artist, album) => {
            root.save-track(id, title, artist, album);
        }
        switch-profile(id) => {
            root.switch-profile(id);
        }
        create-profile(name) => {
            root.create-profile(name);
        }
        start-radio(id) => {
            root.start-radio(id);
        }
        judge-radio(like) => {
            root.judge-radio(like);
        }
        scan-now => {
            root.scan-now();
        }
        widen-eq-band(index, step) => {
            root.widen-eq-band(index, step);
        }
        pick-eq-preset(id) => {
            root.pick-eq-preset(id);
        }
        save-eq-preset(name) => {
            root.save-eq-preset(name);
        }
        rename-eq-preset(id, name) => {
            root.rename-eq-preset(id, name);
        }
        delete-eq-preset(id) => {
            root.delete-eq-preset(id);
        }
        reset-eq => {
            root.reset-eq();
        }
    }

    // Over everything, including the player bar, because the window as a whole
    // is what a file is being offered to. Drawn last so it stands above the
    // shell rather than inside a page that could be scrolled away from it.
    Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.bg-0.with-alpha(0.96);

        // Faded in rather than switched on, like every other appearance here.
        // Kept in the tree rather than made conditional so that it can be: it
        // holds no touch area, so while it is invisible it is also untouchable.
        opacity: root.dropping ? 1.0 : 0.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out;
        }

        Rectangle {
            x: Theme.space-6;
            y: Theme.space-6;
            width: root.width - Theme.space-6 * 2;
            height: root.height - Theme.space-6 * 2;
            border-width: 2px;
            border-color: Theme.ink-2;
            border-radius: Theme.radius;
            background: transparent;
        }

        VerticalLayout {
            alignment: center;
            spacing: Theme.space-2;

            Text {
                text: "Let go to add this to your library";
                font-family: Theme.serif;
                font-size: Theme.text-display;
                height: 56px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.ink-0;
            }

            Text {
                text: "A FOLDER JOINS THE LIBRARY · A TRACK IS TAKEN WHERE IT LIES";
                font-family: Theme.mono;
                font-size: Theme.text-label;
                height: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
                letter-spacing: Theme.label-spacing;
                color: Theme.ink-mute;
            }
        }
    }

    // Space is the one shortcut worth having before there is a settings screen
    // to list shortcuts in.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-play();
                return accept;
            }
            return reject;
        }
    }
}
