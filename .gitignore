/target
**/*.rs.bk
*.pdb

# local DB / logs / cache produced while running from the repo
*.db
*.db-wal
*.db-shm
/logs

# packaging output
/packaging/windows/out

# editors and local tooling
.vscode/
.idea/
.claude/settings.local.json

# What Python leaves beside the scripts it runs.
__pycache__/
*.pyc

# Point-in-time reviews live in docs/MASTER_ISSUES.md; a stray file at the root
# is a second place to look.
/REVIEW_FINDINGS.txt
